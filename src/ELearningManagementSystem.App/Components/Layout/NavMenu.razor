@inject AuthApiService AuthApiService
@inject NavigationManager Navigation

<nav class="bg-white border-b border-slate-200 sticky top-0 z-50 backdrop-blur-lg bg-white/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <!-- Brand & Main Nav -->
            <div class="flex items-center">
                <a href="/" class="flex items-center group">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-600 to-purple-600 flex items-center justify-center shadow-lg shadow-indigo-500/30 group-hover:shadow-indigo-500/50 transition-all">
                        <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                        </svg>
                    </div>
                    <span class="ml-3 text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-slate-900 to-slate-700">LMS</span>
                </a>
                
                <!-- Desktop Navigation Links -->
                <div class="hidden md:block ml-10">
                    <div class="flex items-baseline space-x-1">
                        <AuthorizeView>
                            <Authorized>
                                <NavLink href="/dashboard" class="px-3 py-2 rounded-md text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" ActiveClass="text-indigo-600 bg-indigo-50">Dashboard</NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Policy="Permission:Course.Read" Context="coursesContext">
                            <Authorized>
                                <NavLink href="/courses" class="px-3 py-2 rounded-md text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" ActiveClass="text-indigo-600 bg-indigo-50">Courses</NavLink>
                            </Authorized>
                        </AuthorizeView>
                        
                        <AuthorizeView Policy="Permission:Course.Update" Context="courseAdminContext">
                            <Authorized>
                                <NavLink href="/admin/courses" class="px-3 py-2 rounded-md text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" ActiveClass="text-indigo-600 bg-indigo-50">Manage Courses</NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Policy="Permission:Category.Read" Context="categoryAdminContext">
                            <Authorized>
                                <NavLink href="/admin/categories" class="px-3 py-2 rounded-md text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" ActiveClass="text-indigo-600 bg-indigo-50">Manage Categories</NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Policy="Permission:User.Read" Context="userAdminContext">
                            <Authorized>
                                <NavLink href="/admin/users" class="px-3 py-2 rounded-md text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" ActiveClass="text-indigo-600 bg-indigo-50">Manage Users</NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Policy="Permission:Role.Read" Context="roleAdminContext">
                            <Authorized>
                                <NavLink href="/admin/roles" class="px-3 py-2 rounded-md text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" ActiveClass="text-indigo-600 bg-indigo-50">Manage Roles</NavLink>
                            </Authorized>
                        </AuthorizeView>
                        
                        <AuthorizeView Policy="Permission:AuditLog.Read" Context="auditAdminContext">
                            <Authorized>
                                <NavLink href="/admin/audit-logs" class="px-3 py-2 rounded-md text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" ActiveClass="text-indigo-600 bg-indigo-50">Audit Logs</NavLink>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>
            
            <!-- User Actions -->
            <div class="flex items-center space-x-4">
                <AuthorizeView>
                    <Authorized>


                        <div class="flex items-center space-x-3">
                            <div class="h-8 w-8 rounded-full bg-indigo-100 border border-indigo-200 flex items-center justify-center overflow-hidden flex-shrink-0 shadow-inner">
                                <span class="text-indigo-700 font-semibold text-sm">@(context.User.Identity?.Name?.FirstOrDefault() ?? 'U')</span>
                            </div>
                            <a href="/profile" class="hidden sm:block text-sm font-medium text-slate-700 hover:text-indigo-600 transition-colors">Profile</a>
                            
                            <button @onclick="HandleLogout" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-full transition-colors" title="Sign out">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                </svg>
                            </button>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors px-3 py-2">Log in</a>
                        <a href="/register" class="text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition-colors px-4 py-2 rounded-full shadow-sm shadow-indigo-600/30">Sign up</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</nav>

@code {
    private async Task HandleLogout()
    {
        await AuthApiService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
