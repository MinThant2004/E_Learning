@using ELearningManagementSystem.App.Components.Shared
@inject AuthApiService AuthApiService
@inject NavigationManager Navigation
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<NavMenu> Logger

<nav class="bg-white border-b border-slate-200 sticky top-0 z-50 backdrop-blur-lg bg-white/80 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <!-- Brand & Main Nav -->
            <div class="flex items-center flex-1">
                <a href="/" class="flex items-center group flex-shrink-0">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 via-purple-600 to-pink-500 flex items-center justify-center shadow-md shadow-indigo-500/20 group-hover:shadow-indigo-500/40 group-hover:scale-105 transition-all duration-300">
                        <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l9-5-9-5-9 5 9 5z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                        </svg>
                    </div>
                    <div class="flex flex-col ml-3">
                        <span class="text-base font-extrabold text-slate-900 tracking-tight leading-none">EduSphere</span>
                        <span class="text-[9px] text-slate-400 font-bold tracking-wider uppercase mt-0.5">LMS Portal</span>
                    </div>
                </a>
                
                <!-- Desktop Navigation Links -->
                <div class="hidden md:block ml-10">
                    <div class="flex items-baseline space-x-1">
                        <AuthorizeView>
                            <Authorized>
                                <NavLink href="/dashboard" Match="NavLinkMatch.All" class="px-3 py-2 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-slate-50 transition-all duration-200" ActiveClass="bg-indigo-50 text-indigo-600 font-semibold shadow-sm shadow-indigo-500/5">Dashboard</NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Policy="Permission:Course.Read" Context="coursesContext">
                            <Authorized>
                                <NavLink href="/courses" class="px-3 py-2 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-slate-50 transition-all duration-200" ActiveClass="bg-indigo-50 text-indigo-600 font-semibold shadow-sm shadow-indigo-500/5">Courses</NavLink>
                            </Authorized>
                        </AuthorizeView>
                        
                        <AuthorizeView Policy="Permission:Course.Update" Context="courseAdminContext">
                            <Authorized>
                                <NavLink href="/admin/courses" class="px-3 py-2 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-slate-50 transition-all duration-200" ActiveClass="bg-indigo-50 text-indigo-600 font-semibold shadow-sm shadow-indigo-500/5">Manage Courses</NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Policy="Permission:Category.Read" Context="categoryAdminContext">
                            <Authorized>
                                <NavLink href="/admin/categories" class="px-3 py-2 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-slate-50 transition-all duration-200" ActiveClass="bg-indigo-50 text-indigo-600 font-semibold shadow-sm shadow-indigo-500/5">Manage Categories</NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Policy="Permission:User.Read" Context="userAdminContext">
                            <Authorized>
                                <NavLink href="/admin/users" class="px-3 py-2 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-slate-50 transition-all duration-200" ActiveClass="bg-indigo-50 text-indigo-600 font-semibold shadow-sm shadow-indigo-500/5">Manage Users</NavLink>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Policy="Permission:Role.Read" Context="roleAdminContext">
                            <Authorized>
                                <NavLink href="/admin/roles" class="px-3 py-2 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-slate-50 transition-all duration-200" ActiveClass="bg-indigo-50 text-indigo-600 font-semibold shadow-sm shadow-indigo-500/5">Manage Roles</NavLink>
                            </Authorized>
                        </AuthorizeView>
                        
                        <AuthorizeView Policy="Permission:AuditLog.Read" Context="auditAdminContext">
                            <Authorized>
                                <NavLink href="/admin/audit-logs" class="px-3 py-2 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-slate-50 transition-all duration-200" ActiveClass="bg-indigo-50 text-indigo-600 font-semibold shadow-sm shadow-indigo-500/5">Audit Logs</NavLink>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>
            
            <!-- Right-Side User Profile & Actions -->
            <div class="flex items-center space-x-3">
                <AuthorizeView>
                    <Authorized>
                        <!-- Profile Avatar Dropdown -->
                        <div class="relative">
                            <button @onclick="ToggleUserMenu" class="flex items-center space-x-2.5 focus:outline-none group p-1.5 rounded-full hover:bg-slate-100/80 transition-all duration-200" aria-expanded="@isUserMenuOpen">
                                <!-- Avatar initials badge -->
                                <div class="h-9 w-9 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-600 text-white flex items-center justify-center font-bold text-sm shadow-md ring-2 ring-white group-hover:ring-indigo-200 transition-all duration-200 flex-shrink-0">
                                    @(context.User.Identity?.Name?.FirstOrDefault() ?? 'U')
                                </div>
                                
                                <div class="hidden sm:flex flex-col text-left">
                                    <span class="text-sm font-semibold text-slate-700 leading-tight group-hover:text-indigo-600 transition-colors">@context.User.Identity?.Name</span>
                                    <span class="@GetRoleBadgeClass(context.User)">@GetDisplayRole(context.User)</span>
                                </div>
                                
                                <svg class="h-4 w-4 text-slate-400 group-hover:text-slate-600 transition-transform duration-200 @(isUserMenuOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>

                            <!-- Dropdown Menu -->
                            @if (isUserMenuOpen)
                            {
                                <div class="fixed inset-0 z-40" @onclick="CloseUserMenu"></div>

                                <div class="absolute right-0 mt-2.5 w-60 rounded-2xl bg-white border border-slate-100 shadow-xl py-2 z-50 animate-in fade-in slide-in-from-top-2 duration-150 origin-top-right">
                                    <div class="px-4 py-3 border-b border-slate-100/50 md:hidden">
                                        <p class="text-sm font-semibold text-slate-800">@context.User.Identity?.Name</p>
                                        <p class="text-[10px] font-bold tracking-wider text-indigo-600 uppercase mt-0.5">@GetDisplayRole(context.User)</p>
                                    </div>

                                    <a href="/profile" @onclick="CloseUserMenu" class="flex items-center px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 hover:text-indigo-600 transition-colors">
                                        <svg class="mr-3 h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                        </svg>
                                        My Profile
                                    </a>
                                    
                                    <a href="/profile" @onclick="CloseUserMenu" class="flex items-center px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 hover:text-indigo-600 transition-colors">
                                        <svg class="mr-3 h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        </svg>
                                        Settings
                                    </a>
                                    
                                    <div class="border-t border-slate-100 my-1.5"></div>
                                    
                                    <button type="button" @onclick="TriggerLogout" class="flex items-center w-full px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors font-medium">
                                        <svg class="mr-3 h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                        </svg>
                                        Logout
                                    </button>
                                </div>
                            }
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="text-sm font-semibold text-slate-600 hover:text-indigo-600 hover:bg-slate-50 px-4 py-2 rounded-xl transition-all duration-200">Log in</a>
                        <a href="/register" class="text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 hover:shadow-lg hover:shadow-indigo-600/20 px-5 py-2.5 rounded-full transition-all duration-200 ml-2">Sign up</a>
                    </NotAuthorized>
                </AuthorizeView>
                
                <!-- Responsive Menu Toggle Button -->
                <div class="flex items-center md:hidden">
                    <button @onclick="ToggleMobileMenu" class="inline-flex items-center justify-center p-2 rounded-xl text-slate-500 hover:text-indigo-600 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500 transition-colors duration-200">
                        <span class="sr-only">Open main menu</span>
                        @if (showMobileMenu)
                        {
                            <svg class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        }
                        else
                        {
                            <svg class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                            </svg>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Navigation Menu -->
    @if (showMobileMenu)
    {
        <div class="md:hidden border-t border-slate-200 bg-white/95 backdrop-blur-lg px-4 pt-2 pb-4 space-y-1 shadow-inner animate-in slide-in-from-top-4 duration-200">
            <AuthorizeView>
                <Authorized>
                    <NavLink href="/dashboard" @onclick="CloseMobileMenu" class="block px-3 py-2.5 rounded-xl text-base font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 transition-all" ActiveClass="bg-indigo-50 text-indigo-600">Dashboard</NavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="Permission:Course.Read" Context="coursesContext">
                <Authorized>
                    <NavLink href="/courses" @onclick="CloseMobileMenu" class="block px-3 py-2.5 rounded-xl text-base font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 transition-all" ActiveClass="bg-indigo-50 text-indigo-600">Courses</NavLink>
                </Authorized>
            </AuthorizeView>
            
            <AuthorizeView Policy="Permission:Course.Update" Context="courseAdminContext">
                <Authorized>
                    <NavLink href="/admin/courses" @onclick="CloseMobileMenu" class="block px-3 py-2.5 rounded-xl text-base font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 transition-all" ActiveClass="bg-indigo-50 text-indigo-600">Manage Courses</NavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="Permission:Category.Read" Context="categoryAdminContext">
                <Authorized>
                    <NavLink href="/admin/categories" @onclick="CloseMobileMenu" class="block px-3 py-2.5 rounded-xl text-base font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 transition-all" ActiveClass="bg-indigo-50 text-indigo-600">Manage Categories</NavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="Permission:User.Read" Context="userAdminContext">
                <Authorized>
                    <NavLink href="/admin/users" @onclick="CloseMobileMenu" class="block px-3 py-2.5 rounded-xl text-base font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 transition-all" ActiveClass="bg-indigo-50 text-indigo-600">Manage Users</NavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="Permission:Role.Read" Context="roleAdminContext">
                <Authorized>
                    <NavLink href="/admin/roles" @onclick="CloseMobileMenu" class="block px-3 py-2.5 rounded-xl text-base font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 transition-all" ActiveClass="bg-indigo-50 text-indigo-600">Manage Roles</NavLink>
                </Authorized>
            </AuthorizeView>
            
            <AuthorizeView Policy="Permission:AuditLog.Read" Context="auditAdminContext">
                <Authorized>
                    <NavLink href="/admin/audit-logs" @onclick="CloseMobileMenu" class="block px-3 py-2.5 rounded-xl text-base font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 transition-all" ActiveClass="bg-indigo-50 text-indigo-600">Audit Logs</NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized>
                    <div class="border-t border-slate-200/50 my-2 pt-2">
                        <button type="button" @onclick="TriggerLogout" class="flex items-center w-full px-3 py-2.5 rounded-xl text-base font-semibold text-red-600 hover:bg-red-50 transition-all">
                            <svg class="mr-3 h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            Logout
                        </button>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    }
</nav>

<ConfirmationModal
    IsVisible="@showLogoutConfirm"
    Title="Confirm Logout"
    Message="Are you sure you want to log out?"
    ConfirmText="@(isLoggingOut ? "Logging out..." : "Logout")"
    CancelText="Cancel"
    IsDestructive="true"
    OnConfirm="ConfirmLogout"
    OnCancel="CancelLogout" />

@code {
    private bool showLogoutConfirm = false;
    private bool isLoggingOut = false;
    private bool isUserMenuOpen = false;
    private bool showMobileMenu = false;

    private void ToggleUserMenu()
    {
        isUserMenuOpen = !isUserMenuOpen;
    }

    private void CloseUserMenu()
    {
        isUserMenuOpen = false;
    }

    private void ToggleMobileMenu()
    {
        showMobileMenu = !showMobileMenu;
    }

    private void CloseMobileMenu()
    {
        showMobileMenu = false;
    }

    private void TriggerLogout()
    {
        isUserMenuOpen = false;
        showMobileMenu = false;
        showLogoutConfirm = true;
    }

    private void CancelLogout()
    {
        showLogoutConfirm = false;
        isUserMenuOpen = false;
    }

    private async Task ConfirmLogout()
    {
        if (isLoggingOut) return;

        try
        {
            isLoggingOut = true;
            isUserMenuOpen = false;
            showLogoutConfirm = false;

            await AuthApiService.LogoutAsync();

            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "An error occurred during logout.");
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        finally
        {
            isLoggingOut = false;
        }
    }

    private string GetDisplayRole(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole("SuperAdmin"))
        {
            return "System Administrator";
        }
        if (user.IsInRole("Admin"))
        {
            return "Administrator";
        }
        if (user.IsInRole("Student"))
        {
            return "Student";
        }
        return string.Empty;
    }

    private string GetRoleBadgeClass(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole("SuperAdmin"))
        {
            return "inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-semibold bg-rose-50 text-rose-700 ring-1 ring-rose-600/20 mt-0.5 w-fit";
        }
        if (user.IsInRole("Admin"))
        {
            return "inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-semibold bg-amber-50 text-amber-700 ring-1 ring-amber-600/20 mt-0.5 w-fit";
        }
        if (user.IsInRole("Student"))
        {
            return "inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-semibold bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20 mt-0.5 w-fit";
        }
        return "hidden";
    }
}
