@using ELearningManagementSystem.App.Components.Shared
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavManager
@implements IDisposable

@* â”€â”€ Mobile Backdrop â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
@if (IsOpen)
{
    <div class="fixed inset-0 z-30 bg-slate-900/50 backdrop-blur-sm lg:hidden"
         @onclick="HandleClose" aria-hidden="true"></div>
}

@* â”€â”€ Sidebar Container â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
<aside class="@SidebarCssClasses fixed inset-y-0 left-0 z-40 flex flex-col
              bg-white border-r border-slate-200 transition-all duration-300 ease-in-out">

    @* â”€â”€ Brand Header â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
    <div class="flex items-center @(IsCollapsed ? "justify-center" : "justify-between") h-16 px-4 border-b border-slate-100 flex-shrink-0">
        <a href="/" class="flex items-center gap-3 group">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-500 via-purple-600 to-pink-500
                        flex items-center justify-center shadow-md shadow-indigo-500/20
                        group-hover:scale-105 group-hover:shadow-indigo-500/40 transition-all duration-300 flex-shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                          d="M12 14l9-5-9-5-9 5 9 5z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                          d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055
                             a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
                </svg>
            </div>
            @if (!IsCollapsed)
            {
                <div class="flex flex-col min-w-0">
                    <span class="text-sm font-extrabold text-slate-900 tracking-tight leading-none">EduSphere</span>
                    <span class="text-[9px] text-slate-400 font-bold tracking-widest uppercase mt-0.5">LMS Portal</span>
                </div>
            }
        </a>

        @* Mobile Close Button *@
        <button @onclick="HandleClose"
                class="lg:hidden p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors"
                aria-label="Close sidebar">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>

    @* â”€â”€ Scrollable Navigation Items â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
    <nav class="flex-1 overflow-y-auto px-2.5 py-4 space-y-1">

        @* â”€â”€ General Section â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
        <AuthorizeView Context="genContext">
            <Authorized>
                @if (!IsCollapsed)
                {
                    <p class="px-3 pt-1 pb-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">General</p>
                }
                else
                {
                    <div class="my-1 border-t border-slate-100"></div>
                }

                <NavLink href="/admin/dashboard" Match="NavLinkMatch.All" title="Dashboard"
                         class="@GetNavItemClass()" ActiveClass="@NavActiveClass" @onclick="HandleClose">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Dashboard</span>
                    }
                </NavLink>

            </Authorized>
        </AuthorizeView>



        @* â”€â”€ Administration Section â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
        <AuthorizeView Policy="Permission:Course.Update" Context="adminHdrCtx">
            <Authorized>
                @if (!IsCollapsed)
                {
                    <p class="px-3 pt-3 pb-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Administration</p>
                }
                else
                {
                    <div class="my-1.5 border-t border-slate-100"></div>
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permission:Course.Update" Context="courseAdminCtx">
            <Authorized>
                <NavLink href="/admin/courses" title="Manage Courses"
                         class="@GetNavItemClass()" ActiveClass="@NavActiveClass" @onclick="HandleClose">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10
                                 a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0
                                 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Manage Courses</span>
                    }
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permission:Course.Update" Context="courseExamAdminCtx">
            <Authorized>
                <NavLink href="/admin/exams" title="Course Exams"
                         class="@GetNavItemClass()" ActiveClass="@NavActiveClass" @onclick="HandleClose">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Course Exams</span>
                    }
                </NavLink>

                <NavLink href="/admin/payments" title="Pending Payments"
                         class="@GetNavItemClass()" ActiveClass="@NavActiveClass" @onclick="HandleClose">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Pending Payments</span>
                    }
                </NavLink>

                <NavLink href="/admin/payment-methods" title="Payment Config"
                         class="@GetNavItemClass()" ActiveClass="@NavActiveClass" @onclick="HandleClose">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Payment Config</span>
                    }
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permission:Category.Read" Context="categoryAdminCtx">
            <Authorized>
                <NavLink href="/admin/categories" title="Categories"
                         class="@GetNavItemClass()" ActiveClass="@NavActiveClass" @onclick="HandleClose">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7
                                 a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Categories</span>
                    }
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permission:User.Read" Context="userAdminCtx">
            <Authorized>
                <NavLink href="/admin/users" title="Manage Users"
                         class="@GetNavItemClass()" ActiveClass="@NavActiveClass" @onclick="HandleClose">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Manage Users</span>
                    }
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permission:Role.Read" Context="roleAdminCtx">
            <Authorized>
                <NavLink href="/admin/roles" title="Manage Roles"
                         class="@GetNavItemClass()" ActiveClass="@NavActiveClass" @onclick="HandleClose">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0
                                 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622
                                 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Manage Roles</span>
                    }
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permission:AuditLog.Read" Context="auditAdminCtx">
            <Authorized>
                <NavLink href="/admin/audit-logs" title="Audit Logs"
                         class="@GetNavItemClass()" ActiveClass="@NavActiveClass" @onclick="HandleClose">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2
                                 M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Audit Logs</span>
                    }
                </NavLink>
            </Authorized>
        </AuthorizeView>

        @* â”€â”€ Reports Parent Menu & Expandable Sub-Menu â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
        <AuthorizeView Context="reportsParentCtx">
            <Authorized>
                @{
                    var hasEnrollmentRead = reportsParentCtx.User.HasClaim("permission", "EnrollmentHistory.Read");
                    var hasCoursePerfRead = reportsParentCtx.User.HasClaim("permission", "CoursePerformance.Read");
                    var hasQuizPerfRead = reportsParentCtx.User.HasClaim("permission", "QuizPerformance.Read");
                    var hasAuditRead = reportsParentCtx.User.HasClaim("permission", "AuditLog.Read");
                    var canSeeReports = hasEnrollmentRead || hasCoursePerfRead || hasQuizPerfRead || hasAuditRead;
                }

                @if (canSeeReports)
                {
                    <div class="space-y-1">
                        @* Parent Toggle Button *@
                        <button type="button" @onclick="ToggleReportsMenu" title="Reports"
                                class="@(IsReportsActive ? "bg-indigo-50 text-indigo-600 font-extrabold shadow-2xs" : "text-slate-600 hover:text-indigo-600 hover:bg-indigo-50/70 font-medium") flex items-center justify-between px-3 py-2.5 rounded-xl text-sm transition-all duration-150 w-full cursor-pointer">
                            <div class="flex items-center gap-3">
                                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                                </svg>
                                @if (!IsCollapsed)
                                {
                                    <span class="truncate">Reports</span>
                                }
                            </div>
                            @if (!IsCollapsed)
                            {
                                <svg class="w-4 h-4 transition-transform duration-200 @(IsReportsExpanded ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            }
                        </button>

                        @* Collapsible Sub-Menu Items *@
                        @if (IsReportsExpanded && !IsCollapsed)
                        {
                            <div class="pl-4 pr-1 space-y-1 transition-all duration-200">
                                @* Sub-menu 1: Enrollment History *@
                                <AuthorizeView Policy="Permission:EnrollmentHistory.Read" Context="subEnrollCtx">
                                    <Authorized>
                                        <NavLink href="/admin/reports/enrollments" title="Enrollment History"
                                                 class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:text-indigo-600 hover:bg-indigo-50/70 transition-all w-full"
                                                 ActiveClass="bg-indigo-50 text-indigo-600 !font-bold" @onclick="HandleClose">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                            <span class="truncate">Enrollment History</span>
                                        </NavLink>
                                    </Authorized>
                                </AuthorizeView>

                                @* Sub-menu 2: Course Performance *@
                                <AuthorizeView Policy="Permission:CoursePerformance.Read" Context="subCourseCtx">
                                    <Authorized>
                                        <NavLink href="/admin/reports/course-performance" title="Course Performance"
                                                 class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:text-indigo-600 hover:bg-indigo-50/70 transition-all w-full"
                                                 ActiveClass="bg-indigo-50 text-indigo-600 !font-bold" @onclick="HandleClose">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                            <span class="truncate">Course Performance</span>
                                        </NavLink>
                                    </Authorized>
                                </AuthorizeView>

                                @* Sub-menu 3: Quiz Performance & Efficacy *@
                                <AuthorizeView Policy="Permission:QuizPerformance.Read" Context="subQuizCtx">
                                    <Authorized>
                                        <NavLink href="/admin/reports/quiz-performance" title="Quiz Performance"
                                                 class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:text-indigo-600 hover:bg-indigo-50/70 transition-all w-full"
                                                 ActiveClass="bg-indigo-50 text-indigo-600 !font-bold" @onclick="HandleClose">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                            <span class="truncate">Quiz Performance</span>
                                        </NavLink>
                                    </Authorized>
                                </AuthorizeView>

                                @* Sub-menu 4: Audit Activity *@
                                <AuthorizeView Policy="Permission:AuditLog.Read" Context="subAuditCtx">
                                    <Authorized>
                                        <NavLink href="/admin/reports/audit-activity" title="Audit Activity"
                                                 class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:text-indigo-600 hover:bg-indigo-50/70 transition-all w-full"
                                                 ActiveClass="bg-indigo-50 text-indigo-600 !font-bold" @onclick="HandleClose">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                            <span class="truncate">Audit Activity</span>
                                        </NavLink>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        }
                    </div>
                }
            </Authorized>
        </AuthorizeView>

    </nav>
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool IsReportsExpanded = false;

    private bool IsReportsActive =>
        NavManager.Uri.Contains("/admin/reports", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        if (IsReportsActive)
        {
            IsReportsExpanded = true;
        }
        NavManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (IsReportsActive)
        {
            IsReportsExpanded = true;
        }
        StateHasChanged();
    }

    private void ToggleReportsMenu()
    {
        IsReportsExpanded = !IsReportsExpanded;
    }

    private string SidebarCssClasses =>
        (IsOpen ? "translate-x-0 " : "-translate-x-full lg:translate-x-0 ") +
        (IsCollapsed ? "w-16" : "w-64");

    private string GetNavItemClass()
    {
        return IsCollapsed
            ? "flex items-center justify-center p-2.5 rounded-xl text-slate-600 hover:text-indigo-600 hover:bg-indigo-50/70 transition-all duration-150 w-full"
            : "flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50/70 transition-all duration-150 w-full";
    }

    private const string NavActiveClass =
        "bg-indigo-50 text-indigo-600 font-semibold";

    private async Task HandleClose() => await OnClose.InvokeAsync();

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }
}
