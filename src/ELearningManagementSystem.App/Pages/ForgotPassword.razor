@page "/forgot-password"
@layout ELearningManagementSystem.App.Components.Layout.AuthLayout
@implements IDisposable
@inject AuthApiService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ISessionStorageService SessionStorage
@using Blazored.SessionStorage
@using System.ComponentModel.DataAnnotations
@using System.Timers
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Forgot Password - LMS</PageTitle>

<div class="min-h-screen bg-slate-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <div class="mx-auto w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-600 to-purple-600 flex items-center justify-center shadow-lg shadow-indigo-500/30">
            <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
        </div>
        <h2 class="mt-6 text-center text-3xl font-extrabold text-slate-900 tracking-tight">Reset your password</h2>
        <p class="mt-2 text-center text-sm text-slate-600">
            We'll send a one-time password (OTP) to your email
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-4 shadow-xl shadow-slate-200/40 sm:rounded-2xl sm:px-10 border border-slate-100">

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mb-6 rounded-xl bg-red-50 p-4 border border-red-100 flex items-start">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </div>
                    <div class="ml-3 text-sm text-red-700">
                        <p>@_errorMessage</p>
                    </div>
                </div>
            }

            @if (!_otpSent)
            {
                <EditForm Model="_otpModel" OnValidSubmit="HandleSendOtp" class="space-y-6">
                    <DataAnnotationsValidator />

                    <div>
                        <label for="email" class="block text-sm font-medium text-slate-700">Email address</label>
                        <div class="mt-1 relative rounded-xl shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <InputText id="email" @bind-Value="_otpModel.Email" class="block w-full pl-10 pr-3 py-3 border border-slate-300 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors" placeholder="you@example.com" />
                        </div>
                        <ValidationMessage For="@(() => _otpModel.Email)" class="mt-1 text-sm text-red-600" />
                    </div>

                    <div>
                        <button type="submit" disabled="@_isLoading" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-70 transition-all">
                            @if (_isLoading)
                            {
                                <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <span>Sending...</span>
                            }
                            else
                            {
                                <span>Send OTP</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
            else
            {
                <div class="mb-4 rounded-xl bg-indigo-50 p-4 border border-indigo-100">
                    <p class="text-sm text-indigo-700">
                        We sent a 6-digit code to <span class="font-semibold">@_otpModel.Email</span>.
                        <span class="block mt-1 text-xs text-indigo-500">Enter it below to verify — it expires in 1 minute.</span>
                    </p>
                </div>

                <EditForm Model="_verifyModel" OnValidSubmit="HandleVerifyOtp" class="space-y-6">
                    <DataAnnotationsValidator />

                    <div>
                        <label class="block text-sm font-medium text-slate-700">One-time password</label>
                        <div class="mt-2 flex items-center gap-2 sm:gap-3" role="group" aria-label="Enter the 6-digit verification code">
                            @for (var i = 0; i < 6; i++)
                            {
                                var index = i;
                                <input type="text"
                                       value="@_otpDigits[index]"
                                       @ref="_otpBoxRefs[index]"
                                       @oninput="e => HandleOtpInput(index, e)"
                                       @onkeydown="e => HandleOtpKeyDown(index, e)"
                                       inputmode="numeric"
                                       autocomplete="one-time-code"
                                       aria-label="Digit @(index + 1) of 6"
                                       disabled="@_isLoading"
                                       class="h-12 w-full min-w-0 flex-1 rounded-xl border border-slate-300 bg-white text-center text-lg font-semibold text-slate-900 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none transition-colors sm:text-xl" />
                            }
                        </div>
                        <ValidationMessage For="@(() => _verifyModel.Otp)" class="mt-1 text-sm text-red-600" />
                    </div>

                    <div>
                        <button type="submit" disabled="@_isLoading" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-70 transition-all">
                            @if (_isLoading)
                            {
                                <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <span>Verifying...</span>
                            }
                            else
                            {
                                <span>Verify OTP</span>
                            }
                        </button>
                    </div>
                </EditForm>

                @* Countdown + resend *@
                <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
                    <div class="flex items-center gap-2 text-sm">
                        <span class="font-mono font-semibold @(RemainingSeconds <= 10 ? "text-red-500" : "text-slate-700") tabular-nums">@($"{(RemainingSeconds / 60):D2}:{(RemainingSeconds % 60):D2}")</span>
                        <span class="text-slate-500">remaining</span>
                    </div>
                    <button type="button" @onclick="HandleResendOtp" disabled="@_isLoading" class="text-sm font-medium text-indigo-600 hover:text-indigo-500 disabled:text-slate-300 disabled:cursor-not-allowed transition-colors">
                        Resend OTP
                    </button>
                </div>
            }
        </div>

        <p class="text-center text-slate-600 text-sm mt-6">
            Remembered it?
            <a href="/login" class="font-medium text-indigo-600 hover:text-indigo-500 transition-colors">Sign in</a>
        </p>
    </div>
</div>

@code {
    private const int OtpLifetimeSeconds = 60;
    private const string ResetOtpStorageKey = "resetOtp";

    private SendOtpModel _otpModel = new();
    private VerifyOtpModel _verifyModel = new();
    private string _errorMessage = string.Empty;
    private bool _isLoading;
    private bool _otpSent;
    private DateTime _otpExpiresAtUtc;

    private System.Timers.Timer? _timer;

    private readonly string[] _otpDigits = ["", "", "", "", "", ""];
    private readonly ElementReference[] _otpBoxRefs = new ElementReference[6];
    private bool _focusOtpOnNextRender;

    public int RemainingSeconds
    {
        get
        {
            var remaining = (int)Math.Ceiling((_otpExpiresAtUtc - DateTime.UtcNow).TotalSeconds);
            return Math.Max(0, remaining);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusOtpOnNextRender)
        {
            _focusOtpOnNextRender = false;
            var index = Array.FindIndex(_otpDigits, d => d.Length == 0);
            await FocusBoxAsync(index < 0 ? 0 : index);
        }
    }

    private async Task HandleSendOtp()
    {
        _errorMessage = string.Empty;
        _isLoading = true;

        try
        {
            var result = await AuthService.ForgotPasswordAsync(_otpModel.Email);

            if (result.IsSuccess)
            {
                _otpSent = true;
                StartCountdown();
                _focusOtpOnNextRender = true;
            }
            else
            {
                _errorMessage = result.Message;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleResendOtp()
    {
        _errorMessage = string.Empty;
        _isLoading = true;

        try
        {
            var result = await AuthService.ForgotPasswordAsync(_otpModel.Email);

            if (result.IsSuccess)
            {
                ClearOtpBoxes();
                StartCountdown();
                _focusOtpOnNextRender = true;
            }
            else
            {
                _errorMessage = result.Message;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleVerifyOtp()
    {
        _errorMessage = string.Empty;
        _isLoading = true;

        try
        {
            if (RemainingSeconds <= 0)
            {
                _errorMessage = "This OTP has expired. Click 'Resend OTP' to get a new code.";
                return;
            }

            var result = await AuthService.VerifyOtpAsync(_verifyModel.Otp);

            if (result.IsSuccess)
            {
                StopCountdown();
                await SessionStorage.SetItemAsync(ResetOtpStorageKey, _verifyModel.Otp);
                Navigation.NavigateTo("/reset-password");
            }
            else
            {
                _errorMessage = result.Message;
                if (_errorMessage.Contains("expired", System.StringComparison.OrdinalIgnoreCase))
                    ForceExpire();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void StartCountdown()
    {
        StopCountdown();
        _otpExpiresAtUtc = DateTime.UtcNow.AddSeconds(OtpLifetimeSeconds);
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += OnTimerElapsed;
        _timer.AutoReset = true;
        _timer.Start();
        StateHasChanged();
    }

    private void StopCountdown()
    {
        if (_timer is not null)
        {
            _timer.Stop();
            _timer.Elapsed -= OnTimerElapsed;
            _timer.Dispose();
            _timer = null;
        }
    }

    private void OnTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        if (RemainingSeconds <= 0)
        {
            InvokeAsync(() =>
            {
                StopCountdown();
                StateHasChanged();
            });
            return;
        }

        InvokeAsync(StateHasChanged);
    }

    private void ForceExpire()
    {
        _otpExpiresAtUtc = DateTime.UtcNow;
        StopCountdown();
        StateHasChanged();
    }

    private async Task HandleOtpInput(int index, ChangeEventArgs args)
    {
        var raw = args?.Value?.ToString() ?? string.Empty;

        if (raw.Length == 0)
        {
            if (_otpDigits[index].Length > 0)
            {
                _otpDigits[index] = string.Empty;
                SyncOtpModel();
            }
            return;
        }

        var digits = raw.Where(char.IsDigit).ToArray();
        if (digits.Length == 0) return;

        var position = index;
        foreach (var ch in digits)
        {
            if (position >= _otpDigits.Length) break;
            _otpDigits[position] = ch.ToString();
            position++;
        }
        SyncOtpModel();

        if (position < _otpDigits.Length)
            await FocusBoxAsync(position);
    }

    private async Task HandleOtpKeyDown(int index, KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Backspace":
                if (_otpDigits[index].Length == 0 && index > 0)
                    await FocusBoxAsync(index - 1);
                break;
            case "ArrowLeft" when index > 0:
                await FocusBoxAsync(index - 1);
                break;
            case "ArrowRight" when index < _otpDigits.Length - 1:
                await FocusBoxAsync(index + 1);
                break;
        }
    }

    private void ClearOtpBoxes()
    {
        for (var i = 0; i < _otpDigits.Length; i++)
            _otpDigits[i] = string.Empty;
        SyncOtpModel();
    }

    private void SyncOtpModel()
    {
        _verifyModel.Otp = string.Concat(_otpDigits);
    }

    private async Task FocusBoxAsync(int index)
    {
        if (index < 0 || index >= _otpBoxRefs.Length) return;
        await _otpBoxRefs[index].FocusAsync();
    }

    public void Dispose()
    {
        StopCountdown();
    }

    private class SendOtpModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email format.")]
        [MaxLength(255, ErrorMessage = "Email must not exceed 255 characters.")]
        public string Email { get; set; } = string.Empty;
    }

    private class VerifyOtpModel
    {
        [Required(ErrorMessage = "OTP is required.")]
        [RegularExpression("^[0-9]{6}$", ErrorMessage = "Enter the 6-digit code from your email.")]
        public string Otp { get; set; } = string.Empty;
    }
}