@page "/"
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]
@using ELearningManagementSystem.App.Components.UI

<PageTitle>Dashboard - LMS</PageTitle>

<PageHeader Title="Welcome Back" Description="Overview of your learning progress and system access." />

<div class="space-y-8">
    <div class="grid md:grid-cols-2 gap-8">
        <!-- User Status Card -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
            <h2 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-indigo-100 flex items-center justify-center">
                    <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
                Account Profile
            </h2>

            @if (_currentUser is null)
            {
                <div class="flex items-center justify-center p-8">
                    <svg class="animate-spin w-8 h-8 text-indigo-600" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                    </svg>
                </div>
            }
            else
            {
                <div class="space-y-6">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                            <span class="text-xs text-slate-500 uppercase font-semibold tracking-wider block mb-1">Full Name</span>
                            <span class="text-slate-900 font-medium">@_currentUser.FullName</span>
                        </div>
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                            <span class="text-xs text-slate-500 uppercase font-semibold tracking-wider block mb-1">Email Address</span>
                            <span class="text-slate-900 font-medium truncate block" title="@_currentUser.Email">@_currentUser.Email</span>
                        </div>
                    </div>
                    
                    <div>
                        <span class="text-xs text-slate-500 uppercase font-semibold tracking-wider block mb-2">Role & Access Level</span>
                        <div class="flex items-center gap-3">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold @(string.Equals(_currentUser.Role, "Admin", StringComparison.OrdinalIgnoreCase) ? "bg-red-100 text-red-800 border border-red-200" : "bg-indigo-100 text-indigo-800 border border-indigo-200")">
                                @_currentUser.Role
                            </span>
                        </div>
                    </div>
                    
                    <div>
                        <span class="text-xs text-slate-500 uppercase font-semibold tracking-wider block mb-3">Effective Permissions</span>
                        <div class="flex flex-wrap gap-2">
                            @if (_currentUser.Permissions is null || !_currentUser.Permissions.Any())
                            {
                                <span class="text-sm text-slate-500 italic">No administrative permissions assigned.</span>
                            }
                            else
                            {
                                @foreach (var perm in _currentUser.Permissions)
                                {
                                    <span class="bg-slate-100 text-slate-700 text-xs px-3 py-1.5 rounded-lg border border-slate-200 font-medium">
                                        @perm
                                    </span>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- RBAC API Protection Tests -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col">
            <div class="mb-6">
                <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2 mb-2">
                    <div class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center">
                        <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                    </div>
                    API Diagnostics
                </h2>
                <p class="text-slate-500 text-sm">
                    Verify server-side JWT authorization rules dynamically.
                </p>
            </div>

            <div class="space-y-3 flex-1 flex flex-col justify-center">
                <!-- Test 1: Authenticated -->
                <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl border border-slate-100 hover:border-slate-200 transition-colors">
                    <div>
                        <h3 class="text-sm font-semibold text-slate-900">Any Authenticated User</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Basic authentication check</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-xs font-semibold px-2.5 py-1 rounded-full @GetTestBadgeClass(_authTestResult)">
                            @GetTestStatusText(_authTestResult)
                        </span>
                        <button @onclick="TestAuthOnly" class="text-xs bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 px-3 py-1.5 rounded-lg font-medium transition-colors shadow-sm">
                            Run Test
                        </button>
                    </div>
                </div>

                <!-- Test 2: Course.Read -->
                <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl border border-slate-100 hover:border-slate-200 transition-colors">
                    <div>
                        <h3 class="text-sm font-semibold text-slate-900">Read Courses</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Requires 'Course.Read'</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-xs font-semibold px-2.5 py-1 rounded-full @GetTestBadgeClass(_courseReadTestResult)">
                            @GetTestStatusText(_courseReadTestResult)
                        </span>
                        <button @onclick="TestCourseRead" class="text-xs bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 px-3 py-1.5 rounded-lg font-medium transition-colors shadow-sm">
                            Run Test
                        </button>
                    </div>
                </div>

                <!-- Test 3: Course.Create -->
                <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl border border-slate-100 hover:border-slate-200 transition-colors">
                    <div>
                        <h3 class="text-sm font-semibold text-slate-900">Create Courses</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Requires 'Course.Create'</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-xs font-semibold px-2.5 py-1 rounded-full @GetTestBadgeClass(_courseCreateTestResult)">
                            @GetTestStatusText(_courseCreateTestResult)
                        </span>
                        <button @onclick="TestCourseCreate" class="text-xs bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 px-3 py-1.5 rounded-lg font-medium transition-colors shadow-sm">
                            Run Test
                        </button>
                    </div>
                </div>

                <!-- Test 4: Role.Delete -->
                <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl border border-slate-100 hover:border-slate-200 transition-colors">
                    <div>
                        <h3 class="text-sm font-semibold text-slate-900">Delete Roles</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Requires 'Role.Delete'</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-xs font-semibold px-2.5 py-1 rounded-full @GetTestBadgeClass(_roleDeleteTestResult)">
                            @GetTestStatusText(_roleDeleteTestResult)
                        </span>
                        <button @onclick="TestRoleDelete" class="text-xs bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 px-3 py-1.5 rounded-lg font-medium transition-colors shadow-sm">
                            Run Test
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CurrentUserResponse? _currentUser;
    private int _authTestResult = 0;
    private int _courseReadTestResult = 0;
    private int _courseCreateTestResult = 0;
    private int _roleDeleteTestResult = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserProfile();
    }

    private async Task LoadUserProfile()
    {
        try
        {
            _currentUser = await Http.GetFromJsonAsync<CurrentUserResponse>("api/auth/me");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user profile: {ex.Message}");
        }
    }

    private async Task TestAuthOnly()
    {
        _authTestResult = await ExecuteTest("api/test-auth/authenticated");
    }

    private async Task TestCourseRead()
    {
        _courseReadTestResult = await ExecuteTest("api/test-auth/course-read");
    }

    private async Task TestCourseCreate()
    {
        _courseCreateTestResult = await ExecuteTest("api/test-auth/course-create");
    }

    private async Task TestRoleDelete()
    {
        _roleDeleteTestResult = await ExecuteTest("api/test-auth/role-delete");
    }

    private async Task<int> ExecuteTest(string endpoint)
    {
        try
        {
            var response = await Http.GetAsync(endpoint);
            return (int)response.StatusCode;
        }
        catch
        {
            return 500;
        }
    }

    private string GetTestStatusText(int statusCode)
    {
        if (statusCode == 0) return "Not Run";
        if (statusCode == 200) return "Allowed";
        if (statusCode == 403) return "Forbidden";
        if (statusCode == 401) return "Unauthorized";
        return $"Error {statusCode}";
    }

    private string GetTestBadgeClass(int statusCode)
    {
        if (statusCode == 0) return "bg-slate-200 text-slate-600";
        if (statusCode == 200) return "bg-green-100 text-green-800 border border-green-200";
        if (statusCode == 403) return "bg-amber-100 text-amber-800 border border-amber-200";
        if (statusCode == 401) return "bg-red-100 text-red-800 border border-red-200";
        return "bg-red-100 text-red-800 border border-red-200";
    }

    public record CurrentUserResponse(
        int UserId,
        string FullName,
        string Email,
        string Role,
        List<string> Permissions);
}
