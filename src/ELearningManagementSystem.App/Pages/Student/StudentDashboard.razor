@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@attribute [Authorize]
@inject StudentDashboardApiClient DashboardClient
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>My Dashboard</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    @if (IsLoading)
    {
        <!-- Loading skeleton -->
        <div class="rounded-3xl bg-slate-200/70 animate-pulse h-60"></div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            @for (var i = 0; i < 4; i++)
            {
                <div class="card p-5 animate-pulse">
                    <div class="h-3 bg-slate-100 rounded w-16"></div>
                    <div class="mt-3 h-8 bg-slate-200 rounded w-12"></div>
                    <div class="mt-4 h-2.5 bg-slate-100 rounded w-20"></div>
                </div>
            }
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 grid sm:grid-cols-2 gap-4">
                @for (var i = 0; i < 2; i++)
                {
                    <div class="card overflow-hidden animate-pulse">
                        <div class="h-32 bg-slate-200"></div>
                        <div class="p-4 space-y-2.5">
                            <div class="h-4 bg-slate-200 rounded w-3/4"></div>
                            <div class="h-1.5 bg-slate-100 rounded w-full"></div>
                            <div class="h-2.5 bg-slate-100 rounded w-1/2"></div>
                        </div>
                    </div>
                }
            </div>
            <div class="card p-5 animate-pulse">
                <div class="h-4 bg-slate-200 rounded w-24"></div>
                <div class="mt-6 h-24 flex items-end gap-2">
                    @for (var i = 0; i < 7; i++)
                    {
                        <div class="flex-1 bg-slate-100 rounded-lg" style="height: @(25 + (i * 41) % 70)px"></div>
                    }
                </div>
            </div>
        </div>
    }
    else if (HasError)
    {
        <EmptyState Title="Dashboard Unavailable" Description="@ErrorMessage">
            <Icon>
                <svg class="mx-auto h-12 w-12 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </Icon>
            <ActionTemplate>
                <button @onclick="LoadDashboardAsync" class="inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-xl text-slate-700 bg-white hover:bg-slate-50 transition-colors">
                    Try Again
                </button>
            </ActionTemplate>
        </EmptyState>
    }
    else if (Dashboard != null)
    {
        var extraCourses = Dashboard.CoursesInProgress.ToList();
        var quizReadyOthers = extraCourses.Where(c => c.IsFinalQuizAvailable).ToList();
        var weekMax = GetWeekMax();

        <!-- ── 1. Hero ─────────────────────────────────────────────────── -->
        <section class="rounded-3xl bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-950 shadow-xl shadow-indigo-900/10 overflow-hidden" aria-labelledby="welcome-heading">
            <div class="px-6 sm:px-8 pt-7 pb-6 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                <div>
                    <p class="text-[11px] font-semibold uppercase tracking-widest text-indigo-300/90">@DateTime.Now.ToString("dddd, dd-MM-yyyy")</p>
                    <h1 id="welcome-heading" class="mt-1.5 text-2xl sm:text-3xl font-extrabold text-white tracking-tight break-words">
                        @GetGreeting(), @GetFirstName()
                    </h1>
                </div>
                <div class="hidden md:flex items-center gap-2 flex-shrink-0">
                    <span class="rounded-full bg-white/10 ring-1 ring-white/15 px-3.5 py-1.5 text-xs font-medium text-indigo-100">
                        @Dashboard.Overview.TotalEnrolledCourses enrolled
                    </span>
                    <span class="rounded-full bg-white/10 ring-1 ring-white/15 px-3.5 py-1.5 text-xs font-medium text-indigo-100">
                        @Dashboard.Overview.CompletedLessons lessons done
                    </span>
                </div>
            </div>
        </section>

        <!-- ── 2. Quiz-ready nudge ─────────────────────────────────────── -->
        @if (quizReadyOthers.Any())
        {
            var firstReady = quizReadyOthers[0];
            <section class="rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 flex flex-col sm:flex-row sm:items-center gap-3" role="status">
                <span class="h-9 w-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center flex-shrink-0" aria-hidden="true">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                    </svg>
                </span>
                <p class="flex-1 text-sm text-amber-900">
                    <span class="font-semibold">Final quiz ready:</span> "@firstReady.Title"
                    @if (quizReadyOthers.Count > 1)
                    {
                        <span class="text-amber-700">&middot; +@(quizReadyOthers.Count - 1) more course@(quizReadyOthers.Count == 2 ? "" : "s") waiting</span>
                    }
                </p>
                <AuthorizeView Policy="Permission:Quiz.Read">
                    <Authorized>
                        <a href="/courses/@firstReady.CourseId/quiz" class="inline-flex items-center justify-center rounded-xl border border-amber-300 bg-white px-4 py-2 text-sm font-semibold text-amber-800 hover:bg-amber-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 transition-colors flex-shrink-0">
                            Take Quiz
                            <svg class="ml-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                    </Authorized>
                </AuthorizeView>
            </section>
        }



        <!-- ── 3. KPI strip ────────────────────────────────────────────── -->
        <section aria-labelledby="overview-heading">
            <h2 id="overview-heading" class="sr-only">Learning Overview</h2>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="card p-5">
                    <div class="flex items-start justify-between gap-2">
                        <p class="text-sm font-medium text-slate-500">In Progress</p>
                        <span class="h-9 w-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center flex-shrink-0" aria-hidden="true">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                        </span>
                    </div>
                    <p class="mt-1 text-3xl font-bold text-slate-900 tracking-tight">@Dashboard.Overview.InProgressCourses</p>
                    <p class="mt-2 text-xs text-slate-400">of @Dashboard.Overview.TotalEnrolledCourses enrolled</p>
                </div>
                <div class="card p-5">
                    <div class="flex items-start justify-between gap-2">
                        <p class="text-sm font-medium text-slate-500">Completed</p>
                        <span class="h-9 w-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0" aria-hidden="true">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </span>
                    </div>
                    <p class="mt-1 text-3xl font-bold text-slate-900 tracking-tight">@Dashboard.Overview.CompletedCourses</p>
                    <p class="mt-2 text-xs text-slate-400">of @Dashboard.Overview.TotalEnrolledCourses enrolled</p>
                </div>
                <div class="card p-5">
                    <div class="flex items-start justify-between gap-2">
                        <p class="text-sm font-medium text-slate-500">Lessons Done</p>
                        <span class="h-9 w-9 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center flex-shrink-0" aria-hidden="true">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </span>
                    </div>
                    <p class="mt-1 text-3xl font-bold text-slate-900 tracking-tight">@Dashboard.Overview.CompletedLessons</p>
                    <p class="mt-2 text-xs text-slate-400">@Dashboard.LessonsThisWeek this week</p>
                </div>
                <div class="card p-5">
                    <div class="flex items-start justify-between gap-2">
                        <p class="text-sm font-medium text-slate-500">Avg. Quiz Score</p>
                        <span class="h-9 w-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center flex-shrink-0" aria-hidden="true">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                            </svg>
                        </span>
                    </div>
                    @if (Dashboard.Overview.HasQuizData)
                    {
                        <p class="mt-1 text-3xl font-bold text-slate-900 tracking-tight">@Math.Round(Dashboard.Overview.AverageQuizScore)<span class="text-lg text-slate-400">%</span></p>
                        <p class="mt-2 text-xs text-slate-400">@Dashboard.Overview.QuizzesPassed of @Dashboard.Overview.QuizAttemptsCount passed</p>
                    }
                    else
                    {
                        <p class="mt-1 text-3xl font-bold text-slate-300 tracking-tight">&mdash;</p>
                        <p class="mt-2 text-xs text-slate-400">No quizzes yet</p>
                    }
                </div>
            </div>
        </section>

        <!-- ── 4. My Learning + This Week ──────────────────────────────── -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

            <!-- My Learning (tabs) -->
            <section class="lg:col-span-2" aria-labelledby="mylearning-heading">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                    <h2 id="mylearning-heading" class="text-base font-semibold text-slate-900">My Learning</h2>
                    <div class="flex items-center gap-3">
                        <div class="flex items-center gap-1 rounded-xl bg-slate-100 p-1" role="tablist" aria-label="My learning lists">
                            <button type="button" role="tab" id="tab-inprogress" aria-selected="@(IsInProgressTab ? "true" : "false")" aria-controls="panel-inprogress"
                                    @onclick='() => SelectTab("inprogress")'
                                    class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 @(IsInProgressTab ? "bg-white text-indigo-700 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                                Continue Learning (@extraCourses.Count)
                            </button>
                            <button type="button" role="tab" id="tab-completed" aria-selected="@(!IsInProgressTab ? "true" : "false")" aria-controls="panel-completed"
                                    @onclick='() => SelectTab("completed")'
                                    class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 @(!IsInProgressTab ? "bg-white text-emerald-700 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                                Completed (@Dashboard.CompletedCourses.Count)
                            </button>
                        </div>
                        <AuthorizeView Policy="Permission:Course.Read">
                            <Authorized>
                                <a href="/my-courses" class="text-sm font-medium text-indigo-600 hover:text-indigo-700 transition-colors whitespace-nowrap">View all</a>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>

                @if (IsInProgressTab)
                {
                    <div id="panel-inprogress" role="tabpanel" aria-labelledby="tab-inprogress">
                @if (extraCourses.Any())
                {
                    <div class="relative">
                        <div id="inprogress-carousel"
                             class="flex gap-4 overflow-x-auto snap-x pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
                             role="region" aria-label="Courses in progress" tabindex="0">
                            @foreach (var course in extraCourses)
                            {
                                <a href="@GetContinueUrl(course)"
                                   class="card w-64 flex-shrink-0 snap-start overflow-hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                                    <div class="relative h-24 bg-slate-100 overflow-hidden">
                                        @if (!string.IsNullOrEmpty(GetImageUrl(course.ThumbnailUrl)))
                                        {
                                            <img src="@GetImageUrl(course.ThumbnailUrl)" alt="" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center bg-indigo-50 text-indigo-300" aria-hidden="true">
                                                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                                </svg>
                                            </div>
                                        }
                                        @if (course.IsFinalQuizAvailable)
                                        {
                                            <span class="absolute top-2.5 right-2.5 inline-flex items-center gap-1 rounded-full bg-amber-500 px-2.5 py-1 text-[11px] font-semibold text-slate-900 shadow-sm">
                                                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                                                </svg>
                                                Quiz Ready
                                            </span>
                                        }
                                    </div>
                                    <div class="p-3.5">
                                        <h3 class="text-sm font-semibold text-slate-900 line-clamp-2 min-h-[2rem]">@course.Title</h3>
                                        <div class="mt-2.5 flex items-center gap-2.5">
                                            <div class="flex-1 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                                <div class="h-full bg-indigo-600 rounded-full" style="width: @(Math.Clamp(course.ProgressPercentage, 0, 100))%"></div>
                                            </div>
                                            <span class="text-[11px] font-medium text-slate-500 whitespace-nowrap">@course.CompletedLessons/@course.TotalLessons</span>
                                        </div>
                                        <div class="mt-2 flex items-center justify-between gap-2 text-xs">
                                            <span class="truncate text-slate-500">@GetCardFooterText(course)</span>
                                            <span class="ml-auto inline-flex text-indigo-600" aria-hidden="true">
                                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                                </svg>
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                        <button type="button" @onclick='() => ScrollCarouselAsync("inprogress-carousel", -1)' aria-label="Scroll courses in progress left"
                                class="absolute -left-3 top-1/2 -translate-y-1/2 hidden lg:flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 shadow-md hover:bg-slate-50 hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-colors z-10">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                            </svg>
                        </button>
                        <button type="button" @onclick='() => ScrollCarouselAsync("inprogress-carousel", 1)' aria-label="Scroll courses in progress right"
                                class="absolute -right-3 top-1/2 -translate-y-1/2 hidden lg:flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 shadow-md hover:bg-slate-50 hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-colors z-10">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </button>
                    </div>
                }
                else
                {
                    <div class="card p-6 flex items-center gap-4">
                        <span class="h-10 w-10 rounded-xl bg-indigo-50 text-indigo-500 flex items-center justify-center flex-shrink-0" aria-hidden="true">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                            </svg>
                        </span>
                        <div class="flex-1 min-w-0">
                            @if (Dashboard.CoursesInProgress.Count == 0 && Dashboard.CompletedCourses.Any())
                            {
                                <p class="text-sm font-medium text-slate-900">All caught up!</p>
                                <p class="text-xs text-slate-500 mt-0.5">You have completed every enrolled course. Explore the catalog to keep learning.</p>
                            }
                            else if (Dashboard.CoursesInProgress.Count == 0)
                            {
                                <p class="text-sm font-medium text-slate-900">No courses in progress yet.</p>
                                <p class="text-xs text-slate-500 mt-0.5">Browse the catalog and enroll in your first course.</p>
                            }
                            else
                            {
                                <p class="text-sm font-medium text-slate-900">You are focused on one course right now.</p>
                                <p class="text-xs text-slate-500 mt-0.5">Enroll in more courses and they will appear here.</p>
                            }
                        </div>
                        <AuthorizeView Policy="Permission:Course.Read">
                            <Authorized>
                                <a href="/courses" class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors flex-shrink-0">
                                    Browse
                                </a>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                }
                    </div>
                }
                else
                {
                    <div id="panel-completed" role="tabpanel" aria-labelledby="tab-completed">
                        @if (Dashboard.CompletedCourses.Any())
                        {
                            <div class="relative">
                                <div id="completed-carousel"
                                     class="flex gap-4 overflow-x-auto snap-x pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
                                     role="region" aria-label="Completed courses" tabindex="0">
                                    @foreach (var completed in Dashboard.CompletedCourses)
                                    {
                                        <a href="/courses/@completed.CourseId"
                                           class="card w-64 flex-shrink-0 snap-start overflow-hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">
                                            <div class="relative h-24 bg-slate-100 overflow-hidden">
                                                @if (!string.IsNullOrEmpty(GetImageUrl(completed.ThumbnailUrl)))
                                                {
                                                    <img src="@GetImageUrl(completed.ThumbnailUrl)" alt="" class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    <div class="w-full h-full flex items-center justify-center bg-emerald-50 text-emerald-300" aria-hidden="true">
                                                        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                        </svg>
                                                    </div>
                                                }
                                                <span class="absolute top-2 right-2 inline-flex items-center justify-center h-7 w-7 rounded-full bg-emerald-500 text-white shadow-sm" aria-hidden="true">
                                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                </span>
                                            </div>
                                            <div class="p-4">
                                                <h3 class="text-sm font-semibold text-slate-900 truncate">@completed.Title</h3>
                                                <p class="mt-1 text-xs text-slate-500">Completed @FormatDate(completed.CompletedDate)</p>
                                                @if (completed.FinalScore.HasValue)
                                                {
                                                    <span class="mt-2.5 inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700">
                                                        @Math.Round(completed.FinalScore.Value)% final score
                                                    </span>
                                                }
                                            </div>
                                        </a>
                                    }
                                </div>
                                <button type="button" @onclick='() => ScrollCarouselAsync("completed-carousel", -1)' aria-label="Scroll completed courses left"
                                        class="absolute -left-3 top-1/2 -translate-y-1/2 hidden lg:flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 shadow-md hover:bg-slate-50 hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-colors z-10">
                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                                    </svg>
                                </button>
                                <button type="button" @onclick='() => ScrollCarouselAsync("completed-carousel", 1)' aria-label="Scroll completed courses right"
                                        class="absolute -right-3 top-1/2 -translate-y-1/2 hidden lg:flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 shadow-md hover:bg-slate-50 hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-colors z-10">
                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                    </svg>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="card p-6 flex items-center gap-4">
                                <span class="h-10 w-10 rounded-xl bg-emerald-50 text-emerald-500 flex items-center justify-center flex-shrink-0" aria-hidden="true">
                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </span>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-slate-900">No completed courses yet.</p>
                                    <p class="text-xs text-slate-500 mt-0.5">Finish all lessons and pass a final quiz to complete your first course.</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <!-- This Week -->
            <section class="card p-5" aria-labelledby="week-heading">
                <div class="flex items-center justify-between gap-2">
                    <h2 id="week-heading" class="text-base font-semibold text-slate-900">This Week</h2>
                    <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700">
                        @Dashboard.LessonsThisWeek lesson@(Dashboard.LessonsThisWeek == 1 ? "" : "s")
                    </span>
                </div>
                <p class="mt-1 text-xs text-slate-500">Lessons completed over the last 7 days</p>

                <div class="mt-5 flex items-end gap-2 h-32" role="img" aria-label="Lessons completed per day over the last 7 days, total @Dashboard.LessonsThisWeek">
                    @foreach (var day in Dashboard.WeekActivity)
                    {
                        var isToday = day.Date.Date == DateTime.UtcNow.Date;
                        <div class="flex-1 flex flex-col items-center gap-2 h-full min-w-0">
                            <div class="w-full flex-1 flex items-end justify-center" title="@day.LessonsCompleted lesson@(day.LessonsCompleted == 1 ? "" : "s")">
                                <div class="w-full max-w-8 rounded-lg @(day.LessonsCompleted > 0 ? (isToday ? "bg-indigo-600" : "bg-indigo-400") : "bg-slate-100")"
                                     style="height: @(GetBarHeightPx(day.LessonsCompleted, weekMax))px"
                                     aria-hidden="true"></div>
                            </div>
                            <span class="text-[11px] @(isToday ? "font-bold text-slate-700" : "text-slate-400")" aria-hidden="true">@GetDayLetter(day.Date)</span>
                        </div>
                    }
                </div>

                <p class="mt-4 text-xs text-slate-500 border-t border-slate-100 pt-3">
                    @if (Dashboard.LessonsThisWeek > 0)
                    {
                        <span>Nice pace &mdash; keep it going!</span>
                    }
                    else
                    {
                        <span>Complete lessons to see your activity here.</span>
                    }
                </p>
            </section>
        </div>

        <!-- ── 5. Recent Results + Recent Activity ─────────────────────── -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- Recent Quiz Results -->
            <section class="card p-5 sm:p-6 flex flex-col" aria-labelledby="quiz-results-heading">
                <div class="flex items-center justify-between gap-2 mb-4">
                    <h2 id="quiz-results-heading" class="text-base font-semibold text-slate-900">Recent Quiz Results</h2>
                    @if (Dashboard.RecentQuizResults.Any())
                    {
                        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">@Dashboard.RecentQuizResults.Count</span>
                    }
                </div>
                @if (Dashboard.RecentQuizResults.Any())
                {
                    <ul class="space-y-1 -mx-2">
                        @foreach (var result in Dashboard.RecentQuizResults)
                        {
                            <li>
                                <AuthorizeView Policy="Permission:Quiz.Read">
                                    <Authorized>
                                        <a href="/courses/@result.CourseId/quiz/results/@result.AttemptId"
                                           class="flex items-center gap-3 px-2 py-2.5 rounded-xl hover:bg-slate-50 transition-colors">
                                            <span class="h-9 w-9 rounded-lg flex items-center justify-center flex-shrink-0 @(result.Passed ? "bg-emerald-50 text-emerald-600" : "bg-rose-50 text-rose-600")" aria-hidden="true">
                                                @if (result.Passed)
                                                {
                                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                                    </svg>
                                                }
                                            </span>
                                            <span class="flex-1 min-w-0">
                                                <span class="block text-sm font-medium text-slate-900 truncate">@result.QuizTitle</span>
                                                <span class="block text-xs text-slate-500 truncate">@result.CourseTitle &middot; @GetRelativeTime(result.SubmittedAt)</span>
                                            </span>
                                            <span class="flex items-center gap-2 flex-shrink-0">
                                                <span class="text-sm font-bold @(result.Passed ? "text-emerald-700" : "text-rose-700")">@Math.Round(result.Score)%</span>
                                                <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold @(result.Passed ? "bg-emerald-50 text-emerald-700" : "bg-rose-50 text-rose-700")">@(result.Passed ? "Passed" : "Failed")</span>
                                            </span>
                                        </a>
                                    </Authorized>
                                    <NotAuthorized>
                                        <div class="flex items-center gap-3 px-2 py-2.5">
                                            <span class="flex-1 min-w-0">
                                                <span class="block text-sm font-medium text-slate-900 truncate">@result.QuizTitle</span>
                                                <span class="block text-xs text-slate-500 truncate">@result.CourseTitle &middot; @GetRelativeTime(result.SubmittedAt)</span>
                                            </span>
                                            <span class="text-sm font-bold @(result.Passed ? "text-emerald-700" : "text-rose-700")">@Math.Round(result.Score)%</span>
                                        </div>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="flex-1 flex flex-col items-center justify-center py-8 text-center">
                        <div class="h-12 w-12 rounded-full bg-slate-50 text-slate-300 flex items-center justify-center" aria-hidden="true">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                            </svg>
                        </div>
                        <p class="mt-3 text-sm text-slate-500">No quiz attempts yet. Finish a course to unlock its final quiz.</p>
                    </div>
                }
            </section>

            <!-- Recent Learning Activity -->
            <section class="card p-5 sm:p-6 flex flex-col" aria-labelledby="activity-heading">
                <div class="flex items-center justify-between gap-2 mb-4">
                    <h2 id="activity-heading" class="text-base font-semibold text-slate-900">Recent Activity</h2>
                    @if (Dashboard.RecentActivity.Any())
                    {
                        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">@Dashboard.RecentActivity.Count</span>
                    }
                </div>
                @if (Dashboard.RecentActivity.Any())
                {
                    <ol class="relative space-y-4 ml-1 border-l border-slate-200">
                        @foreach (var activity in Dashboard.RecentActivity)
                        {
                            <li class="pl-5 relative">
                                <span class="absolute -left-[9px] top-1 h-4 w-4 rounded-full border-2 border-white @GetActivityDotClass(activity.ActivityType)" aria-hidden="true"></span>
                                <p class="text-sm text-slate-700 leading-snug">
                                    @GetActivityText(activity)
                                </p>
                                <p class="text-xs text-slate-400 mt-0.5">@GetRelativeTime(activity.OccurredAt)</p>
                            </li>
                        }
                    </ol>
                }
                else
                {
                    <div class="flex-1 flex flex-col items-center justify-center py-8 text-center">
                        <div class="h-12 w-12 rounded-full bg-slate-50 text-slate-300 flex items-center justify-center" aria-hidden="true">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <p class="mt-3 text-sm text-slate-500">No recent activity yet. Your enrollments and lesson completions will appear here.</p>
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    private StudentDashboardResponse? Dashboard;
    private bool IsLoading = true;
    private bool HasError = false;
    private string ErrorMessage = string.Empty;
    private string UserDisplayName = string.Empty;
    private string ActiveTab = "inprogress";

    private bool IsInProgressTab => ActiveTab == "inprogress";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        UserDisplayName = authState.User.Identity?.Name ?? string.Empty;

        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        IsLoading = true;
        HasError = false;

        var result = await DashboardClient.GetDashboardSummaryAsync();

        if (result.Success)
        {
            Dashboard = result.Data;

            if (result.Data is { } data && data.CoursesInProgress.Count == 0 && data.CompletedCourses.Any())
            {
                ActiveTab = "completed";
            }
        }
        else
        {
            HasError = true;
            ErrorMessage = result.Error ?? "Unable to load dashboard.";
        }

        IsLoading = false;
    }

    private void SelectTab(string tab)
    {
        ActiveTab = tab;
    }

    private async Task ScrollCarouselAsync(string carouselId, int direction)
    {
        var amount = direction * 560;
        await JS.InvokeVoidAsync("eval", $"var el=document.getElementById('{carouselId}'); if(el) el.scrollBy({{left:{amount}, behavior:'smooth'}});");
    }

    private string GetFirstName()
    {
        if (string.IsNullOrWhiteSpace(UserDisplayName))
        {
            return "there";
        }

        var firstName = UserDisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        return string.IsNullOrWhiteSpace(firstName) ? "there" : firstName;
    }

    private string GetGreeting()
    {
        return DateTime.Now.Hour switch
        {
            < 12 => "Good morning",
            < 18 => "Good afternoon",
            _ => "Good evening"
        };
    }

    private string GetContinueUrl(StudentCourseDashboardItem course)
    {
        if (course.IsFinalQuizAvailable)
        {
            return $"/courses/{course.CourseId}/quiz";
        }

        if (course.NextLessonId.HasValue)
        {
            return $"/courses/{course.CourseId}/lessons/{course.NextLessonId}";
        }

        return $"/courses/{course.CourseId}";
    }

    private string GetImageUrl(string? relativePath)
    {
        if (string.IsNullOrWhiteSpace(relativePath))
        {
            return string.Empty;
        }

        if (relativePath.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            relativePath.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return relativePath;
        }

        var baseUri = Http.BaseAddress?.ToString().TrimEnd('/') ?? string.Empty;
        var cleanPath = relativePath.StartsWith("/") ? relativePath : "/" + relativePath;
        return baseUri + cleanPath;
    }

    private static string GetRelativeTime(DateTime occurredAtUtc)
    {
        var diff = DateTime.UtcNow - occurredAtUtc;

        if (diff.TotalMinutes < 1)
        {
            return "Just now";
        }
        if (diff.TotalMinutes < 60)
        {
            return $"{(int)diff.TotalMinutes}m ago";
        }
        if (diff.TotalHours < 24)
        {
            return $"{(int)diff.TotalHours}h ago";
        }
        if (diff.TotalDays < 7)
        {
            return $"{(int)diff.TotalDays}d ago";
        }

        return occurredAtUtc.ToString("dd-MM-yyyy");
    }

    private static string GetActivityDotClass(string activityType)
    {
        return activityType switch
        {
            "LessonCompleted" => "bg-emerald-500",
            _ => "bg-indigo-500"
        };
    }

    private static string GetActivityText(StudentActivityItem activity)
    {
        return activity.ActivityType switch
        {
            "LessonCompleted" => $"Completed lesson \"{activity.Title}\" in {activity.CourseTitle}",
            _ => $"Enrolled in {activity.CourseTitle}"
        };
    }

    private static string GetCardFooterText(StudentCourseDashboardItem course)
    {
        if (course.IsFinalQuizAvailable && course.LatestQuizAttempt is { Passed: false })
        {
            return "Retake final quiz";
        }

        if (course.IsFinalQuizAvailable)
        {
            return "Final quiz unlocked";
        }

        if (!string.IsNullOrWhiteSpace(course.NextLessonTitle))
        {
            return $"Up next: {course.NextLessonTitle}";
        }

        return "Go to course";
    }

    private int GetWeekMax()
    {
        if (Dashboard == null || Dashboard.WeekActivity.Count == 0)
        {
            return 1;
        }

        return Math.Max(1, Dashboard.WeekActivity.Max(d => d.LessonsCompleted));
    }

    private static int GetBarHeightPx(int value, int max)
    {
        if (value <= 0)
        {
            return 4;
        }

        return Math.Max(6, (int)Math.Round(value * 84.0 / max));
    }

    private static string GetDayLetter(DateTime date)
    {
        var name = date.ToString("ddd");
        return name.Length == 0 ? string.Empty : name.Substring(0, 1).ToUpperInvariant();
    }

    private static string FormatDate(DateTime? date)
    {
        return date?.ToString("dd-MM-yyyy") ?? "\u2014";
    }
}
