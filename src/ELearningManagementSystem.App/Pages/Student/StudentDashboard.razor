@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject StudentDashboardApiClient DashboardClient
@inject NavigationManager NavManager

<PageTitle>My Dashboard</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-900">My Dashboard</h1>
        <p class="mt-2 text-sm text-slate-600">Track your progress and continue learning.</p>
    </div>

    @if (IsLoading)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <SkeletonCard />
            <SkeletonCard />
            <SkeletonCard />
        </div>
    }
    else if (HasError)
    {
        <EmptyState Title="Dashboard Unavailable" Description="@ErrorMessage">
            <Icon>
                <svg class="mx-auto h-12 w-12 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </Icon>
        </EmptyState>
    }
    else if (Dashboard != null)
    {
        @if (Dashboard.ActiveCourses.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var course in Dashboard.ActiveCourses)
                {
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md transition-shadow flex flex-col relative group">
                        <a href="@GetCourseUrl(course)" class="absolute inset-0 z-10" aria-hidden="true" tabindex="-1" style="@(string.IsNullOrEmpty(GetCourseUrl(course)) ? "display:none;" : "")"></a>
                        
                        <div class="aspect-w-16 aspect-h-9 bg-slate-100">
                            @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                            {
                                <img src="@course.ThumbnailUrl" alt="@course.Title" class="object-cover w-full h-full" />
                            }
                            else
                            {
                                <div class="flex items-center justify-center h-full w-full bg-indigo-50 text-indigo-300">
                                    <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                    </svg>
                                </div>
                            }
                        </div>
                        <div class="p-6 flex-1 flex flex-col relative z-20">
                            <h3 class="text-xl font-bold text-slate-900 mb-4 group-hover:text-indigo-600 transition-colors">
                                @if(!string.IsNullOrEmpty(GetCourseUrl(course)))
                                {
                                    <a href="@GetCourseUrl(course)">@course.Title</a>
                                }
                                else
                                {
                                    @course.Title
                                }
                            </h3>
                            
                            <div class="mb-4 pointer-events-none">
                                <div class="flex justify-between text-sm font-medium mb-1">
                                    <span class="text-slate-700">Progress</span>
                                    <span class="text-indigo-600">@course.ProgressPercentage%</span>
                                </div>
                                <div class="w-full bg-slate-100 rounded-full h-2">
                                    <div class="bg-indigo-600 h-2 rounded-full" style="width: @course.ProgressPercentage%"></div>
                                </div>
                                <p class="text-xs text-slate-500 mt-2">@course.CompletedLessons of @course.TotalLessons lessons completed</p>
                            </div>

                            <div class="mt-auto pt-4 flex flex-col gap-3">
                                @if (course.IsFinalQuizAvailable)
                                {
                                    <AuthorizeView Policy="Permission:Quiz.Read">
                                        <Authorized>
                                            <a href="@($"/courses/{course.CourseId}/quiz")" class="w-full text-center px-4 py-2 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition-colors z-20">
                                                Take Final Quiz
                                            </a>
                                        </Authorized>
                                    </AuthorizeView>
                                }
                                else if (course.NextLessonId.HasValue)
                                {
                                    <AuthorizeView Policy="Permission:Lesson.Read">
                                        <Authorized>
                                            <a href="@($"/courses/{course.CourseId}/lessons/{course.NextLessonId}")" class="w-full text-center px-4 py-2 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition-colors z-20">
                                                Continue Learning
                                            </a>
                                        </Authorized>
                                    </AuthorizeView>
                                }
                                else if (course.IsCompleted)
                                {
                                    <button disabled class="w-full text-center px-4 py-2 border border-slate-200 rounded-xl shadow-sm text-sm font-medium text-slate-400 bg-slate-50 cursor-not-allowed z-20">
                                        Course Completed
                                    </button>
                                }
                                else
                                {
                                    <button disabled class="w-full text-center px-4 py-2 border border-slate-200 rounded-xl shadow-sm text-sm font-medium text-slate-400 bg-slate-50 cursor-not-allowed z-20">
                                        Not Available
                                    </button>
                                }

                                <AuthorizeView Policy="Permission:Quiz.Read">
                                    <Authorized>
                                        @if (course.LatestQuizAttempt != null)
                                        {
                                            <div class="text-center p-3 rounded-lg @(course.LatestQuizAttempt.Passed ? "bg-green-50 border border-green-100" : "bg-red-50 border border-red-100")">
                                                <div class="text-xs font-semibold @(course.LatestQuizAttempt.Passed ? "text-green-800" : "text-red-800") mb-1">
                                                    Latest Quiz Result
                                                </div>
                                                <div class="flex items-center justify-center space-x-2">
                                                    <span class="text-lg font-bold @(course.LatestQuizAttempt.Passed ? "text-green-700" : "text-red-700")">
                                                        @course.LatestQuizAttempt.Score%
                                                    </span>
                                                    <span class="text-xs px-2 py-1 rounded-full @(course.LatestQuizAttempt.Passed ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
                                                        @(course.LatestQuizAttempt.Passed ? "Passed" : "Failed")
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <EmptyState Title="No active enrollments" Description="You haven't enrolled in any courses yet. Browse our catalog to get started!">
                <Icon>
                    <svg class="mx-auto h-12 w-12 text-indigo-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                </Icon>
                <ActionTemplate>
                    <AuthorizeView Policy="Permission:Course.Read">
                        <Authorized>
                            <a href="/courses" class="inline-flex items-center px-6 py-3 border border-transparent shadow-sm text-base font-medium rounded-full text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">
                                Browse Courses
                            </a>
                        </Authorized>
                    </AuthorizeView>
                </ActionTemplate>
            </EmptyState>
        }
    }
</div>

@code {
    private StudentDashboardResponse? Dashboard;
    private bool IsLoading = true;
    private bool HasError = false;
    private string ErrorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        HasError = false;

        var result = await DashboardClient.GetDashboardSummaryAsync();
        
        if (result.Success)
        {
            Dashboard = result.Data;
        }
        else
        {
            HasError = true;
            ErrorMessage = result.Error ?? "Unable to load dashboard.";
        }

        IsLoading = false;
    }

    private string GetCourseUrl(StudentCourseDashboardItem course)
    {
        if (course.IsFinalQuizAvailable)
        {
            return $"/courses/{course.CourseId}/quiz";
        }
        else if (course.NextLessonId.HasValue)
        {
            return $"/courses/{course.CourseId}/lessons/{course.NextLessonId}";
        }
        
        return string.Empty;
    }
}
