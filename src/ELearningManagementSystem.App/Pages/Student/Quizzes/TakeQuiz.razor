@page "/courses/{CourseId:int}/quiz"
@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Permission:Quiz.Read")]
@inject QuizAttemptApiClient QuizClient
@inject LessonProgressApiClient LessonProgressClient
@inject LessonApiClient LessonClient
@inject NavigationManager NavManager

<PageTitle>@(Quiz != null ? Quiz.Title : "Final Quiz")</PageTitle>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    @* ── Top Header Navigation & Progress Counter ──────────────────────────── *@
    <div class="flex items-center justify-between mb-6">
        <button @onclick="GoBack"
                class="inline-flex items-center text-sm font-semibold text-slate-500 hover:text-indigo-600 transition-colors group p-2 -ml-2 rounded-xl hover:bg-slate-100">
            <svg class="mr-2 h-5 w-5 text-slate-400 group-hover:text-indigo-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Exit Quiz
        </button>

        @if (Quiz != null && Quiz.Questions != null && Quiz.Questions.Any())
        {
            <div class="flex items-center gap-3">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Completed</span>
                <span class="px-3 py-1 rounded-full text-xs font-extrabold bg-indigo-50 text-indigo-700 ring-1 ring-indigo-600/20">
                    @CompletedCount / @Quiz.Questions.Count
                </span>
            </div>
        }
    </div>

    @* ── Progress Bar (Advances after a question is answered and checked) ── *@
    @if (Quiz != null && Quiz.Questions != null && Quiz.Questions.Any())
    {
        <div class="w-full bg-slate-200 rounded-full h-2.5 mb-8 overflow-hidden">
            <div class="bg-gradient-to-r from-indigo-500 to-purple-600 h-full rounded-full transition-all duration-500 ease-out"
                 style="width: @(ProgressPercentage)%"></div>
        </div>
    }

    @* ── Loading / Friendly Error States ────────────────────────────────────── *@
    @if (IsLoading)
    {
        <SkeletonCard />
    }
    else if (HasError)
    {
        @* ── Quiz Notice Card (Lessons not completed) ── *@
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xl shadow-slate-200/40 overflow-hidden">
            <div class="p-8 sm:p-10 text-center">
                <div class="mx-auto h-14 w-14 bg-amber-50 rounded-2xl flex items-center justify-center mb-6">
                    <svg class="h-8 w-8 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <h2 class="text-2xl font-extrabold text-slate-900 mb-2">Quiz Notice</h2>
                <p class="text-slate-500 text-sm max-w-md mx-auto leading-relaxed">All lessons must be completed before taking the final quiz.</p>

                @if (CourseProgress != null)
                {
                    <div class="mt-8 max-w-sm mx-auto text-left">
                        <div class="flex items-center justify-between text-xs font-bold text-slate-500 mb-2">
                            <span>Progress: @CourseProgress.CompletedCount / @CourseProgress.TotalActiveLessons Lessons Completed</span>
                            <span class="text-indigo-600">@CourseProgress.Percentage%</span>
                        </div>
                        <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden">
                            <div class="bg-gradient-to-r from-indigo-500 to-purple-600 h-full rounded-full transition-all duration-500 ease-out"
                                 style="width: @(CourseProgress.Percentage)%"></div>
                        </div>
                    </div>
                }

                <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">
                    <button @onclick="NavigateToNextIncompleteLesson"
                            class="inline-flex items-center justify-center px-6 py-2.5 rounded-full text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition-all">
                        <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Continue Learning
                    </button>
                    <button @onclick="GoBack"
                            class="inline-flex items-center justify-center px-6 py-2.5 rounded-full text-sm font-semibold text-slate-700 bg-white border border-slate-200 shadow-sm hover:bg-slate-50 transition-all">
                        Return to Course
                    </button>
                </div>
            </div>
        </div>
    }
    else if (Quiz != null && CurrentQuestion != null)
    {
        @* ── Quiz Question Card ────────────────────────────────────────────── *@
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xl shadow-slate-200/40 overflow-hidden transition-all">

            @* Card Header *@
            <div class="px-6 py-5 sm:px-8 sm:py-6 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                <span class="text-xs font-extrabold uppercase tracking-widest text-indigo-600">Question @(CurrentQuestionIndex + 1) of @Quiz.Questions.Count</span>
                <span class="text-xs font-semibold text-slate-400">Select one option</span>
            </div>

            @* Question Prompt *@
            <div class="p-6 sm:p-8">
                <h2 class="text-xl sm:text-2xl font-bold text-slate-900 leading-snug mb-6">
                    @CurrentQuestion.QuestionText
                </h2>

                @* Answer Options *@
                <div class="space-y-3">
                    @for (int i = 0; i < CurrentQuestion.Options.Count; i++)
                    {
                        var option = CurrentQuestion.Options[i];
                        var optionLetter = (char)('A' + i);
                        var isSelected = IsOptionSelected(CurrentQuestion.QuestionId, option.OptionId);

                        <button type="button"
                                @onclick="() => SelectOption(CurrentQuestion.QuestionId, option.OptionId)"
                                disabled="@IsCurrentChecked"
                                class="@GetOptionCardClass(option, isSelected) w-full text-left p-4 sm:p-5 rounded-2xl border-2 transition-all flex items-center justify-between group">
                            
                            <div class="flex items-center gap-4 min-w-0">
                                @* Letter Badge (A, B, C, D) *@
                                <div class="@GetLetterBadgeClass(option, isSelected) w-9 h-9 rounded-xl flex items-center justify-center font-bold text-sm flex-shrink-0 transition-colors">
                                    @optionLetter
                                </div>
                                <span class="@GetOptionTextClass(option, isSelected) text-base leading-snug break-words">
                                    @option.OptionText
                                </span>
                            </div>

                            @* Custom Indicator Icon *@
                            <div class="flex-shrink-0 ml-3">
                                @if (IsCurrentChecked && option.IsCorrect)
                                {
                                    <div class="w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center shadow-sm">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                        </svg>
                                    </div>
                                }
                                else if (IsCurrentChecked && isSelected && !option.IsCorrect)
                                {
                                    <div class="w-6 h-6 rounded-full bg-rose-600 text-white flex items-center justify-center shadow-sm">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                                        </svg>
                                    </div>
                                }
                                else
                                {
                                    <div class="@GetRadioCircleClass(isSelected) w-6 h-6 rounded-full border-2 flex items-center justify-center transition-all">
                                        @if (isSelected)
                                        {
                                            <div class="w-2.5 h-2.5 rounded-full bg-white"></div>
                                        }
                                    </div>
                                }
                            </div>
                        </button>
                    }
                </div>

                @* ── Inline Feedback Banner (Correct vs Wrong) ───────────────────── *@
                @if (IsCurrentChecked)
                {
                    @if (IsSelectedOptionCorrect())
                    {
                        <div class="mt-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200/80 text-emerald-950 flex items-start gap-3 animate-in fade-in zoom-in-95 duration-200">
                            <span class="text-2xl flex-shrink-0">😊</span>
                            <div>
                                <p class="text-base font-extrabold text-emerald-900">Correct Answer</p>
                                <p class="text-xs font-semibold text-emerald-700 mt-0.5">Well done! Click Continue to proceed.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mt-6 p-4 rounded-2xl bg-rose-50 border border-rose-200/80 text-rose-950 flex items-start gap-3 animate-in fade-in zoom-in-95 duration-200">
                            <span class="text-2xl flex-shrink-0">😅</span>
                            <div>
                                <p class="text-base font-extrabold text-rose-900">Ohh wrong answer</p>
                                @if (CorrectOption != null)
                                {
                                    <p class="text-sm font-bold text-rose-800 mt-1">
                                        Correct Answer: <span class="font-extrabold underline">@CorrectOption.OptionText</span>
                                    </p>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            @* ── Footer Control Bar ────────────────────────────────────────── *@
            <div class="px-6 py-4 sm:px-8 border-t border-slate-100 bg-slate-50/70 flex items-center justify-end">
                @* Button: Check vs Continue vs Finish *@
                <div>
                    @if (!IsCurrentChecked)
                    {
                        <button type="button" @onclick="CheckAnswer"
                                disabled="@(!HasSelectedAnswer(CurrentQuestion.QuestionId))"
                                class="inline-flex items-center px-8 py-3 rounded-full text-sm font-extrabold text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-600/20 disabled:opacity-40 disabled:cursor-not-allowed transition-all">
                            Check
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="ContinueNext"
                                disabled="@IsSubmitting"
                                class="inline-flex items-center px-8 py-3 rounded-full text-sm font-extrabold text-white bg-emerald-600 hover:bg-emerald-700 shadow-md shadow-emerald-600/20 transition-all">
                            @if (IsSubmitting)
                            {
                                <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                                </svg>
                                <span>Submitting...</span>
                            }
                            else if (IsLastQuestion)
                            {
                                <span>Finish Quiz</span>
                                <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                </svg>
                            }
                            else
                            {
                                <span>Continue</span>
                                <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                </svg>
                            }
                        </button>
                    }
                </div>
            </div>

        </div>
    }
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    [SupplyParameterFromQuery(Name = "retake")] public bool IsRetake { get; set; }

    private AvailableQuizResponse? Quiz;
    private bool IsLoading = true;
    private bool HasError = false;
    private string ErrorMessage = string.Empty;
    private bool IsSubmitting = false;

    private int CurrentQuestionIndex = 0;
    private int CompletedCount = 0; // Advances only after a question is answered (checked + continued)
    private bool IsCurrentChecked = false;

    // Lesson progress for quiz lock screen
    private CourseProgressResponse? CourseProgress;
    private int? NextIncompleteLessonId;

    // Dictionary: QuestionId -> SelectedOptionId
    private Dictionary<int, int> SelectedAnswers = new();

    private StudentQuizQuestionResponse? CurrentQuestion =>
        (Quiz?.Questions != null && CurrentQuestionIndex >= 0 && CurrentQuestionIndex < Quiz.Questions.Count)
            ? Quiz.Questions[CurrentQuestionIndex]
            : null;

    private StudentQuizOptionResponse? CorrectOption =>
        CurrentQuestion?.Options.FirstOrDefault(o => o.IsCorrect);

    private bool IsLastQuestion =>
        Quiz?.Questions != null && CurrentQuestionIndex == Quiz.Questions.Count - 1;

    // Progress percentage advances ONLY after questions are completed
    private double ProgressPercentage =>
        Quiz?.Questions != null && Quiz.Questions.Count > 0
            ? Math.Round(((double)CompletedCount / Quiz.Questions.Count) * 100, 1)
            : 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadQuiz();
    }

    private async Task LoadQuiz()
    {
        // Students who already attempted this final quiz land directly on their latest result
        if (!IsRetake)
        {
            var history = await QuizClient.GetStudentAttemptHistoryAsync(CourseId);
            if (history.Success && history.Data is { Count: > 0 })
            {
                var latestAttemptId = history.Data.OrderByDescending(a => a.AttemptId).First().AttemptId;
                NavManager.NavigateTo($"/courses/{CourseId}/quiz/results/{latestAttemptId}", replace: true);
                return;
            }
        }

        IsLoading = true;
        HasError = false;
        
        var result = await QuizClient.GetAvailableQuizAsync(CourseId);
        if (result.Success)
        {
            Quiz = result.Data;
            SelectedAnswers.Clear();
            CurrentQuestionIndex = 0;
            CompletedCount = 0;
            IsCurrentChecked = false;
        }
        else
        {
            HasError = true;
            ErrorMessage = "There is no active final quiz available for this course.";

            if (!string.IsNullOrEmpty(result.Error))
            {
                ParseAndFormatError(result.Error);
            }

            // If the error is about incomplete lessons, fetch progress for the lock screen
            if (result.Error != null && result.Error.Contains("CourseNotCompleted"))
            {
                await LoadLessonProgress();
            }
        }
        
        IsLoading = false;
    }

    private async Task LoadLessonProgress()
    {
        try
        {
            // 1. Fetch course lessons in sequential order (by DisplayOrder)
            var lessonList = await LessonClient.GetLessonsAsync(CourseId, pageSize: 1000, isArchived: false);
            var orderedLessons = lessonList?.Items?.OrderBy(l => l.DisplayOrder).ToList();

            if (orderedLessons == null || !orderedLessons.Any())
                return;

            // 2. Fetch per-lesson completion status
            CourseProgress = await LessonProgressClient.GetCourseProgressAsync(CourseId);

            var completedIds = CourseProgress?.Lessons?
                .Where(l => l.Completed)
                .Select(l => l.LessonId)
                .ToHashSet() ?? new HashSet<int>();

            // 3. First unread lesson in sequential order, or first lesson if all complete
            NextIncompleteLessonId = orderedLessons
                .FirstOrDefault(l => !completedIds.Contains(l.LessonId))?.LessonId
                ?? orderedLessons.First().LessonId;
        }
        catch
        {
            // Progress unavailable — still show the notice, just without progress details
        }
    }

    private void SelectOption(int questionId, int optionId)
    {
        if (IsCurrentChecked) return;
        SelectedAnswers[questionId] = optionId;
    }

    private bool IsOptionSelected(int questionId, int optionId) =>
        SelectedAnswers.TryGetValue(questionId, out var selectedId) && selectedId == optionId;

    private bool HasSelectedAnswer(int questionId) =>
        SelectedAnswers.ContainsKey(questionId);

    private bool IsSelectedOptionCorrect()
    {
        if (CurrentQuestion == null) return false;
        if (!SelectedAnswers.TryGetValue(CurrentQuestion.QuestionId, out var selectedId)) return false;
        var opt = CurrentQuestion.Options.FirstOrDefault(o => o.OptionId == selectedId);
        return opt != null && opt.IsCorrect;
    }

    private void CheckAnswer()
    {
        if (CurrentQuestion == null || !HasSelectedAnswer(CurrentQuestion.QuestionId)) return;
        IsCurrentChecked = true;
    }

    private void ContinueNext()
    {
        IsCurrentChecked = false;
        CompletedCount = Math.Min(Quiz?.Questions.Count ?? 0, CompletedCount + 1);
        AdvanceOrSubmit();
    }

    private void AdvanceOrSubmit()
    {
        if (IsLastQuestion)
        {
            _ = SubmitQuiz();
        }
        else
        {
            CurrentQuestionIndex++;
        }
    }

    private async Task SubmitQuiz()
    {
        if (Quiz == null || IsSubmitting) return;

        IsSubmitting = true;

        var request = new SubmitQuizAttemptRequest
        {
            Answers = SelectedAnswers.Select(kvp => new SubmitQuizAnswerRequest
            {
                QuestionId = kvp.Key,
                SelectedOptionId = kvp.Value
            }).ToList()
        };

        var result = await QuizClient.SubmitQuizAttemptAsync(CourseId, request);
        
        if (result.Success && result.Data != null)
        {
            NavManager.NavigateTo($"/courses/{CourseId}/quiz/results/{result.Data.AttemptId}");
        }
        else
        {
            HasError = true;
            ParseAndFormatError(result.Error);
            IsSubmitting = false;
        }
    }

    private void ParseAndFormatError(string? rawError)
    {
        if (string.IsNullOrWhiteSpace(rawError))
        {
            ErrorMessage = "An unexpected error occurred while processing the quiz.";
            return;
        }

        if (rawError.Contains("Answers cannot be empty") || rawError.Contains("ValidationError"))
        {
            ErrorMessage = "No questions were answered. Please answer at least one question to submit your quiz attempt.";
            return;
        }

        try 
        {
            using var doc = System.Text.Json.JsonDocument.Parse(rawError);
            if (doc.RootElement.TryGetProperty("error", out var errorProp))
            {
                var errStr = errorProp.GetString() ?? "";
                ErrorMessage = errStr.Contains(":") ? errStr.Split(':', 2)[1].Trim() : errStr;
                return;
            }
        }
        catch { }

        ErrorMessage = rawError;
    }

    private void GoBack() => NavManager.NavigateTo($"/courses/{CourseId}");

    private void NavigateToNextIncompleteLesson()
    {
        if (NextIncompleteLessonId.HasValue)
            NavManager.NavigateTo($"/courses/{CourseId}/lessons/{NextIncompleteLessonId.Value}");
        else
            GoBack();
    }

    // Dynamic Styling Helpers for Checked/Correct/Wrong states
    private string GetOptionCardClass(StudentQuizOptionResponse option, bool isSelected)
    {
        if (IsCurrentChecked)
        {
            if (option.IsCorrect)
            {
                return "border-emerald-600 bg-emerald-50/80 text-emerald-950 ring-2 ring-emerald-500/30 shadow-md";
            }
            if (isSelected && !option.IsCorrect)
            {
                return "border-rose-600 bg-rose-50/80 text-rose-950 ring-2 ring-rose-500/30 shadow-md";
            }
            return "border-slate-200 bg-slate-50/50 text-slate-400 opacity-60";
        }

        return isSelected
            ? "border-indigo-600 bg-indigo-50/70 text-indigo-950 ring-2 ring-indigo-500/20 shadow-md"
            : "border-slate-200 bg-white hover:border-indigo-300 hover:bg-slate-50 text-slate-700 shadow-sm";
    }

    private string GetLetterBadgeClass(StudentQuizOptionResponse option, bool isSelected)
    {
        if (IsCurrentChecked)
        {
            if (option.IsCorrect) return "bg-emerald-600 text-white shadow-sm";
            if (isSelected && !option.IsCorrect) return "bg-rose-600 text-white shadow-sm";
            return "bg-slate-200 text-slate-400";
        }

        return isSelected
            ? "bg-indigo-600 text-white shadow-sm"
            : "bg-slate-100 text-slate-600 group-hover:bg-indigo-100 group-hover:text-indigo-600";
    }

    private string GetOptionTextClass(StudentQuizOptionResponse option, bool isSelected)
    {
        if (IsCurrentChecked)
        {
            if (option.IsCorrect) return "font-bold text-emerald-950";
            if (isSelected && !option.IsCorrect) return "font-bold text-rose-950 line-through";
            return "font-medium text-slate-400";
        }

        return isSelected ? "text-indigo-950 font-bold" : "text-slate-700 font-semibold";
    }

    private string GetRadioCircleClass(bool isSelected) =>
        isSelected
            ? "border-indigo-600 bg-indigo-600"
            : "border-slate-300 bg-white group-hover:border-indigo-400";
}
