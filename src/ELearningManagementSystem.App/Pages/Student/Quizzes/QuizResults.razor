@page "/courses/{CourseId:int}/quiz/results/{AttemptId:int}"
@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Permission:Quiz.Read")]
@inject QuizAttemptApiClient QuizClient
@inject NavigationManager NavManager

<PageTitle>Quiz Results</PageTitle>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <button @onclick="GoBackToCourse" class="mb-6 inline-flex items-center text-sm font-semibold text-slate-500 hover:text-indigo-600 transition-colors group p-2 -ml-2 rounded-xl hover:bg-slate-100">
        <svg class="mr-2 h-5 w-5 text-slate-400 group-hover:text-indigo-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Course
    </button>

    @if (IsLoading)
    {
        <SkeletonCard />
    }
    else if (HasError || Result == null)
    {
        <EmptyState Title="Results Unavailable" Description="Could not load the quiz results. Please try again.">
            <Icon>
                <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </Icon>
            <ActionTemplate>
                <button @onclick="GoBackToCourse" class="inline-flex items-center px-5 py-2.5 rounded-full text-sm font-semibold text-slate-700 bg-white border border-slate-200 shadow-sm hover:bg-slate-50 transition-all">
                    Return to Course
                </button>
            </ActionTemplate>
        </EmptyState>
    }
    else
    {
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xl shadow-slate-200/40 overflow-hidden transition-all">
            
            @* ── Result Hero Header Banner ─────────────────────────────────────── *@
            <div class="p-8 sm:p-10 text-center text-white relative overflow-hidden @(Result.Passed ? "bg-gradient-to-br from-emerald-600 via-teal-600 to-indigo-700" : "bg-gradient-to-br from-slate-800 via-indigo-950 to-slate-900")">
                <div class="absolute -right-10 -bottom-10 opacity-10 pointer-events-none">
                    <svg class="w-64 h-64 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                </div>

                @if (Result.Passed)
                {
                    <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-2xl bg-white/20 backdrop-blur-md border border-white/30 mb-6 shadow-lg">
                        <svg class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <span class="inline-block px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-widest bg-emerald-400/20 backdrop-blur-md border border-emerald-400/30 text-emerald-100 mb-2">Quiz Passed</span>
                    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-2">Congratulations!</h1>
                    <p class="text-emerald-100 font-medium max-w-md mx-auto">Great job! You have passed the quiz assessment and demonstrated course mastery.</p>
                }
                else
                {
                    <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 mb-6 shadow-lg">
                        <svg class="h-10 w-10 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </div>
                    <span class="inline-block px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-widest bg-amber-400/20 backdrop-blur-md border border-amber-400/30 text-amber-200 mb-2">Keep Learning</span>
                    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-2">Quiz Attempt Completed</h1>
                    <p class="text-slate-300 font-medium max-w-md mx-auto">Review the course materials and try again to improve your score.</p>
                }
            </div>

            @* ── Result Summary Metrics Grid ─────────────────────────────────── *@
            <div class="p-6 sm:p-8">
                
                @* Score Progress Bar Indicator *@
                <div class="mb-8 p-6 rounded-2xl bg-slate-50 border border-slate-100">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Overall Accuracy</span>
                        <span class="text-base font-extrabold text-slate-900">@Math.Round(Result.Score)%</span>
                    </div>
                    <div class="w-full bg-slate-200 rounded-full h-3 overflow-hidden">
                        <div class="@(Result.Passed ? "bg-emerald-600" : "bg-indigo-600") h-full rounded-full transition-all duration-500"
                             style="width: @(Math.Min(100, Math.Max(0, Math.Round(Result.Score))))%"></div>
                    </div>
                </div>

                @* 4 Key Metrics Cards *@
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
                    @* Score % *@
                    <div class="p-4 sm:p-5 rounded-2xl bg-white border border-slate-200 text-center shadow-sm">
                        <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest block mb-1 whitespace-nowrap">Percentage</span>
                        <span class="text-2xl sm:text-3xl font-black text-slate-900">@Math.Round(Result.Score)%</span>
                    </div>

                    @* Correct Count *@
                    <div class="p-4 sm:p-5 rounded-2xl bg-emerald-50/50 border border-emerald-200/60 text-center shadow-sm">
                        <span class="text-[10px] font-extrabold text-emerald-700 uppercase tracking-widest block mb-1 whitespace-nowrap">Correct</span>
                        <span class="text-2xl sm:text-3xl font-black text-emerald-800">@Result.CorrectAnswers</span>
                    </div>

                    @* Wrong / Skipped Count (Neutral Styling) *@
                    <div class="p-4 sm:p-5 rounded-2xl bg-amber-50/40 border border-amber-200/50 text-center shadow-sm">
                        <span class="text-[10px] font-extrabold text-amber-800 uppercase tracking-widest block mb-1 whitespace-nowrap">Wrong</span>
                        <span class="text-2xl sm:text-3xl font-black text-amber-900">@(Result.TotalQuestions - Result.CorrectAnswers)</span>
                    </div>

                    @* Total Questions *@
                    <div class="p-4 sm:p-5 rounded-2xl bg-white border border-slate-200 text-center shadow-sm">
                        <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest block mb-1 whitespace-nowrap">Total Questions</span>
                        <span class="text-2xl sm:text-3xl font-black text-slate-900">@Result.TotalQuestions</span>
                    </div>
                </div>

                <div class="text-center text-xs font-medium text-slate-400 mb-8">
                    Attempt submitted on @Result.SubmittedAt.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt")
                </div>

                @* ── Action Buttons ─────────────────────────────────────────────── *@
                <div class="flex flex-col sm:flex-row justify-center gap-3">
                    <button @onclick="GoBackToCourse"
                            class="inline-flex justify-center items-center px-8 py-3 rounded-full text-sm font-extrabold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-all">
                        Back to Course
                    </button>
                    <button @onclick="RetakeQuiz"
                            class="inline-flex justify-center items-center px-8 py-3 rounded-full text-sm font-extrabold text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-600/20 transition-all">
                        Retake Quiz
                    </button>
                </div>
            </div>

        </div>
    }
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int AttemptId { get; set; }

    private QuizAttemptResultResponse? Result;
    private bool IsLoading = true;
    private bool HasError = false;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        HasError = false;

        var result = await QuizClient.GetAttemptDetailsAsync(AttemptId);
        if (result.Success)
        {
            Result = result.Data;
        }
        else
        {
            HasError = true;
        }

        IsLoading = false;
    }

    private void GoBackToCourse() => NavManager.NavigateTo($"/courses/{CourseId}");
    private void RetakeQuiz() => NavManager.NavigateTo($"/courses/{CourseId}/quiz?retake=true");
}
