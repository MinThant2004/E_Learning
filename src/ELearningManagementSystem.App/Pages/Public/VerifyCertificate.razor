@page "/certificates/verify/{attemptId:int}"
@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.Application.Features.ExamEngine.DTOs
@using ELearningManagementSystem.App.Components.Exams
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject ExamEngineApiClient EngineApiClient
@inject NavigationManager NavManager

<PageTitle>Certificate Verification - EduSphere</PageTitle>

<div class="min-h-screen bg-slate-50 text-slate-800 flex flex-col justify-between py-12 px-4 sm:px-6">
    <div class="max-w-2xl w-full mx-auto space-y-6">

        <!-- Top Header Logo -->
        <div class="text-center space-y-2">
            <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-2xl bg-white border border-slate-200 shadow-2xs">
                <div class="w-7 h-7 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-xs font-black">
                    🎓
                </div>
                <span class="text-sm font-extrabold text-slate-900 tracking-tight">EduSphere Academic Credentials</span>
            </div>
        </div>

        @if (IsLoading)
        {
            <div class="bg-white rounded-3xl border border-slate-200 p-12 text-center space-y-3 shadow-2xs">
                <div class="w-8 h-8 border-3 border-indigo-600 border-t-transparent rounded-full animate-spin mx-auto"></div>
                <p class="text-xs font-semibold text-slate-500">Verifying certificate credentials...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(ErrorMessage) || CertificateData == null)
        {
            <div class="bg-white rounded-3xl border border-rose-200 p-8 sm:p-10 text-center space-y-4 shadow-2xs">
                <div class="w-12 h-12 rounded-2xl bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center mx-auto text-xl font-bold">
                    ✕
                </div>
                <div>
                    <h1 class="text-lg font-extrabold text-slate-900">Invalid or Unverified Certificate</h1>
                    <p class="text-xs text-slate-500 max-w-md mx-auto mt-1 leading-relaxed">
                        The requested certificate ID could not be verified in the EduSphere credential registry. It may be invalid or not yet issued.
                    </p>
                </div>
                <button type="button" @onclick='() => NavManager.NavigateTo("/")'
                        class="px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold rounded-xl transition-all cursor-pointer">
                    Return to Homepage
                </button>
            </div>
        }
        else
        {
            <!-- Verification Card -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 space-y-6 shadow-2xs transition-all">

                <!-- Verified Badge Header -->
                <div class="flex items-center justify-between gap-4 pb-5 border-b border-slate-100">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center text-lg font-black shrink-0">
                            ✓
                        </div>
                        <div>
                            <span class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-600 block">Official Credential</span>
                            <h1 class="text-base sm:text-lg font-extrabold text-slate-900 leading-tight">Certificate Verified</h1>
                        </div>
                    </div>

                    <span class="px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-50 text-emerald-700 border border-emerald-200 shrink-0">
                        Verified Valid
                    </span>
                </div>

                <!-- Credential Metadata Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                    
                    <div class="bg-slate-50/80 border border-slate-200/80 p-3.5 rounded-2xl space-y-1">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Student Name</span>
                        <span class="text-sm font-extrabold text-slate-900 block">@CertificateData.StudentName</span>
                    </div>

                    <div class="bg-slate-50/80 border border-slate-200/80 p-3.5 rounded-2xl space-y-1">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Certificate ID</span>
                        <span class="text-sm font-mono font-extrabold text-indigo-600 block">@CertificateData.VerificationCode</span>
                    </div>

                    <div class="bg-slate-50/80 border border-slate-200/80 p-3.5 rounded-2xl space-y-1 sm:col-span-2">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Course Name</span>
                        <span class="text-sm font-extrabold text-slate-900 block">@CertificateData.CourseTitle</span>
                    </div>

                    <div class="bg-slate-50/80 border border-slate-200/80 p-3.5 rounded-2xl space-y-1">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Certification Exam</span>
                        <span class="text-xs font-bold text-slate-700 block">@CertificateData.ExamTitle</span>
                    </div>

                    <div class="bg-slate-50/80 border border-slate-200/80 p-3.5 rounded-2xl space-y-1">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Achieved Score</span>
                        <span class="text-xs font-extrabold text-emerald-600 block">@CertificateData.Score.ToString("N0")% (Passing Score: @CertificateData.PassingScore%)</span>
                    </div>

                    <div class="bg-slate-50/80 border border-slate-200/80 p-3.5 rounded-2xl space-y-1 sm:col-span-2">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Issue Date</span>
                        <span class="text-xs font-bold text-slate-700 block">@CertificateData.IssuedAt.ToString("dd-MM-yyyy")</span>
                    </div>

                </div>

                <!-- Action Button to View Full Credential -->
                <div class="pt-2 flex items-center justify-between gap-3">
                    <span class="text-[11px] text-slate-400 font-medium">Issued by EduSphere Academic Registry</span>
                    <button type="button" @onclick="() => ShowCertificateModal = true"
                            class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] text-white font-bold rounded-xl text-xs transition-all shadow-2xs cursor-pointer">
                        View Credential
                    </button>
                </div>

            </div>

            <!-- Embedded Credential Modal -->
            <ExamCertificateModal @bind-IsVisible="ShowCertificateModal"
                                  StudentName="@CertificateData.StudentName"
                                  CourseTitle="@CertificateData.CourseTitle"
                                  Score="@CertificateData.Score"
                                  IssueDate="@CertificateData.IssuedAt"
                                  VerificationCode="@CertificateData.VerificationCode"
                                  AttemptId="@CertificateData.AttemptId" />
        }

    </div>

    <!-- Footer -->
    <div class="text-center text-xs text-slate-400 pt-8">
        &copy; @DateTime.UtcNow.Year EduSphere LMS. Public Verification Engine.
    </div>
</div>

@code {
    [Parameter] public int AttemptId { get; set; }

    private PublicCertificateResponse? CertificateData;
    private bool IsLoading = true;
    private string? ErrorMessage;
    private bool ShowCertificateModal = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IsLoading = true;
            CertificateData = await EngineApiClient.GetPublicCertificateAsync(AttemptId);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }
}
