@page "/admin/payments"
@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@using ELearningManagementSystem.App.Components.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Permission:Course.Update")]
@inject ExamPaymentApiClient PaymentApiClient
@inject HttpClient Http

<PageTitle>Pending Payments - Admin - EduSphere</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-3 pb-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Exam Payment Verifications</h1>
            <p class="text-xs font-semibold text-slate-500 mt-1">Review and verify student KPay/AyaPay payment receipts to unlock course exam attempts.</p>
        </div>
    </div>

    <div class="space-y-6">
    <!-- Controls Bar -->
    <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
        <!-- Status Tabs -->
        <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl text-xs font-bold">
            @foreach (var tab in StatusTabs)
            {
                <button @onclick="() => ChangeStatusTab(tab)"
                        class="px-3.5 py-1.5 rounded-lg transition-all cursor-pointer @(SelectedStatus == tab ? "bg-white text-slate-900 shadow-xs" : "text-slate-500 hover:text-slate-700")">
                    @tab
                </button>
            }
        </div>

        <!-- Search Bar -->
        <div class="relative max-w-xs w-full">
            <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text" @bind="SearchTerm" @bind:event="oninput" @onkeyup="HandleSearch" placeholder="Search student, txn ID..."
                   class="w-full pl-9 pr-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:ring-2 focus:ring-indigo-500/20" />
        </div>
    </div>

    <!-- Table -->
    @if (IsLoading)
    {
        <div class="bg-white rounded-2xl border border-slate-200 p-12 flex flex-col items-center justify-center space-y-3">
            <div class="w-8 h-8 border-4 border-indigo-600 border-t-transparent rounded-full animate-spin"></div>
            <span class="text-xs font-semibold text-slate-500">Loading payment verifications...</span>
        </div>
    }
    else if (PagedResult == null || !PagedResult.Items.Any())
    {
        <EmptyState Title="No Payments Found"
                    Description="There are currently no payment requests matching the selected filter." />
    }
    else
    {
        <div class="bg-white rounded-2xl border border-slate-200 shadow-2xs overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-slate-50/7 border-b border-slate-100 text-slate-500 font-bold uppercase tracking-wider">
                            <th class="py-3.5 px-4">Student</th>
                            <th class="py-3.5 px-4">Exam / Course</th>
                            <th class="py-3.5 px-4">Method & Fee</th>
                            <th class="py-3.5 px-4">Transaction ID</th>
                            <th class="py-3.5 px-4">Date</th>
                            <th class="py-3.5 px-4">Status</th>
                            <th class="py-3.5 px-4 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                        @foreach (var payment in PagedResult.Items)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="py-3.5 px-4">
                                    <div class="font-bold text-slate-900">@payment.StudentName</div>
                                    <div class="text-[11px] text-slate-400">@payment.StudentEmail</div>
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="font-bold text-slate-800">@payment.ExamTitle</div>
                                    <div class="text-[11px] text-indigo-600 font-semibold">@payment.CourseTitle</div>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="px-2 py-0.5 rounded bg-indigo-50 text-indigo-700 font-bold text-[11px]">@payment.PaymentMethod</span>
                                    <div class="font-black text-slate-900 mt-0.5">@payment.Amount.ToString("N0") MMK</div>
                                </td>
                                <td class="py-3.5 px-4 font-mono font-bold text-slate-800">
                                    @payment.TransactionId
                                </td>
                                <td class="py-3.5 px-4 text-slate-500 text-[11px]">
                                    @payment.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold border inline-flex items-center gap-1 @GetStatusBadgeClass(payment.Status)">
                                        <span>@payment.Status</span>
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <button @onclick="() => OpenReviewDrawer(payment)"
                                            class="px-3 py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold rounded-lg text-xs transition-all cursor-pointer">
                                        Review Receipt
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="p-4 border-t border-slate-100">
                <Pagination CurrentPage="CurrentPage"
                            TotalPages="PagedResult.TotalPages"
                            TotalCount="PagedResult.TotalCount"
                            PageSize="PageSize"
                            PageChanged="HandlePageChanged" />
            </div>
        </div>
    }
    </div>
</div>

<!-- Admin Review Drawer / Modal -->
@if (IsReviewDrawerOpen && SelectedPayment != null)
{
    <!-- Outer overlay centered with fallback scroll -->
    <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 backdrop-blur-xs p-4 flex items-center justify-center min-h-full">
        
        <!-- Modal Container Card (flex flex-col max-h-[85vh] my-auto) -->
        <div class="relative flex flex-col w-full max-w-xl max-h-[85vh] my-auto bg-white rounded-2xl shadow-2xl overflow-hidden border border-slate-200">

            <!-- Fixed Header (shrink-0 top) -->
            <div class="shrink-0 border-b border-slate-200 px-6 py-4 bg-white flex items-center justify-between z-10">
                <div class="flex items-center gap-3">
                    <div>
                        <h3 class="text-base font-extrabold text-slate-900 leading-tight flex items-center gap-2">
                            Verify Payment Receipt
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border inline-flex items-center @GetStatusBadgeClass(SelectedPayment.Status)">
                                @SelectedPayment.Status
                            </span>
                        </h3>
                        <p class="text-xs font-semibold text-slate-500 truncate max-w-sm">@SelectedPayment.StudentName (@SelectedPayment.StudentEmail)</p>
                    </div>
                </div>
                <button type="button" @onclick="() => IsReviewDrawerOpen = false" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-colors cursor-pointer flex-shrink-0">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Scrollable Content Body (flex-1 min-h-0 max-h-[60vh] overflow-y-auto) -->
            <div class="flex-1 min-h-0 max-h-[60vh] overflow-y-auto px-6 py-5 space-y-4">

                <!-- Reviewed-State Banner (read-only, non-pending) -->
                @if (!_isLatestStatusPending)
                {
                    var isApproved = SelectedPayment.Status == "Approved";
                    <div class="p-3.5 rounded-xl border @(isApproved ? "bg-emerald-50 border-emerald-200" : "bg-rose-50 border-rose-200")">
                        <div class="flex items-center gap-2 text-xs font-bold @(isApproved ? "text-emerald-800" : "text-rose-800")">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                @if (isApproved)
                                {
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                }
                                else
                                {
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                }
                            </svg>
                            <span>Payment @SelectedPayment.Status by @(string.IsNullOrEmpty(SelectedPayment.ReviewedByName) ? "Administrator" : SelectedPayment.ReviewedByName)</span>
                        </div>
                        @if (SelectedPayment.ReviewedAt.HasValue)
                        {
                            <p class="text-[11px] font-semibold mt-1 @(isApproved ? "text-emerald-700/70" : "text-rose-700/70")">
                                Reviewed on @SelectedPayment.ReviewedAt.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                            </p>
                        }
                        @if (!isApproved && !string.IsNullOrEmpty(SelectedPayment.RejectionReason))
                        {
                            <p class="text-[11px] font-medium mt-1.5 text-slate-700 bg-white/70 rounded-lg p-2 border border-rose-100">
                                <span class="font-bold text-rose-800">Reason:</span> @SelectedPayment.RejectionReason
                            </p>
                        }
                    </div>
                }

                <!-- Info Summary Card -->
                <div class="grid grid-cols-2 gap-3 p-3.5 bg-slate-50 border border-slate-100 rounded-xl text-xs">
                    <div class="col-span-2">
                        <span class="text-[10px] font-bold text-slate-400 uppercase block">Course / Exam</span>
                        <span class="font-bold text-slate-900">@SelectedPayment.CourseTitle</span>
                        <span class="text-[11px] text-indigo-600 font-semibold block">@SelectedPayment.ExamTitle</span>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase block">Amount Paid</span>
                        <span class="text-lg font-black text-indigo-600">@SelectedPayment.Amount.ToString("N0") MMK</span>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase block">Provider</span>
                        <span class="px-2 py-0.5 rounded bg-indigo-50 text-indigo-700 font-bold text-[11px]">@SelectedPayment.PaymentMethod</span>
                    </div>
                    <div class="col-span-2">
                        <span class="text-[10px] font-bold text-slate-400 uppercase block">Transaction ID</span>
                        <span class="font-mono font-bold text-slate-800 break-all">@SelectedPayment.TransactionId</span>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase block">Submitted Date</span>
                        <span class="font-bold text-slate-800">@SelectedPayment.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                </div>

                <!-- Screenshot View -->
                <div>
                    <label class="block font-bold text-slate-700 text-xs mb-1.5">Submitted Receipt Image</label>
                    <div class="mx-auto max-h-72 w-full overflow-hidden rounded-xl border border-slate-200 bg-slate-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(SelectedPayment.ScreenshotUrl) && _receiptImageFailed != true)
                        {
                            <div class="relative group max-h-72">
                                <img src="@GetScreenshotUrl(SelectedPayment.ScreenshotUrl)"
                                     alt="Payment receipt screenshot"
                                     class="max-h-72 w-full object-contain rounded-xl"
                                     @onerror="() => _receiptImageFailed = true" />
                                <a href="@GetScreenshotUrl(SelectedPayment.ScreenshotUrl)"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="absolute inset-0 flex items-center justify-center gap-2 bg-slate-900/40 text-white text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity rounded-xl cursor-pointer">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10V3M13 3h-3M13 3h4" />
                                    </svg>
                                    <span>View Full Image</span>
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="max-h-56 min-h-28 flex flex-col items-center justify-center gap-2 p-6 text-center">
                                <svg class="w-8 h-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span class="text-xs font-bold text-slate-500">No receipt image attached</span>
                            </div>
                        }
                    </div>
                    <p class="text-[11px] font-medium text-slate-400 mt-1.5">
                        Submitted via @SelectedPayment.PaymentMethod on @SelectedPayment.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                    </p>
                </div>

                <!-- Rejection Reason Input (if rejecting) -->
                @if (IsRejecting)
                {
                    <div class="space-y-1.5 p-3.5 bg-rose-50 border border-rose-200 rounded-xl">
                        <label class="block font-bold text-rose-800 text-xs">Rejection Reason (Sent to Student)</label>
                        <textarea @bind="RejectionReasonInput" rows="3" placeholder="e.g. Invalid Transaction ID. Screenshot is unreadable."
                                  class="w-full px-3 py-2 bg-white border border-rose-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-rose-500/20"></textarea>
                    </div>
                }

                <!-- Error Banner -->
                @if (!string.IsNullOrEmpty(ActionError))
                {
                    <div class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold">
                        @ActionError
                    </div>
                }
            </div>

            <!-- Fixed Footer (shrink-0 bottom) -->
            <div class="shrink-0 border-t border-slate-200 px-6 py-4 bg-slate-50/80 flex items-center justify-between gap-3 z-10">
                <button type="button" @onclick="() => IsReviewDrawerOpen = false" class="px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-bold rounded-xl text-xs sm:text-sm transition-colors cursor-pointer">
                    Close
                </button>

                @if (_isLatestStatusPending)
                {
                    <div class="flex items-center gap-2">
                        @if (!IsRejecting)
                        {
                            <button type="button" @onclick="() => IsRejecting = true"
                                    class="px-3 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold rounded-xl text-xs transition-all cursor-pointer">
                                Reject Payment
                            </button>
                            <button type="button" @onclick="ApprovePayment" disabled="@IsProcessingAction"
                                    class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs sm:text-sm shadow-sm transition-all flex items-center gap-1.5 cursor-pointer disabled:opacity-50">
                                <span>Approve Payment</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" @onclick="() => IsRejecting = false" class="px-3 py-2 text-slate-500 hover:text-slate-700 font-semibold text-xs">Back</button>
                            <button type="button" @onclick="SubmitRejection" disabled="@IsProcessingAction"
                                    class="px-5 py-2 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-xl text-xs sm:text-sm shadow-sm transition-all flex items-center gap-1.5 cursor-pointer disabled:opacity-50">
                                <span>Confirm Rejection</span>
                            </button>
                        }
                    </div>
                }
            </div>

        </div>
    </div>
}

@code {
    private PagedResult<ExamPaymentResponse>? PagedResult;
    private bool IsLoading = true;

    private int CurrentPage = 1;
    private int PageSize = 10;
    private string SelectedStatus = "Pending";
    private string SearchTerm = string.Empty;

    private ExamPaymentResponse? SelectedPayment;
    private bool IsReviewDrawerOpen = false;
    private bool IsRejecting = false;
    private string RejectionReasonInput = string.Empty;
    private bool IsProcessingAction = false;
    private string? ActionError;
    private bool _receiptImageFailed;
    private bool _isLatestStatusPending => SelectedPayment?.Status == "Pending";

    private readonly string[] StatusTabs = { "Pending", "Approved", "Rejected", "All" };

    protected override async Task OnInitializedAsync()
    {
        await LoadPayments();
    }

    private async Task LoadPayments()
    {
        IsLoading = true;
        try
        {
            PagedResult = await PaymentApiClient.GetAdminPaymentsAsync(CurrentPage, PageSize, SelectedStatus, SearchTerm);
        }
        catch
        {
            // Error handling
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ChangeStatusTab(string status)
    {
        SelectedStatus = status;
        CurrentPage = 1;
        await LoadPayments();
    }

    private async Task HandleSearch()
    {
        CurrentPage = 1;
        await LoadPayments();
    }

    private async Task HandlePageChanged(int page)
    {
        CurrentPage = page;
        await LoadPayments();
    }

    private void OpenReviewDrawer(ExamPaymentResponse payment)
    {
        SelectedPayment = payment;
        IsRejecting = false;
        RejectionReasonInput = string.Empty;
        ActionError = null;
        _receiptImageFailed = false;
        IsReviewDrawerOpen = true;
    }

    private string? GetScreenshotUrl(string? relativeUrl)
    {
        if (string.IsNullOrWhiteSpace(relativeUrl)) return null;
        if (relativeUrl.StartsWith("http://") || relativeUrl.StartsWith("https://") || relativeUrl.StartsWith("data:"))
            return relativeUrl;
        return $"{Http.BaseAddress?.ToString().TrimEnd('/')}{relativeUrl}";
    }

    private async Task ApprovePayment()
    {
        if (SelectedPayment == null) return;
        IsProcessingAction = true;
        ActionError = null;

        try
        {
            var response = await PaymentApiClient.ReviewPaymentAsync(SelectedPayment.ExamPaymentId, approve: true);
            if (response.IsSuccessStatusCode)
            {
                IsReviewDrawerOpen = false;
                await LoadPayments();
            }
            else
            {
                ActionError = await ApiResponseHelper.GetErrorMessageAsync(response);
            }
        }
        catch (Exception ex)
        {
            ActionError = ex.Message;
        }
        finally
        {
            IsProcessingAction = false;
        }
    }

    private async Task SubmitRejection()
    {
        if (SelectedPayment == null) return;
        if (string.IsNullOrWhiteSpace(RejectionReasonInput))
        {
            ActionError = "Please enter a reason for rejecting this payment.";
            return;
        }

        IsProcessingAction = true;
        ActionError = null;

        try
        {
            var response = await PaymentApiClient.ReviewPaymentAsync(SelectedPayment.ExamPaymentId, approve: false, rejectionReason: RejectionReasonInput);
            if (response.IsSuccessStatusCode)
            {
                IsReviewDrawerOpen = false;
                await LoadPayments();
            }
            else
            {
                ActionError = await ApiResponseHelper.GetErrorMessageAsync(response);
            }
        }
        catch (Exception ex)
        {
            ActionError = ex.Message;
        }
        finally
        {
            IsProcessingAction = false;
        }
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Approved" => "bg-emerald-50 text-emerald-700 border-emerald-200",
        "Pending" => "bg-amber-50 text-amber-700 border-amber-200",
        "Rejected" => "bg-rose-50 text-rose-700 border-rose-200",
        _ => "bg-slate-50 text-slate-600 border-slate-200"
    };
}
