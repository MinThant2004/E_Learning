@page "/admin/payment-methods"
@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@using ELearningManagementSystem.Application.Features.PaymentMethods.DTOs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "System Administrator,Administrator,Admin,SuperAdmin")]
@inject PaymentMethodApiClient MethodApiClient
@inject NavigationManager NavManager
@inject HttpClient Http

<PageTitle>Payment Methods Management - EduSphere Admin</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-3 pb-8">

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Payment Methods Configuration</h1>
            <p class="text-xs font-semibold text-slate-500 mt-1">Configure active student payment gateways, account details, and provider logos.</p>
        </div>
        <button @onclick="OpenAddModal"
                class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-xs sm:text-sm shadow-sm transition-all flex items-center justify-center gap-2 cursor-pointer self-start sm:self-auto">
            <span>+ Add Payment Gateway</span>
        </button>
    </div>

    <div class="space-y-6">
    <!-- Alert Banner -->
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center justify-between">
            <span>@ErrorMessage</span>
            <button @onclick="() => ErrorMessage = null" class="text-rose-400 hover:text-rose-600 font-bold">✕</button>
        </div>
    }

    <!-- Payment Methods Grid -->
    @if (IsLoading)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 animate-pulse">
            @for (int i = 0; i < 4; i++)
            {
                <div class="card p-5 space-y-4">
                    <div class="h-10 bg-slate-200 rounded-xl"></div>
                    <div class="h-4 bg-slate-100 rounded w-3/4"></div>
                    <div class="h-4 bg-slate-100 rounded w-1/2"></div>
                </div>
            }
        </div>
    }
    else if (Methods == null || !Methods.Any())
    {
        <EmptyState Title="No Payment Methods Configured" Description="Click 'Add Payment Gateway' to create your first payment option.">
        </EmptyState>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
            @foreach (var m in Methods)
            {
                <div class="card p-5 space-y-4 flex flex-col justify-between border-2 transition-all @(m.IsActive ? "border-indigo-100 hover:border-indigo-300" : "border-slate-200 opacity-60 bg-slate-50")">
                    <div class="space-y-3">
                        <!-- Provider Logo Header -->
                        <div class="flex items-center justify-between gap-3 pb-3 border-b border-slate-100">
                            <div class="h-10 w-28 flex items-center justify-start overflow-hidden">
                                @if (!string.IsNullOrEmpty(m.LogoUrl) && !FailedLogoIds.Contains(m.PaymentMethodId))
                                {
                                    <img src="@GetAssetUrl(m.LogoUrl)" alt="@m.Name" @onerror="() => MarkLogoFailed(m.PaymentMethodId)"
                                         class="max-h-10 min-w-8 w-auto object-contain" />
                                    <span class="font-extrabold text-slate-800 text-sm sr-only">@m.Name</span>
                                }
                                else
                                {
                                    <span class="font-extrabold text-slate-800 text-sm">@m.Name</span>
                                }
                            </div>

                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold border @(m.IsActive ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-slate-100 text-slate-500 border-slate-200")">
                                @(m.IsActive ? "Active" : "Disabled")
                            </span>
                        </div>

                        <!-- Account Info -->
                        <div class="space-y-1">
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Transfer Account</span>
                            <p class="text-sm font-black text-slate-900 tracking-wide">@m.AccountNumber</p>
                            <p class="text-xs text-slate-500 font-semibold">@m.AccountName</p>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
                        <button @onclick="() => ToggleActiveStatus(m)"
                                class="text-xs font-bold px-3 py-1.5 rounded-xl border transition-colors cursor-pointer @(m.IsActive ? "bg-amber-50 text-amber-700 border-amber-200 hover:bg-amber-100" : "bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100")">
                            @(m.IsActive ? "Disable" : "Enable")
                        </button>

                        <button @onclick="() => OpenEditModal(m)"
                                class="text-xs font-bold px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors cursor-pointer">
                            Edit Gateway
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    </div>
</div>

<!-- Edit / Create Modal (Clean Desktop Image Upload, No QR Code, Auto-generated Code) -->
@if (ShowModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs p-4 flex items-center justify-center min-h-full">
        <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-6 space-y-5 my-auto border border-slate-100">
            
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <h3 class="text-base font-extrabold text-slate-900">@(EditingId.HasValue ? "Edit Payment Gateway" : "Add Payment Gateway")</h3>
                <button @onclick="CloseModal" class="text-slate-400 hover:text-slate-600 font-bold cursor-pointer">✕</button>
            </div>

            <div class="space-y-4 text-xs">
                <!-- Payment Method Name -->
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Payment Method Name</label>
                    <input type="text" @bind="ModalName" placeholder="e.g. KBZ Pay, AYA Pay, Wave Pay"
                           class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-900" />
                </div>

                <!-- Account Holder Name -->
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Account Holder Name</label>
                    <input type="text" @bind="ModalAccountName" placeholder="e.g. EduSphere LMS Co., Ltd."
                           class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl font-medium" />
                </div>

                <!-- Account Number / Phone -->
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Account Number / Phone</label>
                    <input type="text" @bind="ModalAccountNumber" placeholder="e.g. 09-789-012-345"
                           class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl font-mono font-bold text-slate-900" />
                </div>

                <!-- DESKTOP LOGO IMAGE UPLOAD -->
                <div class="p-4 bg-slate-50 border border-slate-200 rounded-2xl space-y-3">
                    <label class="block font-extrabold text-slate-800">Provider Logo Image (Upload from Desktop)</label>
                    
                    <div class="flex items-center gap-4">
                        <InputFile OnChange="HandleLogoFileSelected" accept=".jpg,.jpeg,.png,.webp,.svg"
                                   class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer" />
                    </div>

                    @if (IsUploadingLogo)
                    {
                        <p class="text-[11px] font-semibold text-indigo-600 animate-pulse">Uploading desktop logo image...</p>
                    }
                    @if (!string.IsNullOrEmpty(ModalLogoUrl))
                    {
                        <div class="flex items-center gap-3 pt-1">
                            <span class="text-[10px] font-bold text-slate-400 uppercase">Logo Preview:</span>
                            <div class="h-14 w-28 bg-white border border-slate-200 rounded-xl p-2 flex items-center justify-center overflow-hidden">
                                <img src="@GetAssetUrl(ModalLogoUrl)" alt="Logo Preview" class="max-h-10 min-w-8 w-auto object-contain" />
                            </div>
                        </div>
                    }
                </div>

                <!-- Active Toggle -->
                <div class="flex items-center gap-2 pt-2">
                    <input type="checkbox" id="isActiveCheck" @bind="ModalIsActive" class="w-4 h-4 text-indigo-600 rounded cursor-pointer" />
                    <label for="isActiveCheck" class="font-bold text-slate-700 cursor-pointer">Active & Visible to Students</label>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                <button @onclick="CloseModal" class="px-4 py-2 bg-slate-100 text-slate-700 font-bold rounded-xl text-xs cursor-pointer">Cancel</button>
                <button @onclick="SavePaymentMethod" disabled="@(IsSaving || IsUploadingLogo)"
                        class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-xs shadow-md transition-all cursor-pointer disabled:opacity-50">
                    @(IsSaving ? "Saving..." : "Save Gateway")
                </button>
            </div>

        </div>
    </div>
}

@code {
    private List<PaymentMethodResponse>? Methods;
    private bool IsLoading = true;
    private string? ErrorMessage;
    private HashSet<int> FailedLogoIds { get; set; } = new HashSet<int>();

    private string GetAssetUrl(string? url) =>
        string.IsNullOrEmpty(url) ? string.Empty : $"{Http.BaseAddress?.ToString().TrimEnd('/')}{url}";

    private void MarkLogoFailed(int id) => FailedLogoIds.Add(id);

    private bool ShowModal = false;
    private int? EditingId;
    private string ModalName = string.Empty;
    private string ModalAccountName = string.Empty;
    private string ModalAccountNumber = string.Empty;
    private string? ModalLogoUrl;
    private bool ModalIsActive = true;
    
    private bool IsSaving = false;
    private bool IsUploadingLogo = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadMethods();
    }

    private async Task LoadMethods()
    {
        IsLoading = true;
        try
        {
            Methods = await MethodApiClient.GetAllPaymentMethodsAdminAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenAddModal()
    {
        EditingId = null;
        ModalName = string.Empty;
        ModalAccountName = "EduSphere LMS";
        ModalAccountNumber = string.Empty;
        ModalLogoUrl = null;
        ModalIsActive = true;
        ShowModal = true;
    }

    private void OpenEditModal(PaymentMethodResponse m)
    {
        EditingId = m.PaymentMethodId;
        ModalName = m.Name;
        ModalAccountName = m.AccountName;
        ModalAccountNumber = m.AccountNumber;
        ModalLogoUrl = m.LogoUrl;
        ModalIsActive = m.IsActive;
        ShowModal = true;
    }

    private void CloseModal() => ShowModal = false;

    private async Task HandleLogoFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            IsUploadingLogo = true;
            ErrorMessage = null;
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var uploadedUrl = await MethodApiClient.UploadPaymentAssetAsync(stream, file.Name);
            if (!string.IsNullOrEmpty(uploadedUrl))
            {
                ModalLogoUrl = uploadedUrl;
            }
            else
            {
                ErrorMessage = "Failed to upload logo image from desktop.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Logo upload error: {ex.Message}";
        }
        finally
        {
            IsUploadingLogo = false;
        }
    }

    private async Task SavePaymentMethod()
    {
        if (string.IsNullOrWhiteSpace(ModalName) || string.IsNullOrWhiteSpace(ModalAccountNumber))
        {
            ErrorMessage = "Please fill in all required fields.";
            return;
        }

        IsSaving = true;
        try
        {
            var generatedCode = ModalName.Replace(" ", "").ToUpper();

            if (EditingId.HasValue)
            {
                await MethodApiClient.UpdatePaymentMethodAsync(EditingId.Value, new UpdatePaymentMethodRequest
                {
                    Name = ModalName,
                    AccountName = ModalAccountName,
                    AccountNumber = ModalAccountNumber,
                    LogoUrl = ModalLogoUrl,
                    IsActive = ModalIsActive,
                    DisplayOrder = 1
                });
            }
            else
            {
                await MethodApiClient.CreatePaymentMethodAsync(new CreatePaymentMethodRequest
                {
                    Code = generatedCode,
                    Name = ModalName,
                    AccountName = ModalAccountName,
                    AccountNumber = ModalAccountNumber,
                    LogoUrl = ModalLogoUrl,
                    IsActive = ModalIsActive,
                    DisplayOrder = 1
                });
            }

            ShowModal = false;
            await LoadMethods();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task ToggleActiveStatus(PaymentMethodResponse m)
    {
        try
        {
            await MethodApiClient.UpdatePaymentMethodAsync(m.PaymentMethodId, new UpdatePaymentMethodRequest
            {
                Name = m.Name,
                AccountName = m.AccountName,
                AccountNumber = m.AccountNumber,
                LogoUrl = m.LogoUrl,
                IsActive = !m.IsActive,
                DisplayOrder = m.DisplayOrder
            });
            await LoadMethods();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }
}
