@page "/admin/courses/{CourseId:int}/edit"

@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Permission:Course.Update")]
@inject CourseApiClient CourseClient
@inject CategoryApiClient CategoryClient
@inject HttpClient Http
@inject NavigationManager NavManager

<PageTitle>Edit Course</PageTitle>

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 sm:p-8 space-y-6">
        <div>
            <a href="/admin/courses" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-indigo-600 transition mb-2">← Back to Courses</a>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Edit Course</h1>
            <p class="text-xs font-semibold text-slate-500 mt-1">Manage course content, category classification, and thumbnail asset.</p>
        </div>
        <div class="border-b border-slate-100 pt-3"></div>

    @if (ErrorMessage != null)
    {
        <div class="rounded-xl bg-red-50 p-4 border border-red-200 shadow-sm animate-in fade-in slide-in-from-top-4 duration-300">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">Error</h3>
                    <div class="mt-2 text-sm text-red-700">
                        <p>@ErrorMessage</p>
                    </div>
                </div>
                <div class="ml-auto pl-3">
                    <div class="-mx-1.5 -my-1.5">
                        <button @onclick="() => ErrorMessage = null" type="button" class="inline-flex rounded-md bg-red-50 p-1.5 text-red-500 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-600 focus:ring-offset-2 focus:ring-offset-red-50">
                            <span class="sr-only">Dismiss</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (IsPageLoading)
    {
        <SkeletonCard />
    }
    else if (HasLoadError)
    {
        <EmptyState Title="Course Unavailable" Description="Could not load the course details. It may have been archived or removed.">
            <Icon>
                <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </Icon>
            <ActionTemplate>
                <button @onclick="GoBack" class="inline-flex items-center justify-center px-5 py-2.5 rounded-full text-sm font-semibold text-slate-700 bg-white border border-slate-200 shadow-sm hover:bg-slate-50 transition-all">
                    Return to Courses
                </button>
            </ActionTemplate>
        </EmptyState>
    }
    else
    {
            <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                    <div class="sm:col-span-6">
                        <label for="title" class="block text-sm font-bold text-slate-700 mb-2">Course Title <span class="text-rose-500">*</span></label>
                        <input type="text" id="title" maxlength="200" @bind="Title" class="w-full text-sm rounded-xl border border-slate-200 px-4 py-2.5 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition" placeholder="e.g. Introduction to Blazor" />
                    </div>
                    <div class="sm:col-span-6">
                        <label for="description" class="block text-sm font-bold text-slate-700 mb-2">Description</label>
                        <textarea id="description" rows="4" @bind="Description" class="w-full text-sm rounded-xl border border-slate-200 px-4 py-2.5 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition" placeholder="Briefly describe what this course covers..."></textarea>
                    </div>
                    <div class="sm:col-span-3">
                        <label for="categoryId" class="block text-sm font-bold text-slate-700 mb-2">Category <span class="text-rose-500">*</span></label>
                        <select id="categoryId" value="@CategoryId" @onchange="OnCategoryChanged" class="w-full text-sm rounded-xl border border-slate-200 px-4 py-2.5 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition">
                            <option value="0">Select a category</option>
                            @foreach (var category in Categories)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        </select>
                    </div>

                    <!-- File Upload Input -->
                    <div class="sm:col-span-6">
                        <label class="block text-sm font-bold text-slate-700 mb-2">Course Thumbnail</label>
                        <div class="flex flex-col sm:flex-row gap-6 p-4 bg-slate-50/50 rounded-2xl border border-slate-200">

                            <!-- Image Preview Card -->
                            <div class="flex-shrink-0 flex flex-col items-start">
                                @if (!string.IsNullOrEmpty(ThumbnailPreviewUrl))
                                {
                                    <div class="relative w-56 rounded-xl overflow-hidden border border-slate-200 shadow-sm">
                                        <img src="@ThumbnailPreviewUrl" class="h-36 w-56 object-cover" alt="Selected course thumbnail preview" />
                                        <span class="absolute top-2 left-2 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-indigo-600 text-white shadow-sm">New</span>
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(ExistingThumbnailUrl))
                                {
                                    <div class="relative w-56 rounded-xl overflow-hidden border border-slate-200 shadow-sm">
                                        <img src="@($"{Http.BaseAddress?.ToString().TrimEnd('/')}{ExistingThumbnailUrl}")" class="h-36 w-56 object-cover" alt="Current course thumbnail" />
                                        <span class="absolute top-2 left-2 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-slate-900/70 text-white">Current</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="w-56 h-36 rounded-xl bg-slate-50 border border-dashed border-slate-200 flex items-center justify-center text-slate-400 font-semibold text-sm">
                                        No Image
                                    </div>
                                }
                            </div>

                            <!-- File Pick Controls -->
                            <div class="flex flex-col flex-grow">
                                <label class="border-2 border-dashed border-slate-200 hover:border-indigo-400 bg-slate-50/50 rounded-xl p-6 flex flex-col items-center justify-center cursor-pointer transition">
                                    <svg class="w-8 h-8 text-indigo-500 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                                    </svg>
                                    <span class="text-sm font-semibold text-indigo-600">Choose File</span>
                                    <span class="mt-1 text-xs text-slate-500">JPG, JPEG, PNG, WebP (Max 5 MB)</span>
                                    <InputFile OnChange="HandleFileSelected" accept=".jpg,.jpeg,.png,.webp" class="sr-only" />
                                </label>
                                @if (!string.IsNullOrEmpty(UploadedFileName))
                                {
                                    <span class="mt-2 max-w-[240px] truncate text-xs font-medium text-slate-600" title="@UploadedFileName">@UploadedFileName</span>
                                }

                                @if (!string.IsNullOrEmpty(ThumbnailPreviewUrl) || !string.IsNullOrEmpty(ExistingThumbnailUrl))
                                {
                                    <button type="button" @onclick="RemoveImage" class="inline-flex items-center justify-center text-sm text-red-600 hover:text-red-800 font-medium transition-colors mt-3">
                                        <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                        Remove Image
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" @onclick="GoBack" class="px-5 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-200/60 rounded-xl transition">Cancel</button>
                <button type="button" @onclick="UpdateCourse" disabled="@IsSaving" class="px-6 py-2 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-sm transition disabled:opacity-70">
                    @if (IsSaving)
                    {
                        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int CourseId { get; set; }

    private List<CategoryResponse> Categories = new();
    private bool IsPageLoading = true;
    private bool HasLoadError = false;
    private bool IsSaving = false;
    private string? ErrorMessage;

    // Form State
    private string Title = string.Empty;
    private string? Description;
    private int CategoryId;

    // Thumbnail State
    private string? ThumbnailPreviewUrl;
    private string? ExistingThumbnailUrl;
    private byte[]? UploadedFileBytes;
    private string? UploadedFileName;
    private string? UploadedFileMimeType;
    private bool ShouldRemoveThumbnail = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var courseTask = CourseClient.GetCourseAsync(CourseId);
            var categoriesTask = CategoryClient.GetCategoriesAsync();
            await Task.WhenAll(courseTask, categoriesTask);

            var course = courseTask.Result;
            if (course == null)
            {
                HasLoadError = true;
                return;
            }

            Title = course.Title;
            Description = course.Description;
            CategoryId = course.CategoryId;
            ExistingThumbnailUrl = course.ThumbnailUrl;

            if (categoriesTask.Result != null)
            {
                Categories = categoriesTask.Result.Items.ToList();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to load course details. " + ex.Message;
            HasLoadError = true;
        }
        finally
        {
            IsPageLoading = false;
        }
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        CategoryId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        var file = e.File;
        if (file == null) return;

        // Size check (5MB)
        if (file.Size > 5 * 1024 * 1024)
        {
            ErrorMessage = "Image file size must be less than 5 MB.";
            return;
        }

        // Extension check
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowed = new[] { ".jpg", ".jpeg", ".png", ".webp" };
        if (!allowed.Contains(extension))
        {
            ErrorMessage = "Only .jpg, .jpeg, .png, and .webp images are allowed.";
            return;
        }

        // Content type check
        var allowedMimes = new[] { "image/jpeg", "image/png", "image/webp" };
        if (!allowedMimes.Contains(file.ContentType.ToLowerInvariant()))
        {
            ErrorMessage = "Only JPEG, PNG, and WebP images are allowed.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(5 * 1024 * 1024);
            var buffer = new byte[file.Size];
            await stream.ReadExactlyAsync(buffer, 0, buffer.Length);

            UploadedFileBytes = buffer;
            UploadedFileName = file.Name;
            UploadedFileMimeType = file.ContentType;
            ShouldRemoveThumbnail = false;

            // Preview local file in browser immediately
            ThumbnailPreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error reading image file: " + ex.Message;
        }
    }

    private void RemoveImage()
    {
        UploadedFileBytes = null;
        UploadedFileName = null;
        UploadedFileMimeType = null;
        ThumbnailPreviewUrl = null;
        ShouldRemoveThumbnail = true;
        ExistingThumbnailUrl = null;
    }

    private async Task UpdateCourse()
    {
        if (string.IsNullOrWhiteSpace(Title))
        {
            ErrorMessage = "Title is required.";
            return;
        }

        if (CategoryId <= 0)
        {
            ErrorMessage = "Please select a category.";
            return;
        }

        IsSaving = true;
        ErrorMessage = null;
        try
        {
            var updateRequest = new UpdateCourseRequest
            {
                Title = Title,
                Description = Description,
                CategoryId = CategoryId,
                ThumbnailBytes = UploadedFileBytes,
                ThumbnailFileName = UploadedFileName,
                ThumbnailMimeType = UploadedFileMimeType,
                RemoveThumbnail = ShouldRemoveThumbnail
            };

            var response = await CourseClient.UpdateCourseAsync(CourseId, updateRequest);
            if (response.IsSuccessStatusCode)
            {
                NavManager.NavigateTo("/admin/courses");
            }
            else
            {
                ErrorMessage = await ApiResponseHelper.GetErrorMessageAsync(response);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error updating course: " + ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void GoBack() => NavManager.NavigateTo("/admin/courses");
}
