@page "/admin/courses"

@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Permission:Course.Read")]
@inject CourseApiClient CourseClient
@inject CategoryApiClient CategoryClient
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Manage Courses</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <PageHeader Title="Manage Courses" Description="A list of all courses in the system including their status and details.">
        <ActionTemplate>
            <AuthorizeView Policy="Permission:Course.Create">
                <Authorized>
                    <button @onclick="ShowCreateForm" type="button" disabled="@(IsLoading || IsSaving || IsDeleting)" class="inline-flex items-center justify-center rounded-full border border-transparent bg-indigo-600 px-6 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors w-full sm:w-auto disabled:opacity-50">
                        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Add Course
                    </button>
                </Authorized>
            </AuthorizeView>
        </ActionTemplate>
    </PageHeader>

    @if (ErrorMessage != null)
    {
        <div class="mb-8 rounded-xl bg-red-50 p-4 border border-red-200 shadow-sm animate-in fade-in slide-in-from-top-4 duration-300">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">Error</h3>
                    <div class="mt-2 text-sm text-red-700">
                        <p>@ErrorMessage</p>
                    </div>
                </div>
                <div class="ml-auto pl-3">
                    <div class="-mx-1.5 -my-1.5">
                        <button @onclick="() => ErrorMessage = null" type="button" class="inline-flex rounded-md bg-red-50 p-1.5 text-red-500 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-600 focus:ring-offset-2 focus:ring-offset-red-50">
                            <span class="sr-only">Dismiss</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (IsFormVisible)
    {
        <div class="bg-white shadow-lg sm:rounded-2xl border border-slate-200 mb-8 overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-300">
            <div class="bg-slate-50 px-6 py-4 border-b border-slate-200">
                <h3 class="text-lg leading-6 font-semibold text-slate-900">@(EditingCourseId.HasValue ? "Edit Course" : "Create New Course")</h3>
            </div>
            <div class="px-6 py-6 sm:p-8">
                <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                    <div class="sm:col-span-6">
                        <label for="title" class="block text-sm font-medium text-slate-700">Course Title <span class="text-red-500">*</span></label>
                        <div class="mt-1">
                            <input type="text" id="title" @bind="CurrentCourse.Title" class="block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-4 py-3 transition-colors" placeholder="e.g. Introduction to Blazor" />
                        </div>
                    </div>
                    <div class="sm:col-span-6">
                        <label for="description" class="block text-sm font-medium text-slate-700">Description</label>
                        <div class="mt-1">
                            <textarea id="description" rows="4" @bind="CurrentCourse.Description" class="block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-4 py-3 transition-colors" placeholder="Briefly describe what this course covers..."></textarea>
                        </div>
                    </div>
                    <div class="sm:col-span-3">
                        <label for="categoryId" class="block text-sm font-medium text-slate-700 font-semibold mb-1">Category <span class="text-red-500">*</span></label>
                        <div class="mt-1 relative">
                            @if (IsCategoriesLoading)
                            {
                                <div class="flex items-center space-x-2 text-sm text-slate-500 py-3">
                                    <svg class="animate-spin h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                                    </svg>
                                    <span>Loading categories...</span>
                                </div>
                            }
                            else if (CategoryErrorMessage != null)
                            {
                                <div class="text-sm text-red-600 py-3">
                                    @CategoryErrorMessage
                                </div>
                            }
                            else
                            {
                                <select id="categoryId" @bind="CurrentCourse.CategoryId" class="block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-4 py-3 transition-colors bg-white">
                                    <option value="0">Select a category</option>
                                    @foreach (var category in Categories)
                                    {
                                        <option value="@category.CategoryId">@category.CategoryName</option>
                                    }
                                </select>
                            }
                        </div>
                    </div>

                    <!-- File Upload Input -->
                    <div class="sm:col-span-6">
                        <label class="block text-sm font-medium text-slate-700 font-semibold mb-1">Course Thumbnail</label>
                        <div class="mt-1 flex items-center space-x-6">
                            <div class="flex-shrink-0">
                                @if (!string.IsNullOrEmpty(ThumbnailPreviewUrl))
                                {
                                    <img src="@ThumbnailPreviewUrl" class="h-16 w-24 object-cover rounded-xl border border-slate-200 shadow-sm" />
                                }
                                else if (!string.IsNullOrEmpty(ExistingThumbnailUrl))
                                {
                                    <img src="@($"{Http.BaseAddress?.ToString().TrimEnd('/')}{ExistingThumbnailUrl}")" class="h-16 w-24 object-cover rounded-xl border border-slate-200 shadow-sm" />
                                }
                                else
                                {
                                    <div class="h-16 w-24 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400 font-semibold text-xs">
                                        No Image
                                    </div>
                                }
                            </div>
                            <div class="flex flex-col space-y-2">
                                <InputFile OnChange="HandleFileSelected" accept=".jpg,.jpeg,.png,.webp" class="text-sm text-slate-600 file:mr-4 file:py-2.5 file:px-5 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 transition-colors cursor-pointer" />
                                <span class="text-xs text-slate-500">Allowed formats: JPG, PNG, WebP. Max size: 5 MB.</span>
                                
                                @if (!string.IsNullOrEmpty(ThumbnailPreviewUrl) || !string.IsNullOrEmpty(ExistingThumbnailUrl))
                                {
                                    <button type="button" @onclick="RemoveImage" class="inline-flex items-center text-xs text-red-600 hover:text-red-800 font-medium transition-colors">
                                        <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                        Remove Image
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-slate-50 px-6 py-4 border-t border-slate-200 flex justify-end space-x-3">
                <button type="button" @onclick="HideForm" class="rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors">Cancel</button>
                <button type="button" @onclick="SaveCourse" disabled="@IsSaving" class="inline-flex justify-center rounded-full border border-transparent bg-indigo-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:opacity-70 transition-colors">
                    @if (IsSaving)
                    {
                        <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Course</span>
                    }
                </button>
            </div>
        </div>
    }

    <div class="bg-white shadow-sm ring-1 ring-slate-200 sm:rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th scope="col" class="py-4 pl-4 pr-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider sm:pl-6 w-16">No.</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Title</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider w-48">Category</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider w-48">Image</th>
                        <th scope="col" class="relative py-4 pl-3 pr-4 sm:pr-6 w-32">
                            <span class="sr-only">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12">
                                <div class="flex justify-center">
                                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (Courses == null || !Courses.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-3 py-8">
                                <EmptyState Title="No courses found" Description="Get started by creating a new course.">
                                    <Icon>
                                        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                        </svg>
                                    </Icon>
                                </EmptyState>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (int i = 0; i < Courses.Count; i++)
                        {
                            var course = Courses[i];
                            var rowNum = (CurrentPage - 1) * PageSize + i + 1;
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-slate-900 sm:pl-6">@rowNum</td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-900 font-semibold">
                                    @course.Title
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-100">
                                        @(string.IsNullOrEmpty(course.CategoryName) ? GetCategoryName(course.CategoryId) : course.CategoryName)
                                    </span>
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">
                                    @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                    {
                                        <img src="@($"{Http.BaseAddress?.ToString().TrimEnd('/')}{course.ThumbnailUrl}")" class="h-10 w-16 object-cover rounded-lg border border-slate-200 shadow-sm" />
                                    }
                                    else
                                    {
                                        <div class="h-10 w-16 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400 font-semibold text-[10px] select-none">
                                            No Image
                                        </div>
                                    }
                                </td>
                                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                    <div class="flex items-center justify-end space-x-3">
                                        <AuthorizeView Policy="Permission:Course.Update">
                                            <Authorized>
                                                <button @onclick="() => ShowEditForm(course)" disabled="@(IsSaving || IsDeleting)" class="text-indigo-600 hover:text-indigo-900 transition-colors p-1 rounded hover:bg-indigo-50 disabled:opacity-50" title="Edit">
                                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                    </svg>
                                                    <span class="sr-only">Edit</span>
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                        <AuthorizeView Policy="Permission:Course.Delete">
                                            <Authorized>
                                                <button @onclick="() => SoftDeleteCourse(course.CourseId)" disabled="@(IsSaving || IsDeleting)" class="text-red-500 hover:text-red-700 transition-colors p-1 rounded hover:bg-red-50 disabled:opacity-50" title="Delete">
                                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                    <span class="sr-only">Delete</span>
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<CourseSummaryResponse> Courses = new();
    private List<CategoryResponse> Categories = new();
    
    private bool IsLoading = true;
    private bool IsCategoriesLoading = true;
    private string? ErrorMessage;
    private string? CategoryErrorMessage;
    
    private bool IsFormVisible = false;
    private bool IsSaving = false;
    private bool IsDeleting = false;
    
    private int? EditingCourseId;
    private CreateCourseRequest CurrentCourse = new();

    private int CurrentPage = 1;
    private int PageSize = 10;

    // File Upload Local State
    private string? ThumbnailPreviewUrl;
    private string? ExistingThumbnailUrl;
    private byte[]? UploadedFileBytes;
    private string? UploadedFileName;
    private string? UploadedFileMimeType;
    private bool ShouldRemoveThumbnail = false;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadCourses(), LoadCategories());
    }

    private async Task LoadCourses()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var result = await CourseClient.GetCoursesAsync(includeDeleted: false);
            if (result != null)
            {
                Courses = result.Items.ToList();
                CurrentPage = result.Page;
                PageSize = result.PageSize;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to load courses. " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadCategories()
    {
        IsCategoriesLoading = true;
        CategoryErrorMessage = null;
        try
        {
            var result = await CategoryClient.GetCategoriesAsync();
            if (result != null)
            {
                Categories = result.ToList();
            }
        }
        catch (Exception ex)
        {
            CategoryErrorMessage = "Failed to load categories. " + ex.Message;
        }
        finally
        {
            IsCategoriesLoading = false;
        }
    }

    private string GetCategoryName(int categoryId)
    {
        var category = Categories.FirstOrDefault(c => c.CategoryId == categoryId);
        return category?.CategoryName ?? $"ID: {categoryId}";
    }

    private void ShowCreateForm()
    {
        EditingCourseId = null;
        CurrentCourse = new CreateCourseRequest { CategoryId = 0 };
        ThumbnailPreviewUrl = null;
        ExistingThumbnailUrl = null;
        UploadedFileBytes = null;
        UploadedFileName = null;
        UploadedFileMimeType = null;
        ShouldRemoveThumbnail = false;
        IsFormVisible = true;
        ErrorMessage = null;
    }

    private void ShowEditForm(CourseSummaryResponse course)
    {
        EditingCourseId = course.CourseId;
        CurrentCourse = new CreateCourseRequest
        {
            Title = course.Title,
            Description = course.Description,
            CategoryId = course.CategoryId
        };
        ThumbnailPreviewUrl = null;
        ExistingThumbnailUrl = course.ThumbnailUrl;
        UploadedFileBytes = null;
        UploadedFileName = null;
        UploadedFileMimeType = null;
        ShouldRemoveThumbnail = false;
        IsFormVisible = true;
        ErrorMessage = null;
    }

    private void HideForm()
    {
        IsFormVisible = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        var file = e.File;
        if (file == null) return;

        // Size check (5MB)
        if (file.Size > 5 * 1024 * 1024)
        {
            ErrorMessage = "Image file size must be less than 5 MB.";
            return;
        }

        // Extension check
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowed = new[] { ".jpg", ".jpeg", ".png", ".webp" };
        if (!allowed.Contains(extension))
        {
            ErrorMessage = "Only .jpg, .jpeg, .png, and .webp images are allowed.";
            return;
        }

        // Content type check
        var allowedMimes = new[] { "image/jpeg", "image/png", "image/webp" };
        if (!allowedMimes.Contains(file.ContentType.ToLowerInvariant()))
        {
            ErrorMessage = "Only JPEG, PNG, and WebP images are allowed.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(5 * 1024 * 1024);
            var buffer = new byte[file.Size];
            await stream.ReadExactlyAsync(buffer, 0, buffer.Length);

            UploadedFileBytes = buffer;
            UploadedFileName = file.Name;
            UploadedFileMimeType = file.ContentType;
            ShouldRemoveThumbnail = false;

            // Preview local file in browser immediately
            ThumbnailPreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error reading image file: " + ex.Message;
        }
    }

    private void RemoveImage()
    {
        UploadedFileBytes = null;
        UploadedFileName = null;
        UploadedFileMimeType = null;
        ThumbnailPreviewUrl = null;
        
        if (EditingCourseId.HasValue)
        {
            ShouldRemoveThumbnail = true;
            ExistingThumbnailUrl = null;
        }
    }

    private async Task<string> GetApiErrorMessage(HttpResponseMessage response)
    {
        try
        {
            var apiError = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
            return apiError?.Error ?? $"Server error ({response.StatusCode})";
        }
        catch
        {
            return $"Server error ({response.StatusCode})";
        }
    }

    private async Task SaveCourse()
    {
        if (string.IsNullOrWhiteSpace(CurrentCourse.Title))
        {
            ErrorMessage = "Title is required.";
            return;
        }

        if (CurrentCourse.CategoryId <= 0)
        {
            ErrorMessage = "Please select a category.";
            return;
        }

        IsSaving = true;
        ErrorMessage = null;
        try
        {
            HttpResponseMessage response;
            if (EditingCourseId.HasValue)
            {
                var updateRequest = new UpdateCourseRequest
                {
                    Title = CurrentCourse.Title,
                    Description = CurrentCourse.Description,
                    CategoryId = CurrentCourse.CategoryId,
                    ThumbnailBytes = UploadedFileBytes,
                    ThumbnailFileName = UploadedFileName,
                    ThumbnailMimeType = UploadedFileMimeType,
                    RemoveThumbnail = ShouldRemoveThumbnail
                };
                response = await CourseClient.UpdateCourseAsync(EditingCourseId.Value, updateRequest);
            }
            else
            {
                CurrentCourse.ThumbnailBytes = UploadedFileBytes;
                CurrentCourse.ThumbnailFileName = UploadedFileName;
                CurrentCourse.ThumbnailMimeType = UploadedFileMimeType;
                response = await CourseClient.CreateCourseAsync(CurrentCourse);
            }

            if (response.IsSuccessStatusCode)
            {
                IsFormVisible = false;
                await LoadCourses();
            }
            else
            {
                ErrorMessage = await GetApiErrorMessage(response);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error saving course: " + ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task SoftDeleteCourse(int id)
    {
        if (IsDeleting) return;

        if (await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this course? It will be hidden from students."))
        {
            IsDeleting = true;
            try
            {
                var response = await CourseClient.DeleteCourseAsync(id);
                if (response.IsSuccessStatusCode)
                {
                    await LoadCourses();
                }
                else
                {
                    ErrorMessage = await GetApiErrorMessage(response);
                }
            }
            catch (Exception ex)
            {
                ErrorMessage = "Error deleting course: " + ex.Message;
            }
            finally
            {
                IsDeleting = false;
            }
        }
    }

    private class ApiErrorResponse
    {
        public string? Error { get; set; }
    }
}
