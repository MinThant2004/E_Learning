@page "/admin/courses"

@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Permission:Course.Update")]
@implements IDisposable
@inject CourseApiClient CourseClient
@inject CategoryApiClient CategoryClient
@using ELearningManagementSystem.App.Components.Shared
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager NavManager

<PageTitle>Manage Courses</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-3 pb-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Manage Courses</h1>
            <p class="text-xs font-semibold text-slate-500 mt-1">A list of all courses in the system including their status and details.</p>
        </div>
        <AuthorizeView Policy="Permission:Course.Create">
            <Authorized>
                <button @onclick='() => NavManager.NavigateTo("/admin/courses/create")' type="button" disabled="@(IsLoading || IsSaving || IsDeleting)" class="inline-flex items-center justify-center rounded-full bg-indigo-600 px-4 py-2 text-xs font-extrabold text-white hover:bg-indigo-700 shadow-sm transition-all disabled:opacity-50 self-start sm:self-auto">
                    <svg class="w-3.5 h-3.5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                    </svg>
                    Add Course
                </button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (ErrorMessage != null)
    {
        <div class="mb-8 rounded-xl bg-red-50 p-4 border border-red-200 shadow-sm animate-in fade-in slide-in-from-top-4 duration-300">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">Error</h3>
                    <div class="mt-2 text-sm text-red-700">
                        <p>@ErrorMessage</p>
                    </div>
                </div>
                <div class="ml-auto pl-3">
                    <div class="-mx-1.5 -my-1.5">
                        <button @onclick="() => ErrorMessage = null" type="button" class="inline-flex rounded-md bg-red-50 p-1.5 text-red-500 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-600 focus:ring-offset-2 focus:ring-offset-red-50">
                            <span class="sr-only">Dismiss</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-3 sm:space-y-0">
        <div class="w-full sm:max-w-xs relative text-slate-400 focus-within:text-indigo-600">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
                </svg>
            </div>
            <input type="text" @bind="SearchTerm" @bind:event="oninput" placeholder="Search courses..." class="block w-full rounded-xl border-slate-300 pl-10 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2.5 transition-colors" />
        </div>
        <div class="inline-flex items-center space-x-2">
            <label for="statusFilter" class="text-sm font-medium text-slate-700">Status:</label>
            <select id="statusFilter" @bind="StatusFilterString" class="rounded-lg border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500 py-2.5 pl-3 pr-10">
                <option value="false">Active</option>
                <option value="true">Archived</option>
                <option value="null">All</option>
            </select>
        </div>
    </div>

    <div class="bg-white shadow-sm ring-1 ring-slate-200 sm:rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th scope="col" class="py-4 pl-4 pr-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider sm:pl-6 w-16">No.</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Title</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider w-48">Category</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider w-48">Image</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider w-24">Status</th>
                        @if (ShowModuleColumns)
                        {
                            <th scope="col" class="px-3 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider w-20">Lessons</th>
                            <th scope="col" class="px-3 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider w-20">Quizzes</th>
                        }
                        <th scope="col" class="relative py-4 pl-3 pr-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider sm:pr-6 w-28">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="@(ShowModuleColumns ? 8 : 6)" class="px-6 py-12">
                                <div class="flex justify-center">
                                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (Courses == null || !Courses.Any())
                    {
                        <tr>
                            <td colspan="@(ShowModuleColumns ? 8 : 6)" class="px-3 py-8">
                                <EmptyState Title="No courses found" Description="Get started by creating a new course.">
                                    <Icon>
                                        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                        </svg>
                                    </Icon>
                                </EmptyState>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (int i = 0; i < Courses.Count; i++)
                        {
                            var course = Courses[i];
                            var rowNum = (CurrentPage - 1) * PageSize + i + 1;
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-slate-900 sm:pl-6">@rowNum</td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-900 font-semibold">
                                    @course.Title
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-100">
                                        @(string.IsNullOrEmpty(course.CategoryName) ? GetCategoryName(course.CategoryId) : course.CategoryName)
                                    </span>
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">
                                    @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                    {
                                        <img src="@($"{Http.BaseAddress?.ToString().TrimEnd('/')}{course.ThumbnailUrl}")" class="h-10 w-16 object-cover rounded-lg border border-slate-200 shadow-sm" />
                                    }
                                    else
                                    {
                                        <div class="h-10 w-16 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400 font-semibold text-[10px] select-none">
                                            No Image
                                        </div>
                                    }
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm"><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold @(course.DeleteFlag ? "bg-amber-100 text-amber-800" : "bg-emerald-100 text-emerald-800")">@(course.DeleteFlag ? "Archived" : "Active")</span></td>
                                @if (ShowModuleColumns)
                                {
                                <td class="whitespace-nowrap px-3 py-4 text-center text-sm">
                                    @if (!course.DeleteFlag)
                                    {
                                        <AuthorizeView Policy="Permission:Lesson.Update">
                                            <Authorized>
                                                <button @onclick='() => NavManager.NavigateTo($"/admin/courses/{course.CourseId}/lessons")' disabled="@(IsSaving || IsDeleting)" class="text-emerald-600 hover:text-emerald-900 transition-colors p-1 rounded hover:bg-emerald-50 disabled:opacity-50" title="Manage Lessons">
                                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                                    </svg>
                                                    <span class="sr-only">Lessons</span>
                                                </button>
                                            </Authorized>
                                            </AuthorizeView>
                                        }
                                        else
                                        {
                                            <span class="text-slate-300 text-sm font-medium select-none" title="Archived course">&mdash;</span>
                                        }
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-center text-sm">
                                    @if (!course.DeleteFlag)
                                    {
                                        <AuthorizeView Policy="Permission:Quiz.Update">
                                            <Authorized>
                                                <button @onclick='() => NavManager.NavigateTo($"/admin/courses/{course.CourseId}/quizzes")' disabled="@(IsSaving || IsDeleting)" class="text-indigo-600 hover:text-indigo-900 transition-colors p-1 rounded hover:bg-indigo-50 disabled:opacity-50" title="Manage Quiz">
                                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                                                    </svg>
                                                    <span class="sr-only">Quiz</span>
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    }
                                    else
                                    {
                                        <span class="text-slate-300 text-sm font-medium select-none" title="Archived course">&mdash;</span>
                                    }
                                </td>
                                }
                                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                    <div class="flex items-center justify-end gap-1">
                                        @if (!course.DeleteFlag)
                                        {
                                            <AuthorizeView Policy="Permission:Course.Update">
                                                <Authorized>
                                                    <button @onclick='() => NavManager.NavigateTo($"/admin/courses/{course.CourseId}/edit")' disabled="@(IsSaving || IsDeleting)" class="text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 transition p-1.5 rounded-lg disabled:opacity-50" title="Edit">
                                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                        </svg>
                                                        <span class="sr-only">Edit</span>
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                            <AuthorizeView Policy="Permission:Course.Delete">
                                                <Authorized>
                                                    <button @onclick="() => OpenArchive(course)" disabled="@(IsSaving || IsDeleting)" class="text-slate-500 hover:text-rose-600 hover:bg-rose-50 transition p-1.5 rounded-lg disabled:opacity-50" title="Delete">
                                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                        </svg>
                                                        <span class="sr-only">Delete</span>
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                        }
                                        else
                                        {
                                            <AuthorizeView Policy="Permission:Course.Update">
                                                <Authorized>
                                                    <button @onclick="() => OpenArchive(course)" disabled="@(IsSaving || IsDeleting)" class="text-slate-500 hover:text-emerald-600 hover:bg-emerald-50 transition p-1.5 rounded-lg disabled:opacity-50" title="Restore">
                                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                                        </svg>
                                                        <span class="sr-only">Restore</span>
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <Pagination CurrentPage="CurrentPage" TotalPages="TotalPages" TotalCount="TotalCount" PageSize="PageSize"
                PageChanged="GoToPageAsync" PageSizeChanged="OnPageSizeChangedAsync" />
</div>
<ConfirmationModal IsVisible="@IsConfirmVisible" Title="@ConfirmTitle" Message="@ConfirmMessage" ConfirmText="@ConfirmText" IsDestructive="@(!ConfirmRestore)" OnConfirm="ConfirmStatusChange" OnCancel="CloseConfirmation" />

@code {
    private List<CourseSummaryResponse> Courses = new();
    private List<CategoryResponse> Categories = new();

    private bool IsLoading = true;
    private string? ErrorMessage;

    private bool IsSaving = false;
    private bool IsDeleting = false;

    private bool IsConfirmVisible, ConfirmRestore;
    private CourseSummaryResponse? PendingCourse;
    private string ConfirmTitle => ConfirmRestore ? "Restore Course?" : "Archive Course?";
    private string ConfirmText => ConfirmRestore ? "Restore" : "Archive";
    private string ConfirmMessage => ConfirmRestore ? $"Are you sure you want to restore \"{PendingCourse?.Title}\"?" : $"Are you sure you want to archive \"{PendingCourse?.Title}\"? The course will no longer be available to students. You can restore it later.";

    private bool? StatusFilter = false;

    // Lessons/Quizzes columns are shown for Active and All views (hidden only for Archived)
    private bool ShowModuleColumns => StatusFilter != true;
    private string StatusFilterString
    {
        get => StatusFilter switch { false => "false", true => "true", _ => "null" };
        set
        {
            bool? newValue = value switch { "false" => false, "true" => true, _ => null };
            if (StatusFilter != newValue)
            {
                StatusFilter = newValue;
                CurrentPage = 1;
                _ = LoadCourses();
            }
        }
    }

    private string? _searchTerm;
    private string? SearchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                CurrentPage = 1;
                DebounceSearch();
            }
        }
    }

    private System.Timers.Timer? _debounceTimer;

    private void DebounceSearch()
    {
        _debounceTimer?.Stop();
        if (_debounceTimer == null)
        {
            _debounceTimer = new System.Timers.Timer(400);
            _debounceTimer.Elapsed += async (s, e) =>
            {
                _debounceTimer.Stop();
                await InvokeAsync(async () =>
                {
                    await LoadCourses();
                });
            };
            _debounceTimer.AutoReset = false;
        }
        _debounceTimer.Start();
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }

    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalPages = 1;
    private int TotalCount = 0;

    private Task GoToPageAsync(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage) return Task.CompletedTask;
        CurrentPage = page;
        return LoadCourses();
    }

    private Task OnPageSizeChangedAsync(int pageSize)
    {
        if (pageSize == PageSize) return Task.CompletedTask;
        PageSize = pageSize;
        CurrentPage = 1;
        return LoadCourses();
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadCourses(), LoadCategories());
    }

    private async Task LoadCourses()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var result = await CourseClient.GetCoursesAsync(page: CurrentPage, pageSize: PageSize, searchTerm: _searchTerm, isArchived: StatusFilter);
            if (result != null)
            {
                Courses = result.Items.ToList();
                CurrentPage = result.Page;
                PageSize = result.PageSize;
                TotalPages = result.TotalPages;
                TotalCount = result.TotalCount;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to load courses. " + ex.Message;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            var result = await CategoryClient.GetCategoriesAsync();
            if (result != null)
            {
                Categories = result.Items.ToList();
            }
        }
        catch
        {
            // Category names are a display fallback only; the table still renders.
        }
    }

    private string GetCategoryName(int categoryId)
    {
        var category = Categories.FirstOrDefault(c => c.CategoryId == categoryId);
        return category?.CategoryName ?? $"ID: {categoryId}";
    }

    private async Task<string> GetApiErrorMessage(HttpResponseMessage response)
    {
        return await ApiResponseHelper.GetErrorMessageAsync(response);
    }

    private void OpenArchive(CourseSummaryResponse course) { PendingCourse = course; ConfirmRestore = course.DeleteFlag; IsConfirmVisible = true; }
    private void CloseConfirmation() => IsConfirmVisible = false;
    private async Task ConfirmStatusChange()
    {
        if (PendingCourse is null) return;
        if (IsDeleting) return;

        IsDeleting = true;
        try
        {
            var response = ConfirmRestore ? await CourseClient.RestoreCourseAsync(PendingCourse.CourseId) : await CourseClient.ArchiveCourseAsync(PendingCourse.CourseId);
            if (response.IsSuccessStatusCode)
            {
                IsConfirmVisible = false;
                if (Courses.Count == 1 && CurrentPage > 1) CurrentPage--;
                await LoadCourses();
            }
            else
            {
                ErrorMessage = await GetApiErrorMessage(response);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error updating course status: " + ex.Message;
        }
        finally
        {
            IsDeleting = false;
        }
    }

}
