@page "/admin/users/{UserId:int}/edit"

@using ELearningManagementSystem.App.Components.UI
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Policy = "Permission:User.Update")]
@inject UserApiClient UserClient
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Edit User</PageTitle>

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 sm:p-8 space-y-6">
        <div>
            <a href="/admin/users" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-indigo-600 transition mb-2">← Back to Users</a>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Edit User</h1>
            <p class="text-xs font-semibold text-slate-500 mt-1">Update account details and manage role assignments.</p>
        </div>
        <div class="border-b border-slate-100 pt-3"></div>

    @if (ErrorMessage != null)
    {
        <div class="rounded-xl bg-red-50 p-4 border border-red-200 shadow-sm animate-in fade-in slide-in-from-top-4 duration-300">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">Error</h3>
                    <div class="mt-2 text-sm text-red-700">
                        <p>@ErrorMessage</p>
                    </div>
                </div>
                <div class="ml-auto pl-3">
                    <div class="-mx-1.5 -my-1.5">
                        <button @onclick="() => ErrorMessage = null" type="button" class="inline-flex rounded-md bg-red-50 p-1.5 text-red-500 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-600 focus:ring-offset-2 focus:ring-offset-red-50">
                            <span class="sr-only">Dismiss</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (IsLoading)
    {
        <div class="animate-pulse">
            <div class="h-5 bg-slate-200 rounded w-40 mb-6"></div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="h-10 bg-slate-100 rounded-lg"></div>
                <div class="h-10 bg-slate-100 rounded-lg"></div>
                <div class="h-10 bg-slate-100 rounded-lg col-span-full"></div>
            </div>
        </div>
    }
    else if (!IsProtectedAccount)
    {
            <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                    <!-- Full Name -->
                    <div class="sm:col-span-3">
                        <label for="fullName" class="block text-sm font-bold text-slate-700 mb-2">Full Name <span class="text-rose-500">*</span></label>
                            <input type="text" id="fullName" @bind="FullName" placeholder="e.g. John Doe" class="w-full text-sm rounded-xl border border-slate-200 px-4 py-2.5 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition" />
                    </div>

                    <!-- Email (read-only) -->
                    <div class="sm:col-span-3">
                        <label for="email" class="block text-sm font-bold text-slate-700 mb-2">Email Address</label>
                            <input type="email" id="email" value="@Email" disabled class="w-full text-sm rounded-xl border border-slate-200 px-4 py-2.5 bg-slate-50 text-slate-500 cursor-not-allowed" />
                            <p class="mt-1.5 text-xs text-slate-400">Email address cannot be changed.</p>
                    </div>

                    <!-- Roles -->
                    <div class="sm:col-span-6">
                        <label class="block text-sm font-bold text-slate-700 mb-2">Assign Roles</label>
                        @if (IsLoadingRoles)
                        {
                            <div class="flex items-center text-sm text-slate-400">
                                <svg class="animate-spin mr-2 h-4 w-4 text-indigo-600" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                Loading roles...
                            </div>
                        }
                        else
                        {
                            <div class="flex items-center space-x-4 flex-wrap gap-y-2">
                                @foreach (var role in AvailableRoles)
                                {
                                    bool isRoleDisabled = role == "System Administrator" && !IsCurrentUserSuperAdmin;
                                    <label class="inline-flex items-center">
                                        <input type="checkbox" checked="@SelectedRoles.Contains(role)" disabled="@isRoleDisabled" @onchange="@(e => ToggleRole(role, e.Value))" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 disabled:opacity-50" />
                                        <span class="ml-2 text-sm text-slate-700 @(isRoleDisabled ? "opacity-50" : "")">@GetFriendlyRoleName(role)</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </div>
            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" @onclick="GoBack" class="px-5 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-200/60 rounded-xl transition">Cancel</button>
                <button type="button" @onclick="HandleSave" disabled="@IsSaving" class="px-6 py-2 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-sm transition disabled:opacity-70">
                    @if (IsSaving)
                    {
                        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int UserId { get; set; }

    private bool IsLoading = true;
    private bool IsLoadingRoles = true;
    private bool IsSaving = false;
    private bool IsProtectedAccount = false;
    private string? ErrorMessage;

    // Form State
    private string FullName = string.Empty;
    private string Email = string.Empty;
    private bool Status = true;
    private List<string> SelectedRoles = new();
    private List<string> AvailableRoles = new();
    private bool IsCurrentUserSuperAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            IsCurrentUserSuperAdmin = authState.User.IsInRole("System Administrator");

            var userTask = UserClient.GetUserByIdAsync(UserId);
            var rolesTask = UserClient.GetAvailableRolesAsync();

            await Task.WhenAll(userTask, rolesTask);

            var user = userTask.Result;
            if (user != null)
            {
                FullName = user.FullName;
                Email = user.Email;
                Status = user.Status;
                SelectedRoles = user.Roles.Select(r => r.RoleName).ToList();

                // Mirror the list-page guard: only SuperAdmins may manage other administrators' accounts.
                var isTargetAdminOrSuper = SelectedRoles.Any(r => r is "Administrator" or "System Administrator");
                int.TryParse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var currentUserId);
                if (isTargetAdminOrSuper && !IsCurrentUserSuperAdmin && user.UserId != currentUserId)
                {
                    IsProtectedAccount = true;
                    ErrorMessage = "Administrator accounts are protected. Only a System Administrator can modify this account.";
                }
            }
            else
            {
                ErrorMessage = "This user could not be found. It may have been removed.";
            }

            var roles = rolesTask.Result;
            if (roles != null)
            {
                AvailableRoles = roles;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to load user details. " + ex.Message;
        }
        finally
        {
            IsLoading = false;
            IsLoadingRoles = false;
        }
    }

    private void ToggleRole(string role, object? isChecked)
    {
        bool check = isChecked as bool? ?? false;
        if (check)
        {
            if (!SelectedRoles.Contains(role))
                SelectedRoles.Add(role);
        }
        else
        {
            SelectedRoles.Remove(role);
        }
    }

    private static string GetFriendlyRoleName(string roleName) => roleName;

    private async Task HandleSave()
    {
        if (string.IsNullOrWhiteSpace(FullName))
        {
            ErrorMessage = "Full Name is required.";
            return;
        }
        if (!SelectedRoles.Any())
        {
            ErrorMessage = "At least one role must be assigned.";
            return;
        }

        IsSaving = true;
        ErrorMessage = null;
        try
        {
            var request = new UpdateUserRequest
            {
                FullName = FullName.Trim(),
                Status = Status,
                Roles = SelectedRoles
            };

            var response = await UserClient.UpdateUserAsync(UserId, request);
            if (response.Success)
            {
                NavManager.NavigateTo("/admin/users");
            }
            else
            {
                ErrorMessage = GetFriendlyUserError(response.Error) ?? "An error occurred while updating user.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error updating user: " + ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private static string? GetFriendlyUserError(string? error)
    {
        if (string.IsNullOrWhiteSpace(error))
            return null;

        if (error.Contains("ProtectedAccount", StringComparison.OrdinalIgnoreCase))
            return "Only a System Administrator can modify another Administrator's account.";

        if (error.Contains("PrivilegeEscalation", StringComparison.OrdinalIgnoreCase))
            return "You can only assign permissions and roles that you possess.";

        if (error.Contains("ProtectedRole", StringComparison.OrdinalIgnoreCase))
            return "You are not allowed to assign one or more of the selected roles.";

        if (error.Contains("UserArchived", StringComparison.OrdinalIgnoreCase))
            return "This account is deactivated and cannot be edited. Reactivate it first.";

        if (error.Contains("CannotRemoveLastAdmin", StringComparison.OrdinalIgnoreCase) ||
            error.Contains("CannotRemoveLastSuperAdmin", StringComparison.OrdinalIgnoreCase))
            return "This is the last administrator account. At least one administrator must remain assigned.";

        if (error.Contains(":"))
            error = error.Split(':', 2)[1].Trim();

        return error;
    }

    private void GoBack() => NavManager.NavigateTo("/admin/users");
}
