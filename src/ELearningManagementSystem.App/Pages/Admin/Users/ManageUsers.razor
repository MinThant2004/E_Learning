@page "/admin/users"
@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@using ELearningManagementSystem.App.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Policy = "Permission:User.Read")]
@implements IDisposable
@inject UserApiClient UserClient
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Manage Users</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-3 pb-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Manage Users</h1>
            <p class="text-xs font-semibold text-slate-500 mt-1">View, update, and manage student and admin accounts.</p>
        </div>
        <AuthorizeView Policy="Permission:User.Update">
            <Authorized>
                <button @onclick="GoToCreatePage" type="button" class="inline-flex items-center justify-center rounded-full bg-indigo-600 px-4 py-2 text-xs font-extrabold text-white hover:bg-indigo-700 shadow-sm transition-all self-start sm:self-auto">
                    <svg class="w-3.5 h-3.5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                    </svg>
                    Create User
                </button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (ErrorMessage != null)
    {
        <div class="mb-8 rounded-xl bg-red-50 p-4 border border-red-200 shadow-sm animate-in fade-in slide-in-from-top-4 duration-300">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">Error</h3>
                    <div class="mt-2 text-sm text-red-700">
                        <p>@ErrorMessage</p>
                    </div>
                </div>
                <div class="ml-auto pl-3">
                    <div class="-mx-1.5 -my-1.5">
                        <button @onclick="() => ErrorMessage = null" type="button" class="inline-flex rounded-md bg-red-50 p-1.5 text-red-500 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-600 focus:ring-offset-2 focus:ring-offset-red-50">
                            <span class="sr-only">Dismiss</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-3 sm:space-y-0 gap-3">
        <div class="w-full sm:max-w-xs relative text-slate-400 focus-within:text-indigo-600">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
                </svg>
            </div>
            <input type="text" @bind="SearchTerm" @bind:event="oninput" placeholder="Search by name or email..." class="block w-full rounded-xl border-slate-300 pl-10 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2.5 transition-colors" />
        </div>
        <div class="inline-flex items-center space-x-2">
            <label for="roleFilter" class="text-sm font-medium text-slate-700">Role:</label>
            <select id="roleFilter" @bind="RoleFilter" class="rounded-lg border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500 py-2.5 pl-3 pr-10">
                <option value="All Roles">All Roles</option>
                @foreach (var role in AvailableRoles)
                {
                    <option value="@role">@GetFriendlyRoleName(role)</option>
                }
            </select>

            <label for="statusFilter" class="text-sm font-medium text-slate-700 ml-2">Status:</label>
            <select id="statusFilter" @bind="StatusFilterString" class="rounded-lg border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500 py-2.5 pl-3 pr-10">
                <option value="Active">Active</option>
                <option value="Archived">Inactive</option>
                <option value="All">All</option>
            </select>
        </div>
    </div>

    <div class="bg-white shadow-sm ring-1 ring-slate-200 sm:rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th scope="col" class="py-4 pl-4 pr-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider sm:pl-6 w-16">No.</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Name</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Email</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Roles</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                        <th scope="col" class="relative py-4 pl-3 pr-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider sm:pr-6 w-32">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12">
                                <div class="flex justify-center">
                                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (Users == null || !Users.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-3 py-8">
                                <EmptyState Title="No users found" Description="There are no matching users for the search criteria.">
                                    <Icon>
                                        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                        </svg>
                                    </Icon>
                                </EmptyState>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (int i = 0; i < Users.Count; i++)
                        {
                            var user = Users[i];
                            var rowNum = (CurrentPage - 1) * PageSize + i + 1;
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-slate-900 sm:pl-6">@rowNum</td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-900 font-semibold">@user.FullName</td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">@user.Email</td>
                                <td class="px-3 py-4 text-sm text-slate-500">
                                    @if (user.Roles != null && user.Roles.Any())
                                    {
                                        <div class="flex flex-wrap gap-1">
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="inline-flex rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10">@GetFriendlyRoleName(role)</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm"><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold @(user.IsArchived ? "bg-amber-100 text-amber-800" : "bg-emerald-100 text-emerald-800")">@(user.IsArchived ? "Inactive" : "Active")</span></td>
                                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                    <div class="flex items-center justify-end space-x-3">
                                        @{
                                            bool isProtected = IsProtectedAdministratorAccount(user);
                                        }
                                        @if (!user.IsArchived)
                                        {
                                            <AuthorizeView Policy="Permission:User.Update">
                                                <Authorized>
                                                    <button @onclick="() => GoToEditPage(user)" disabled="@(IsSaving || IsDeleting)" class="text-indigo-600 hover:text-indigo-900 transition-colors p-1 rounded hover:bg-indigo-50 disabled:opacity-50" title="@(isProtected ? "Administrator account protected" : "Edit User")">
                                                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                        </svg>
                                                        <span class="sr-only">Edit User</span>
                                                    </button>
                                                    <button @onclick="() => TryOpenArchive(user)" disabled="@(IsSaving || IsDeleting)" class="text-amber-600 hover:text-amber-800 transition-colors p-1 rounded hover:bg-amber-50 disabled:opacity-50" title="@(isProtected ? "Administrator account protected" : "Deactivate")">
                                                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                                        </svg>
                                                        <span class="sr-only">Deactivate</span>
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                        }
                                        else
                                        {
                                            <AuthorizeView Policy="Permission:User.Update">
                                                <Authorized>
                                                    <button @onclick="() => TryOpenArchive(user)" disabled="@(IsSaving || IsDeleting)" class="text-emerald-600 hover:text-emerald-800 transition-colors p-1 rounded hover:bg-emerald-50 disabled:opacity-50" title="@(isProtected ? "Administrator account protected" : "Activate")">
                                                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                        </svg>
                                                        <span class="sr-only">Activate</span>
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <Pagination CurrentPage="CurrentPage" TotalPages="TotalPages" TotalCount="TotalCount" PageSize="PageSize"
                ItemLabel="users" PageChanged="GoToPageAsync" PageSizeChanged="OnPageSizeChangedAsync" />
</div>
<ConfirmationModal IsVisible="@IsConfirmVisible" Title="@ConfirmTitle" Message="@ConfirmMessage" ConfirmText="@ConfirmText" IsDestructive="@(!ConfirmRestore)" OnConfirm="ConfirmStatusChange" OnCancel="CloseConfirmation" />
<ConfirmationModal IsVisible="@IsProtectionMessageVisible" Title="Administrator Account Protected" Message="You don't have permission to manage another administrator's account." ConfirmText="OK" IsDestructive="false" ShowCancel="false" OnConfirm="CloseProtectionMessage" OnCancel="CloseProtectionMessage" />
<ConfirmationModal IsVisible="@IsSuccessModalVisible" Title="User Created Successfully" Message="@SuccessMessage" ConfirmText="OK" IsDestructive="false" ShowCancel="false" OnConfirm="CloseSuccessModal" OnCancel="CloseSuccessModal" />

@code {
    private List<AdminUserSummaryResponse> Users = new();
    private List<string> AvailableRoles = new();
    
    private bool IsLoading = true;
    private string? ErrorMessage;
    
    private bool IsSuccessModalVisible = false;
    private string SuccessMessage = string.Empty;
    private bool IsSaving = false;
    private bool IsDeleting = false;
    
    private bool IsConfirmVisible, ConfirmRestore;
    private bool IsProtectionMessageVisible;
    private AdminUserSummaryResponse? PendingUser;
    private string ConfirmTitle => ConfirmRestore ? "Activate User?" : "Deactivate User?";
    private string ConfirmText => ConfirmRestore ? "Activate" : "Deactivate";
    private string ConfirmMessage => ConfirmRestore ? $"Are you sure you want to activate user \"{PendingUser?.Email}\"?" : $"Are you sure you want to deactivate user \"{PendingUser?.Email}\"?";

    private UserArchiveFilter StatusFilter = UserArchiveFilter.Active;
    private string StatusFilterString
    {
        get => StatusFilter.ToString();
        set
        {
            if (Enum.TryParse<UserArchiveFilter>(value, out var newValue))
            {
                if (StatusFilter != newValue)
                {
                    StatusFilter = newValue;
                    CurrentPage = 1;
                    _ = LoadUsers();
                }
            }
        }
    }

    private string _roleFilter = "All Roles";
    private string RoleFilter
    {
        get => _roleFilter;
        set
        {
            if (_roleFilter != value)
            {
                _roleFilter = value;
                CurrentPage = 1;
                _ = LoadUsers();
            }
        }
    }

    private string? _searchTerm;
    private string? SearchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                CurrentPage = 1;
                DebounceSearch();
            }
        }
    }

    private System.Timers.Timer? _debounceTimer;

    private void DebounceSearch()
    {
        _debounceTimer?.Stop();
        if (_debounceTimer == null)
        {
            _debounceTimer = new System.Timers.Timer(400);
            _debounceTimer.Elapsed += async (s, e) =>
            {
                _debounceTimer.Stop();
                await InvokeAsync(async () =>
                {
                    await LoadUsers();
                });
            };
            _debounceTimer.AutoReset = false;
        }
        _debounceTimer.Start();
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }

    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalPages = 1;
    private int TotalCount = 0;

    private Task GoToPageAsync(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage) return Task.CompletedTask;
        CurrentPage = page;
        return LoadUsers();
    }

    private Task OnPageSizeChangedAsync(int pageSize)
    {
        if (pageSize == PageSize) return Task.CompletedTask;
        PageSize = pageSize;
        CurrentPage = 1;
        return LoadUsers();
    }

    private bool IsCurrentUserSuperAdmin = false;
    private int? CurrentUserId;

    [SupplyParameterFromQuery(Name = "created")]
    public string? CreatedUserEmail { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            IsCurrentUserSuperAdmin = authState.User.IsInRole("System Administrator");
            if (int.TryParse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var currentUserId))
            {
                CurrentUserId = currentUserId;
            }

            var roles = await UserClient.GetAvailableRolesAsync();
            if (roles != null)
            {
                AvailableRoles = roles;
            }
        }
        catch { }

        if (!string.IsNullOrWhiteSpace(CreatedUserEmail))
        {
            SuccessMessage = $"User account for \"{CreatedUserEmail}\" was created successfully.";
            IsSuccessModalVisible = true;
        }

        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var query = new UserListQuery
            {
                Page = CurrentPage,
                PageSize = PageSize,
                SearchTerm = _searchTerm,
                ArchiveFilter = StatusFilter,
                RoleFilter = _roleFilter
            };
            var result = await UserClient.GetUsersAsync(query);
            if (result != null)
            {
                Users = result.Items.ToList();
                CurrentPage = result.Page;
                PageSize = result.PageSize;
                TotalPages = result.TotalPages;
                TotalCount = result.TotalCount;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to load users. " + ex.Message;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void GoToEditPage(AdminUserSummaryResponse user)
    {
        if (IsProtectedAdministratorAccount(user))
        {
            IsProtectionMessageVisible = true;
            return;
        }

        Navigation.NavigateTo($"/admin/users/{user.UserId}/edit");
    }

    private void TryOpenArchive(AdminUserSummaryResponse user)
    {
        if (IsProtectedAdministratorAccount(user))
        {
            IsProtectionMessageVisible = true;
            return;
        }

        OpenArchive(user);
    }

    private void OpenArchive(AdminUserSummaryResponse user) { PendingUser = user; ConfirmRestore = user.IsArchived; IsConfirmVisible = true; }
    private void CloseConfirmation() => IsConfirmVisible = false;
    private void CloseProtectionMessage() => IsProtectionMessageVisible = false;
    
    private async Task ConfirmStatusChange()
    {
        if (PendingUser is null) return;
        if (IsDeleting) return;

        IsDeleting = true;
        ErrorMessage = null;
        try
        {
            var response = ConfirmRestore ? await UserClient.RestoreUserAsync(PendingUser.UserId) : await UserClient.ArchiveUserAsync(PendingUser.UserId);
            if (response.Success)
            {
                IsConfirmVisible = false;
                if (Users.Count == 1 && CurrentPage > 1) CurrentPage--;
                await LoadUsers();
            }
            else
            {
                ShowFriendlyUserError(response.Error, "An error occurred while changing user status.");
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error updating user status: " + ex.Message;
        }
        finally
        {
            IsDeleting = false;
        }
    }

    private bool IsProtectedAdministratorAccount(AdminUserSummaryResponse user) =>
        !IsCurrentUserSuperAdmin &&
        user.UserId != CurrentUserId &&
        user.Roles.Any(role => role is "Administrator" or "System Administrator");

    private void ShowFriendlyUserError(string? error, string fallback)
    {
        if (!string.IsNullOrWhiteSpace(error) &&
            (error.Contains("ProtectedAccount", StringComparison.OrdinalIgnoreCase) ||
             error.Contains("PrivilegeEscalation", StringComparison.OrdinalIgnoreCase) ||
             error.Contains("ProtectedRole", StringComparison.OrdinalIgnoreCase)))
        {
            IsConfirmVisible = false;
            IsProtectionMessageVisible = true;
            return;
        }

        ErrorMessage = fallback;
    }

    private void GoToCreatePage() => Navigation.NavigateTo("/admin/users/create");

    private static string GetFriendlyRoleName(string roleName) => roleName;

    private void CloseSuccessModal() => IsSuccessModalVisible = false;
}
