@page "/admin/roles"
@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@using ELearningManagementSystem.App.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Policy = "Permission:Role.Read")]
@implements IDisposable
@inject RoleApiClient RoleApi
@inject PermissionApiClient PermissionApi
@inject NavigationManager NavigationManager
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Manage Roles</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="sm:flex sm:items-center sm:justify-between mb-8">
        <PageHeader Title="Manage Roles" Description="View, create, and modify system roles and their permissions." />
        <div class="mt-4 sm:mt-0 flex-shrink-0">
            <AuthorizeView Policy="Permission:Role.Create">
                <Authorized>
                    <button @onclick="ShowCreateModal" class="inline-flex items-center justify-center rounded-full border border-transparent bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors">
                        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                        </svg>
                        Create Role
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="mb-8 rounded-xl bg-red-50 p-4 border border-red-200 shadow-sm animate-in fade-in slide-in-from-top-4 duration-300">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">Error</h3>
                    <div class="mt-2 text-sm text-red-700">
                        <p>@errorMessage</p>
                    </div>
                </div>
                <div class="ml-auto pl-3">
                    <div class="-mx-1.5 -my-1.5">
                        <button @onclick="() => errorMessage = null" type="button" class="inline-flex rounded-md bg-red-50 p-1.5 text-red-500 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-600 focus:ring-offset-2 focus:ring-offset-red-50">
                            <span class="sr-only">Dismiss</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-3 sm:space-y-0 gap-3">
        <div class="w-full sm:max-w-xs relative text-slate-400 focus-within:text-indigo-600">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
                </svg>
            </div>
            <input type="text" @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" placeholder="Search roles..." class="block w-full rounded-xl border-slate-300 pl-10 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2.5 transition-colors" />
        </div>
    </div>

    <div class="bg-white shadow-sm ring-1 ring-slate-200 sm:rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th scope="col" class="py-4 pl-4 pr-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider sm:pl-6 w-16">No.</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Role Name</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Description</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Created At</th>
                        <th scope="col" class="relative py-4 pl-3 pr-4 sm:pr-6 w-40">
                            <span class="sr-only">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12">
                                <div class="flex justify-center">
                                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (roles == null || !roles.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-3 py-8">
                                <EmptyState Title="No roles found" Description="There are no matching roles for the search criteria.">
                                    <Icon>
                                        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                        </svg>
                                    </Icon>
                                </EmptyState>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (int i = 0; i < roles.Count; i++)
                        {
                            var role = roles[i];
                            var rowNum = i + 1;
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-slate-900 sm:pl-6">@rowNum</td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-900 font-semibold">@GetFriendlyRoleName(role.RoleName)</td>
                                <td class="px-3 py-4 text-sm text-slate-500">@role.Description</td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">@role.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                    <div class="flex items-center justify-end space-x-3">
                                        <AuthorizeView Policy="Permission:Role.Update">
                                            <Authorized>
                                                <button @onclick="() => ShowEditModal(role)" class="text-indigo-600 hover:text-indigo-900 transition-colors p-1 rounded hover:bg-indigo-50" title="Edit Role">
                                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                    </svg>
                                                    <span class="sr-only">Edit Role</span>
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                         <AuthorizeView Policy="Permission:Permission.Read">
                                             <Authorized>
                                                 <button @onclick="() => ShowPermissionsModal(role)" class="text-teal-600 hover:text-teal-900 transition-colors p-1 rounded hover:bg-teal-50" title="Manage Permissions">
                                                     <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                         <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                                     </svg>
                                                     <span class="sr-only">Permissions</span>
                                                 </button>
                                             </Authorized>
                                         </AuthorizeView>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Role Edit Modal -->
@if (showRoleModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity" @onclick="CloseRoleModal" aria-hidden="true"></div>

            <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-slate-200">
                <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-indigo-100 sm:mx-0 sm:h-10 sm:w-10">
                            <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
                            </svg>
                        </div>
                        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                            <h3 class="text-lg font-semibold leading-6 text-slate-900" id="modal-title">@(isEditing ? "Edit Role" : "Create Role")</h3>
                            <div class="mt-4 space-y-4">
                                @if (!string.IsNullOrEmpty(modalError))
                                {
                                    <div class="rounded-md bg-red-50 p-4 border border-red-200">
                                        <div class="flex">
                                            <div class="ml-3">
                                                <h3 class="text-sm font-medium text-red-800">@modalError</h3>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Role Name</label>
                                    @if (isEditing && (editingRole.RoleName == "Student" || editingRole.RoleName == "SuperAdmin" || editingRole.RoleName == "Admin"))
                                    {
                                        <input type="text" value="@GetFriendlyRoleName(editingRole.RoleName)" disabled class="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm disabled:opacity-50 disabled:bg-slate-50" />
                                        <p class="mt-1 text-xs text-slate-500">Built-in role names cannot be changed.</p>
                                    }
                                    else
                                    {
                                        <input type="text" maxlength="100" @bind="editingRole.RoleName" class="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                                    }
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Description</label>
                                    <textarea maxlength="255" @bind="editingRole.Description" rows="3" class="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-slate-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                    <button type="button" @onclick="SaveRole" disabled="@isSaving" class="inline-flex w-full justify-center rounded-full border border-transparent bg-indigo-600 px-4 py-2 text-base font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:ml-3 sm:w-auto sm:text-sm disabled:opacity-70">
                        @if (isSaving)
                        {
                            <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        }
                        Save
                    </button>
                    <button type="button" @onclick="CloseRoleModal" class="mt-3 inline-flex w-full justify-center rounded-full border border-slate-300 bg-white px-4 py-2 text-base font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Permissions Modal -->
@if (showPermissionsModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity" @onclick="ClosePermissionsModal" aria-hidden="true"></div>

            <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-4xl border border-slate-200">
                <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-teal-100 sm:mx-0 sm:h-10 sm:w-10">
                            <svg class="h-6 w-6 text-teal-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                        </div>
                        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                            <h3 class="text-lg font-semibold leading-6 text-slate-900" id="modal-title">Permissions for @GetFriendlyRoleName(selectedRoleName)</h3>
                            <div class="mt-4">
                                @if (!string.IsNullOrEmpty(modalError))
                                {
                                    <div class="rounded-md bg-red-50 p-4 border border-red-200 mb-4">
                                        <div class="flex">
                                            <div class="ml-3">
                                                <h3 class="text-sm font-medium text-red-800">@modalError</h3>
                                            </div>
                                        </div>
                                    </div>
                                }
                                
                                @if (isPermissionsLoading)
                                {
                                    <div class="flex justify-center py-8">
                                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-teal-600"></div>
                                    </div>
                                }
                                 else
                                 {
                                     @if (selectedRoleName == "SuperAdmin")
                                     {
                                         <div class="rounded-md bg-slate-50 p-4 border border-slate-200 mb-4 flex items-center justify-between">
                                             <div class="flex items-center space-x-2">
                                                 <span class="inline-flex items-center rounded-md bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-800 ring-1 ring-inset ring-slate-600/20">Protected system role</span>
                                                 <span class="text-sm text-slate-600">Permissions for this role are read-only to ensure system stability.</span>
                                             </div>
                                         </div>
                                     }
                                     <div class="max-h-[60vh] overflow-y-auto pr-2">
                                         <div class="space-y-6">
                                             @foreach (var moduleGroup in allPermissions.GroupBy(p => p.Module).OrderBy(g => g.Key))
                                             {
                                                 <div class="bg-slate-50 rounded-xl border border-slate-200 overflow-hidden">
                                                     <div class="bg-white px-4 py-3 border-b border-slate-200">
                                                         <h4 class="text-sm font-semibold text-slate-900">@moduleGroup.Key</h4>
                                                     </div>
                                                     <div class="p-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
                                                         @foreach (var perm in moduleGroup)
                                                         {
                                                              <label class="relative flex items-start p-3 rounded-lg transition-colors @(selectedRoleName == "SuperAdmin" || !canAssignPermissions ? "cursor-not-allowed opacity-80" : "cursor-pointer hover:bg-slate-100")">
                                                                  <div class="flex h-6 items-center">
                                                                      <input type="checkbox" 
                                                                             checked="@selectedPermissionIds.Contains(perm.PermissionId)"
                                                                             @onchange="@(e => TogglePermission(perm.PermissionId, e.Value))"
                                                                             disabled="@(selectedRoleName == "SuperAdmin" || !canAssignPermissions)"
                                                                             class="h-4 w-4 rounded border-slate-300 text-teal-600 focus:ring-teal-600 disabled:opacity-50 disabled:cursor-not-allowed" />
                                                                  </div>
                                                                 <div class="ml-3 text-sm leading-6">
                                                                     <span class="font-medium text-slate-900 block">@perm.PermissionName</span>
                                                                     <span class="text-slate-500 block">@perm.PermissionCode</span>
                                                                 </div>
                                                             </label>
                                                         }
                                                     </div>
                                                 </div>
                                             }
                                         </div>
                                     </div>
                                 }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-slate-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                    @if (selectedRoleName != "SuperAdmin" && canAssignPermissions)
                    {
                        <button type="button" @onclick="SavePermissions" disabled="@isSaving" class="inline-flex w-full justify-center rounded-full border border-transparent bg-teal-600 px-4 py-2 text-base font-medium text-white shadow-sm hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 sm:ml-3 sm:w-auto sm:text-sm disabled:opacity-70">
                            @if (isSaving)
                            {
                                <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            }
                            Save Permissions
                        </button>
                    }
                    <button type="button" @onclick="ClosePermissionsModal" class="mt-3 inline-flex w-full justify-center rounded-full border border-slate-300 bg-white px-4 py-2 text-base font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                        @(selectedRoleName == "SuperAdmin" ? "Close" : "Cancel")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private List<RoleResponse> roles = new();
    
    private string searchTerm = "";
    private System.Timers.Timer? searchTimer;

    // Role Edit State
    private bool showRoleModal = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private string? modalError;
    private RoleModel editingRole = new();

    // Permissions State
    private bool showPermissionsModal = false;
    private bool isPermissionsLoading = false;
    private int selectedRoleId;
    private string selectedRoleName = "";
    private List<PermissionResponse> allPermissions = new();
    private HashSet<int> selectedPermissionIds = new();
    private bool canAssignPermissions = false;

    protected override async Task OnInitializedAsync()
    {
        searchTimer = new System.Timers.Timer(500);
        searchTimer.Elapsed += async (s, e) => await InvokeAsync(LoadRolesAsync);
        searchTimer.AutoReset = false;

        await LoadRolesAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var assignAuth = await AuthorizationService.AuthorizeAsync(user, "Permission:Permission.Assign");
        canAssignPermissions = assignAuth.Succeeded;
        
        try
        {
            var perms = await PermissionApi.GetAllPermissionsAsync();
            if (perms != null)
            {
                allPermissions = perms;
            }
        }
        catch (CustomApiException ex)
        {
            if (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                errorMessage = "You do not have permission to view system permissions (403 Forbidden).";
            }
            else
            {
                errorMessage = $"Error loading permissions: {ex.Message}";
            }
        }
        catch (HttpRequestException ex)
        {
            if (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                errorMessage = "You do not have permission to view system permissions (403 Forbidden).";
            }
            else
            {
                errorMessage = $"Network error loading permissions: {ex.Message}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred while loading permissions: {ex.Message}";
        }
    }

    private void HandleSearch()
    {
        searchTimer?.Stop();
        searchTimer?.Start();
    }

    private async Task LoadRolesAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var query = new RoleListQuery { Page = 1, PageSize = 100, SearchTerm = searchTerm };
            var result = await RoleApi.GetRolesAsync(query);

            if (result != null)
            {
                roles = result.Items.ToList();
                errorMessage = null;
            }
            else
            {
                errorMessage = "Failed to load roles.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while loading roles.";
            Console.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowCreateModal()
    {
        isEditing = false;
        editingRole = new RoleModel();
        modalError = null;
        showRoleModal = true;
    }

    private void ShowEditModal(RoleResponse role)
    {
        isEditing = true;
        editingRole = new RoleModel 
        { 
            RoleId = role.RoleId, 
            RoleName = role.RoleName, 
            Description = role.Description 
        };
        modalError = null;
        showRoleModal = true;
    }

    private void CloseRoleModal()
    {
        showRoleModal = false;
    }

    private async Task SaveRole()
    {
        isSaving = true;
        modalError = null;

        try
        {
            if (string.IsNullOrWhiteSpace(editingRole.RoleName))
            {
                modalError = "Role name is required.";
                return;
            }

            if (isEditing)
            {
                var request = new UpdateRoleRequest { RoleName = editingRole.RoleName, Description = editingRole.Description };
                var result = await RoleApi.UpdateRoleAsync(editingRole.RoleId, request);
                if (result.Success)
                {
                    showRoleModal = false;
                    await LoadRolesAsync();
                }
                else
                {
                    modalError = result.Error;
                }
            }
            else
            {
                var request = new CreateRoleRequest { RoleName = editingRole.RoleName, Description = editingRole.Description };
                var result = await RoleApi.CreateRoleAsync(request);
                if (result.Success)
                {
                    showRoleModal = false;
                    await LoadRolesAsync();
                }
                else
                {
                    modalError = result.Error;
                }
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ShowPermissionsModal(RoleResponse role)
    {
        selectedRoleId = role.RoleId;
        selectedRoleName = role.RoleName;
        selectedPermissionIds.Clear();
        modalError = null;
        showPermissionsModal = true;
        isPermissionsLoading = true;

        try
        {
            var roleDetails = await RoleApi.GetRoleByIdAsync(role.RoleId);
            if (roleDetails != null)
            {
                foreach (var pId in roleDetails.PermissionIds)
                {
                    selectedPermissionIds.Add(pId);
                }
            }
        }
        catch (Exception ex)
        {
            modalError = "Failed to load role permissions.";
            Console.WriteLine(ex);
        }
        finally
        {
            isPermissionsLoading = false;
            StateHasChanged();
        }
    }

    private void ClosePermissionsModal()
    {
        showPermissionsModal = false;
    }

    private void TogglePermission(int permissionId, object? checkedValue)
    {
        if (checkedValue is bool isChecked)
        {
            if (isChecked)
                selectedPermissionIds.Add(permissionId);
            else
                selectedPermissionIds.Remove(permissionId);
        }
    }

    private async Task SavePermissions()
    {
        isSaving = true;
        modalError = null;

        try
        {
            var request = new AssignPermissionsRequest { PermissionIds = selectedPermissionIds.ToList() };
            var result = await RoleApi.AssignPermissionsAsync(selectedRoleId, request);
            
            if (result.Success)
            {
                showPermissionsModal = false;
            }
            else
            {
                modalError = result.Error;
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetFriendlyRoleName(string roleName)
    {
        return roleName switch
        {
            "SuperAdmin" => "System Administrator",
            "Admin" => "Administrator",
            "Student" => "Student",
            _ => roleName
        };
    }

    public void Dispose()
    {
        searchTimer?.Dispose();
    }

    public class RoleModel
    {
        public int RoleId { get; set; }
        public string RoleName { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}
