@page "/admin/courses/{CourseId:int}/lessons"

@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Permission:Lesson.Update")]
@implements IDisposable
@inject LessonApiClient LessonClient
@using ELearningManagementSystem.App.Components.Shared
@inject CourseApiClient CourseClient
@inject NavigationManager NavManager

<PageTitle>Manage Lessons - @CourseTitle</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Navigation Back Link -->
    <button @onclick="GoBackToCourses" class="mb-6 inline-flex items-center text-sm font-medium text-slate-500 hover:text-indigo-600 transition-colors group">
        <svg class="mr-2 h-5 w-5 text-slate-400 group-hover:text-indigo-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
        </svg>
        Back to Courses
    </button>

    <PageHeader Title="@($"Manage Lessons: {CourseTitle}")" Description="Add, edit, reorder, and remove lessons for this course.">
        <ActionTemplate>
            <AuthorizeView Policy="Permission:Lesson.Create">
                <Authorized>
                    <button @onclick="ShowCreateForm" type="button" disabled="@(IsLoading || IsSaving || IsDeleting)" class="inline-flex items-center justify-center rounded-full border border-transparent bg-indigo-600 px-6 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors w-full sm:w-auto disabled:opacity-50">
                        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Add Lesson
                    </button>
                </Authorized>
            </AuthorizeView>
        </ActionTemplate>
    </PageHeader>

    @if (ErrorMessage != null)
    {
        <div class="mb-8 rounded-xl bg-red-50 p-4 border border-red-200 shadow-sm animate-in fade-in slide-in-from-top-4 duration-300">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">Error</h3>
                    <div class="mt-2 text-sm text-red-700">
                        <p>@ErrorMessage</p>
                    </div>
                </div>
                <div class="ml-auto pl-3">
                    <button @onclick="() => ErrorMessage = null" type="button" class="inline-flex rounded-md bg-red-50 p-1.5 text-red-500 hover:bg-red-100 focus:outline-none">
                        <span class="sr-only">Dismiss</span>
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    }

    @if (IsFormVisible)
    {
        <div class="bg-white shadow-lg sm:rounded-2xl border border-slate-200 mb-8 overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-300">
            <div class="bg-slate-50 px-6 py-4 border-b border-slate-200">
                <h3 class="text-lg leading-6 font-semibold text-slate-900">@(EditingLessonId.HasValue ? "Edit Lesson" : "Create New Lesson")</h3>
            </div>
            <div class="px-6 py-6 sm:p-8">
                <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                    <div class="sm:col-span-4">
                        <label for="title" class="block text-sm font-medium text-slate-700">Lesson Title <span class="text-red-500">*</span></label>
                        <div class="mt-1">
                            <input type="text" id="title" @bind="CurrentLesson.Title" class="block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-4 py-3 transition-colors" placeholder="e.g. Setting up your workspace" />
                        </div>
                    </div>
                    <div class="sm:col-span-2">
                        <label for="order" class="block text-sm font-medium text-slate-700">Display Order (Position) <span class="text-xs text-slate-500">(1-based, automatic shift)</span></label>
                        <div class="mt-1">
                            <input type="number" min="1" id="order" @bind="CurrentLesson.DisplayOrder" class="block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-4 py-3 transition-colors" placeholder="Leave empty for appending" />
                        </div>
                    </div>
                    <div class="sm:col-span-6">
                        <label for="content" class="block text-sm font-medium text-slate-700">Lesson Content <span class="text-red-500">*</span></label>
                        <div class="mt-1">
                            <textarea id="content" rows="12" @bind="CurrentLesson.Content" class="block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-4 py-3 transition-colors font-mono" placeholder="Write lesson content here... Markdown/text support."></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-slate-50 px-6 py-4 border-t border-slate-200 flex justify-end space-x-3">
                <button type="button" @onclick="HideForm" class="rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors">Cancel</button>
                <button type="button" @onclick="SaveLesson" disabled="@IsSaving" class="inline-flex justify-center rounded-full border border-transparent bg-indigo-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:opacity-70 transition-colors">
                    @if (IsSaving)
                    {
                        <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Lesson</span>
                    }
                </button>
            </div>
        </div>
    }

    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-3 sm:space-y-0">
        <div class="w-full sm:max-w-xs relative text-slate-400 focus-within:text-indigo-600">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
                </svg>
            </div>
            <input type="text" @bind="SearchTerm" @bind:event="oninput" placeholder="Search lessons..." class="block w-full rounded-xl border-slate-300 pl-10 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2.5 transition-colors" />
        </div>
        <div class="inline-flex items-center space-x-2">
            <label for="statusFilter" class="text-sm font-medium text-slate-700">Status:</label>
            <select id="statusFilter" @bind="StatusFilterString" class="rounded-lg border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500 py-2.5 pl-3 pr-10">
                <option value="false">Active</option>
                <option value="true">Archived</option>
                <option value="null">All</option>
            </select>
        </div>
    </div>

    <div class="bg-white shadow-sm ring-1 ring-slate-200 sm:rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th scope="col" class="py-4 pl-4 pr-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider sm:pl-6 w-16">No.</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider w-32">Lesson Order</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Lesson Title</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider w-24">Status</th>
                        <th scope="col" class="relative py-4 pl-3 pr-4 sm:pr-6 w-32">
                            <span class="sr-only">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12">
                                <div class="flex justify-center">
                                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (Lessons == null || !Lessons.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-3 py-8">
                                <EmptyState Title="No lessons found" Description="Get started by creating a new lesson.">
                                    <Icon>
                                        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                        </svg>
                                    </Icon>
                                </EmptyState>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var index = 0;
                        foreach (var lesson in Lessons)
                        {
                            var currentIndex = (CurrentPage - 1) * PageSize + (++index);
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-slate-900 sm:pl-6">
                                    @currentIndex
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm font-semibold text-slate-900">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100">
                                        Lesson Order @lesson.DisplayOrder
                                    </span>
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-900 font-semibold">@lesson.Title</td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm"><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold @(lesson.DeleteFlag ? "bg-amber-100 text-amber-800" : "bg-emerald-100 text-emerald-800")">@(lesson.DeleteFlag ? "Archived" : "Active")</span></td>
                                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                    <div class="flex items-center justify-end space-x-3">
                                        @if (!lesson.DeleteFlag)
                                        {
                                            <AuthorizeView Policy="Permission:Lesson.Update">
                                                <Authorized>
                                                    <button @onclick="() => ShowEditForm(lesson)" disabled="@(IsSaving || IsDeleting)" class="text-indigo-600 hover:text-indigo-900 transition-colors p-1 rounded hover:bg-indigo-50 disabled:opacity-50" title="Edit">
                                                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                        </svg>
                                                        <span class="sr-only">Edit</span>
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                            <AuthorizeView Policy="Permission:Lesson.Delete">
                                                <Authorized>
                                                    <button @onclick="() => OpenArchive(lesson)" disabled="@(IsSaving || IsDeleting)" class="text-amber-600 hover:text-amber-800 transition-colors p-1 rounded hover:bg-amber-50 disabled:opacity-50" title="Archive">
                                                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                        </svg>
                                                        <span class="sr-only">Archive</span>
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                        }
                                        else
                                        {
                                            <AuthorizeView Policy="Permission:Lesson.Delete">
                                                <Authorized>
                                                    <button @onclick="() => OpenArchive(lesson)" disabled="@(IsSaving || IsDeleting)" class="text-emerald-600 hover:text-emerald-800 transition-colors p-1 rounded hover:bg-emerald-50 disabled:opacity-50" title="Restore">
                                                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                                        </svg>
                                                        <span class="sr-only">Restore</span>
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (TotalCount > 0)
        {
            <div class="flex items-center justify-between border-t border-slate-200 bg-white px-4 py-3 sm:px-6">
                <div class="flex flex-1 justify-between sm:hidden">
                    <button @onclick="PreviousPage" disabled="@(CurrentPage <= 1)" class="relative inline-flex items-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50">Previous</button>
                    <button @onclick="NextPage" disabled="@(CurrentPage >= TotalPages)" class="relative ml-3 inline-flex items-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50">Next</button>
                </div>
                <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-slate-700">
                            Showing <span class="font-medium">@(((CurrentPage - 1) * PageSize) + 1)</span> to <span class="font-medium">@(Math.Min(CurrentPage * PageSize, TotalCount))</span> of <span class="font-medium">@TotalCount</span> results
                        </p>
                    </div>
                    <div class="flex items-center space-x-4">
                        <select @bind="PageSizeStr" class="rounded-lg border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500 py-1 pl-2 pr-8">
                            <option value="10">10 / page</option>
                            <option value="15">15 / page</option>
                            <option value="25">25 / page</option>
                            <option value="50">50 / page</option>
                        </select>
                        <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                            <button @onclick="PreviousPage" disabled="@(CurrentPage <= 1)" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-slate-400 ring-1 ring-inset ring-slate-300 hover:bg-slate-50 focus:z-20 focus:outline-offset-0 disabled:opacity-50">
                                <span class="sr-only">Previous</span>
                                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
                                </svg>
                            </button>
                            <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-slate-900 ring-1 ring-inset ring-slate-300 focus:outline-offset-0">
                                Page @CurrentPage of @TotalPages
                            </span>
                            <button @onclick="NextPage" disabled="@(CurrentPage >= TotalPages)" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-slate-400 ring-1 ring-inset ring-slate-300 hover:bg-slate-50 focus:z-20 focus:outline-offset-0 disabled:opacity-50">
                                <span class="sr-only">Next</span>
                                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        </nav>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<ConfirmationModal IsVisible="@IsConfirmVisible" Title="@ConfirmTitle" Message="@ConfirmMessage" ConfirmText="@ConfirmText" IsDestructive="@(!ConfirmRestore)" OnConfirm="ConfirmStatusChange" OnCancel="CloseConfirmation" />

@code {
    [Parameter]
    public int CourseId { get; set; }

    private string CourseTitle = "Loading...";
    private List<LessonSummaryResponse> Lessons = new();
    
    private bool IsLoading = true;
    private string? ErrorMessage;
    
    private bool IsFormVisible = false;
    private bool IsSaving = false;
    private bool IsDeleting = false;
    
    private int? EditingLessonId;
    private CreateLessonRequest CurrentLesson = new();
    private bool IsConfirmVisible, ConfirmRestore;
    private LessonSummaryResponse? PendingLesson;
    private string ConfirmTitle => ConfirmRestore ? "Restore Lesson?" : "Archive Lesson?";
    private string ConfirmText => ConfirmRestore ? "Restore" : "Archive";
    private string ConfirmMessage => ConfirmRestore ? $"Are you sure you want to restore \"{PendingLesson?.Title}\"?" : $"Are you sure you want to archive \"{PendingLesson?.Title}\"? This lesson will no longer be available to students. You can restore it later.";

    private bool? StatusFilter = false;
    private string StatusFilterString
    {
        get => StatusFilter switch { false => "false", true => "true", _ => "null" };
        set
        {
            bool? newValue = value switch { "false" => false, "true" => true, _ => null };
            if (StatusFilter != newValue)
            {
                StatusFilter = newValue;
                CurrentPage = 1;
                _ = LoadLessons();
            }
        }
    }

    private string? _searchTerm;
    private string? SearchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                CurrentPage = 1;
                DebounceSearch();
            }
        }
    }

    private System.Timers.Timer? _debounceTimer;

    private void DebounceSearch()
    {
        _debounceTimer?.Stop();
        if (_debounceTimer == null)
        {
            _debounceTimer = new System.Timers.Timer(400);
            _debounceTimer.Elapsed += async (s, e) =>
            {
                _debounceTimer.Stop();
                await InvokeAsync(async () =>
                {
                    await LoadLessons();
                });
            };
            _debounceTimer.AutoReset = false;
        }
        _debounceTimer.Start();
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }

    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalPages = 1;
    private int TotalCount = 0;

    private string PageSizeStr
    {
        get => PageSize.ToString();
        set
        {
            if (int.TryParse(value, out int size) && size != PageSize)
            {
                PageSize = size;
                CurrentPage = 1;
                _ = LoadLessons();
            }
        }
    }

    private Task PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            return LoadLessons();
        }
        return Task.CompletedTask;
    }

    private Task NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
            return LoadLessons();
        }
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCourseName();
        await LoadLessons();
    }

    private async Task LoadCourseName()
    {
        try
        {
            var course = await CourseClient.GetCourseAsync(CourseId);
            if (course != null)
            {
                CourseTitle = course.Title;
            }
        }
        catch
        {
            CourseTitle = $"Course ID {CourseId}";
        }
    }

    private async Task LoadLessons()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var result = await LessonClient.GetLessonsAsync(CourseId, page: CurrentPage, pageSize: PageSize, searchTerm: _searchTerm, isArchived: StatusFilter);
            if (result != null)
            {
                Lessons = result.Items.ToList();
                CurrentPage = result.Page;
                PageSize = result.PageSize;
                TotalPages = result.TotalPages;
                TotalCount = result.TotalCount;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to load lessons. " + ex.Message;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void ShowCreateForm()
    {
        EditingLessonId = null;
        CurrentLesson = new CreateLessonRequest 
        { 
            CourseId = CourseId,
            DisplayOrder = Lessons.Any() ? Lessons.Max(l => l.DisplayOrder) + 1 : 1
        };
        IsFormVisible = true;
        ErrorMessage = null;
    }

    private async void ShowEditForm(LessonSummaryResponse lesson)
    {
        EditingLessonId = lesson.LessonId;
        IsFormVisible = true;
        IsSaving = true;
        ErrorMessage = null;
        StateHasChanged();

        try
        {
            var detail = await LessonClient.GetLessonAsync(CourseId, lesson.LessonId);
            if (detail != null)
            {
                CurrentLesson = new CreateLessonRequest
                {
                    CourseId = CourseId,
                    Title = detail.Title,
                    Content = detail.Content,
                    DisplayOrder = detail.DisplayOrder
                };
            }
            else
            {
                ErrorMessage = "Could not load lesson details.";
                IsFormVisible = false;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error loading details: " + ex.Message;
            IsFormVisible = false;
        }
        finally
        {
            IsSaving = false;
            StateHasChanged();
        }
    }

    private void HideForm()
    {
        IsFormVisible = false;
    }

    private async Task SaveLesson()
    {
        if (string.IsNullOrWhiteSpace(CurrentLesson.Title))
        {
            ErrorMessage = "Title is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(CurrentLesson.Content))
        {
            ErrorMessage = "Content is required.";
            return;
        }

        if (CurrentLesson.DisplayOrder < 1)
        {
            ErrorMessage = "Display Order must be a positive integer.";
            return;
        }

        IsSaving = true;
        ErrorMessage = null;
        try
        {
            HttpResponseMessage response;
            if (EditingLessonId.HasValue)
            {
                var updateRequest = new UpdateLessonRequest
                {
                    Title = CurrentLesson.Title,
                    Content = CurrentLesson.Content,
                    DisplayOrder = CurrentLesson.DisplayOrder
                };
                response = await LessonClient.UpdateLessonAsync(CourseId, EditingLessonId.Value, updateRequest);
            }
            else
            {
                response = await LessonClient.CreateLessonAsync(CourseId, CurrentLesson);
            }

            if (response.IsSuccessStatusCode)
            {
                IsFormVisible = false;
                await LoadLessons();
            }
            else
            {
                ErrorMessage = await ApiResponseHelper.GetErrorMessageAsync(response);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error saving lesson: " + ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void OpenArchive(LessonSummaryResponse lesson) { PendingLesson = lesson; ConfirmRestore = lesson.DeleteFlag; IsConfirmVisible = true; }
    private void CloseConfirmation() => IsConfirmVisible = false;
    private async Task ConfirmStatusChange()
    {
        if (PendingLesson is null || IsDeleting) return;
        
        IsDeleting = true;
        ErrorMessage = null;
        try
        {
            var response = ConfirmRestore ? await LessonClient.RestoreLessonAsync(CourseId, PendingLesson.LessonId) : await LessonClient.ArchiveLessonAsync(CourseId, PendingLesson.LessonId);
            if (response.IsSuccessStatusCode)
            {
                IsConfirmVisible = false;
                if (Lessons.Count == 1 && CurrentPage > 1) CurrentPage--;
                await LoadLessons();
            }
            else
            {
                ErrorMessage = await ApiResponseHelper.GetErrorMessageAsync(response);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error updating lesson status: " + ex.Message;
        }
        finally
        {
            IsDeleting = false;
        }
    }

    private void GoBackToCourses()
    {
        NavManager.NavigateTo("/admin/courses");
    }

}
