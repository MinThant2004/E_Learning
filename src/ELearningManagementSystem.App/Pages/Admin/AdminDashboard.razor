@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject AdminDashboardApiClient DashboardClient
@inject NavigationManager NavManager

<PageTitle>Admin Dashboard</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-900">Admin Dashboard</h1>
        <p class="mt-2 text-sm text-slate-600">Overview of system content and activity.</p>
    </div>

    @if (IsLoading)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <SkeletonCard />
            <SkeletonCard />
            <SkeletonCard />
            <SkeletonCard />
        </div>
    }
    else if (HasError)
    {
        <EmptyState Title="Dashboard Unavailable" Description="@ErrorMessage">
            <Icon>
                <svg class="mx-auto h-12 w-12 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </Icon>
        </EmptyState>
    }
    else if (Dashboard != null)
    {
        @if (Dashboard.Metrics.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
                @foreach (var metric in Dashboard.Metrics.Values)
                {
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex flex-col hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-bold text-slate-900">@metric.Title</h3>
                            <div class="p-2 bg-indigo-50 text-indigo-600 rounded-lg">
                                @if (metric.Icon == "folder")
                                {
                                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                                    </svg>
                                }
                                else if (metric.Icon == "book")
                                {
                                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                    </svg>
                                }
                                else if (metric.Icon == "document-text")
                                {
                                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                }
                                else if (metric.Icon == "check-circle")
                                {
                                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                }
                                else if (metric.Icon == "users")
                                {
                                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                    </svg>
                                }
                            </div>
                        </div>
                        <div class="mt-2">
                            <span class="text-3xl font-extrabold text-slate-900">@metric.TotalCount</span>
                            <span class="text-sm font-medium text-slate-500 ml-2">Total</span>
                        </div>
                        <div class="mt-4 flex items-center justify-between text-sm">
                            <div class="flex items-center text-green-700">
                                <span class="w-2 h-2 bg-green-500 rounded-full mr-2"></span>
                                @metric.ActiveCount Active
                            </div>
                            <div class="flex items-center text-slate-500">
                                <span class="w-2 h-2 bg-slate-300 rounded-full mr-2"></span>
                                @metric.ArchivedCount Archived
                            </div>
                        </div>
                        <div class="mt-6 pt-4 border-t border-slate-100">
                            <a href="@metric.Route" class="text-sm font-medium text-indigo-600 hover:text-indigo-800 transition-colors flex items-center">
                                Manage @metric.Title
                                <svg class="ml-1 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                    </div>
                }
            </div>
            
            @if (Dashboard.QuickActions.Any())
            {
                <h2 class="text-xl font-bold text-slate-900 mb-6">Quick Actions</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var action in Dashboard.QuickActions)
                    {
                        <a href="@action.Route" class="group bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex items-start hover:border-indigo-300 hover:shadow-md transition-all">
                            <div class="p-3 bg-indigo-50 text-indigo-600 rounded-xl group-hover:bg-indigo-600 group-hover:text-white transition-colors mr-4">
                                @if (action.Icon == "plus")
                                {
                                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                    </svg>
                                }
                            </div>
                            <div>
                                <h4 class="text-base font-bold text-slate-900 group-hover:text-indigo-700 transition-colors">@action.Title</h4>
                                <p class="text-sm text-slate-500 mt-1">@action.Description</p>
                            </div>
                        </a>
                    }
                </div>
            }
        }
        else
        {
            <EmptyState Title="No data available" Description="You do not have access to any administrative metrics.">
                <Icon>
                    <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </Icon>
                <ActionTemplate>
                    <a href="/" class="inline-flex items-center px-6 py-3 border border-transparent shadow-sm text-base font-medium rounded-full text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">
                        Return Home
                    </a>
                </ActionTemplate>
            </EmptyState>
        }
    }
</div>

@code {
    private AdminDashboardResponse? Dashboard;
    private bool IsLoading = true;
    private bool HasError = false;
    private string ErrorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        HasError = false;

        var result = await DashboardClient.GetDashboardAsync();
        
        if (result.Success)
        {
            Dashboard = result.Data;
        }
        else
        {
            HasError = true;
            ErrorMessage = result.Error ?? "Unable to load admin dashboard or access denied.";
        }

        IsLoading = false;
    }
}
