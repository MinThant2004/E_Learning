@page "/courses/{CourseId:int}/lessons/{LessonId:int}"

@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@inject LessonApiClient LessonClient
@inject CourseApiClient CourseClient
@inject NavigationManager NavManager

<PageTitle>@ActiveLesson?.Title - @CourseTitle</PageTitle>

<div class="min-h-screen bg-slate-50 flex flex-col">
    <!-- Learning Header Bar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 px-4 py-4 sm:px-6 shadow-sm">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <button @onclick="GoToCourseDetail" class="inline-flex items-center text-slate-500 hover:text-indigo-600 font-medium text-sm transition-colors group">
                    <svg class="h-5 w-5 mr-1 text-slate-400 group-hover:text-indigo-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Back to Course Info
                </button>
                <span class="text-slate-300">|</span>
                <span class="text-sm font-semibold text-slate-700 truncate max-w-xs sm:max-w-md">@CourseTitle</span>
            </div>
        </div>
    </header>

    <div class="flex-grow flex flex-col md:flex-row max-w-7xl w-full mx-auto px-0 sm:px-6 lg:px-8 py-6 md:space-x-6">
        
        <!-- Sidebar Navigation (Desktop) -->
        <aside class="w-full md:w-80 flex-shrink-0 bg-white rounded-2xl border border-slate-200 p-4 mb-6 md:mb-0 max-h-[calc(100vh-140px)] overflow-y-auto">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4 px-2">Course Outline</h3>
            <div class="space-y-1">
                @if (Lessons == null || !Lessons.Any())
                {
                    <p class="text-slate-500 text-xs italic px-2">No lessons available.</p>
                }
                else
                {
                    @foreach (var lesson in Lessons)
                    {
                        var isCurrent = lesson.LessonId == LessonId;
                        <button @onclick="() => NavigateToLesson(lesson.LessonId)" 
                                class="@($"w-full text-left flex items-start space-x-3 px-3 py-3 rounded-xl transition-all border { (isCurrent ? "bg-indigo-600 border-indigo-600 text-white shadow-md shadow-indigo-100" : "bg-white border-transparent text-slate-700 hover:bg-slate-50 hover:text-slate-900") }")">
                            <span class="@($"flex-shrink-0 flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold { (isCurrent ? "bg-white/20 text-white" : "bg-indigo-50 text-indigo-700") }")">
                                @lesson.DisplayOrder
                            </span>
                            <span class="text-xs font-semibold leading-5">@lesson.Title</span>
                        </button>
                    }
                }
            </div>
        </aside>

        <!-- Main Lesson Content Area -->
        <main class="flex-grow bg-white border border-slate-200 sm:rounded-2xl p-6 sm:p-10 flex flex-col justify-between shadow-sm min-h-[500px]">
            
            @if (IsLoading)
            {
                <div class="flex-grow flex flex-col items-center justify-center py-20">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600 mb-4"></div>
                    <p class="text-slate-500 text-sm font-medium">Loading lesson content...</p>
                </div>
            }
            else if (ErrorMessage != null)
            {
                <div class="flex-grow flex flex-col items-center justify-center py-20 px-4 text-center">
                    <div class="h-16 w-16 bg-red-50 text-red-600 rounded-full flex items-center justify-center mb-4">
                        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Could Not Load Lesson</h3>
                    <p class="text-slate-500 text-sm max-w-md">@ErrorMessage</p>
                    <button @onclick="GoToCourseDetail" class="mt-6 inline-flex items-center px-4 py-2 border border-slate-300 rounded-full text-sm font-semibold text-slate-700 bg-white hover:bg-slate-50 transition-colors">
                        Return to Course Info
                    </button>
                </div>
            }
            else if (ActiveLesson == null)
            {
                <div class="flex-grow flex flex-col items-center justify-center py-20 text-center">
                    <svg class="mx-auto h-12 w-12 text-slate-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Lesson Not Found</h3>
                    <p class="text-slate-500 text-sm">The requested lesson does not exist or has been removed.</p>
                </div>
            }
            else
            {
                <!-- Lesson Reading Content -->
                <div class="flex-grow">
                    <div class="flex items-center space-x-2 text-slate-400 text-xs font-bold uppercase tracking-wider mb-2">
                        <span>Lesson @ActiveLesson?.DisplayOrder of @(Lessons?.Count ?? 0)</span>
                    </div>
                    <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mb-6 border-b border-slate-100 pb-4">@ActiveLesson?.Title</h1>
                    
                    <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed whitespace-pre-wrap font-sans text-base mb-12">
                        @ActiveLesson?.Content
                    </div>
                </div>

                <!-- Footer Navigation -->
                <div class="border-t border-slate-150 pt-6 mt-8 flex flex-col sm:flex-row items-center justify-between space-y-3 sm:space-y-0">
                    <div>
                        @if (PrevLessonId.HasValue)
                        {
                            <button @onclick="() => NavigateToLesson(PrevLessonId.Value)" 
                                    class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 border border-slate-200 rounded-full text-sm font-semibold text-slate-700 bg-white hover:bg-slate-50 hover:border-slate-300 transition-all">
                                <svg class="mr-2 h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                                </svg>
                                Previous Lesson
                            </button>
                        }
                    </div>
                    <div>
                        @if (NextLessonId.HasValue)
                        {
                            <button @onclick="() => NavigateToLesson(NextLessonId.Value)" 
                                    class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 border border-transparent rounded-full shadow-sm text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 transition-all">
                                Next Lesson
                                <svg class="ml-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </button>
                        }
                        else
                        {
                            <button @onclick="GoToCourseDetail" 
                                    class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 border border-transparent rounded-full shadow-sm text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 transition-all">
                                Finish Course View
                                <svg class="ml-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                            </button>
                        }
                    </div>
                </div>
            }
        </main>
    </div>
</div>

@code {
    [Parameter]
    public int CourseId { get; set; }

    [Parameter]
    public int LessonId { get; set; }

    private string CourseTitle = "Loading course...";
    private List<LessonSummaryResponse> Lessons = new();
    private LessonDetailResponse? ActiveLesson;

    private bool IsLoading = true;
    private string? ErrorMessage;

    private int? PrevLessonId;
    private int? NextLessonId;

    protected override async Task OnParametersSetAsync()
    {
        await LoadCourseName();
        await LoadLessonsAndActive();
    }

    private async Task LoadCourseName()
    {
        try
        {
            var course = await CourseClient.GetCourseAsync(CourseId);
            if (course != null)
            {
                CourseTitle = course.Title;
            }
        }
        catch
        {
            CourseTitle = "Learning Course";
        }
    }

    private async Task LoadLessonsAndActive()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            // Load list of lessons
            var listResult = await LessonClient.GetLessonsAsync(CourseId);
            if (listResult != null)
            {
                Lessons = listResult.OrderBy(l => l.DisplayOrder).ToList();
            }

            // Load active lesson details
            ActiveLesson = await LessonClient.GetLessonAsync(CourseId, LessonId);
            
            CalculateNavIds();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error loading lesson. Please ensure you are authorized or try again. Details: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void CalculateNavIds()
    {
        PrevLessonId = null;
        NextLessonId = null;

        if (Lessons == null || ActiveLesson == null) return;

        var currentIndex = Lessons.FindIndex(l => l.LessonId == LessonId);
        if (currentIndex > 0)
        {
            PrevLessonId = Lessons[currentIndex - 1].LessonId;
        }
        if (currentIndex >= 0 && currentIndex < Lessons.Count - 1)
        {
            NextLessonId = Lessons[currentIndex + 1].LessonId;
        }
    }

    private void NavigateToLesson(int id)
    {
        NavManager.NavigateTo($"/courses/{CourseId}/lessons/{id}");
    }

    private void GoToCourseDetail()
    {
        NavManager.NavigateTo($"/courses/{CourseId}");
    }
}
