@page "/my-courses"

@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject EnrollmentApiClient EnrollmentClient
@inject NavigationManager NavManager
@inject HttpClient Http
@attribute [Authorize(Policy = "Permission:Course.Read")]

<PageTitle>My Courses</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <PageHeader Title="My Courses" Description="Resume your learning journey and access your enrolled courses.">
        <ActionTemplate>
            <a href="/courses" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-semibold rounded-full shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">
                Browse Catalog
                <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </a>
        </ActionTemplate>
    </PageHeader>

    @if (IsLoading)
    {
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            @for (int i = 0; i < 4; i++)
            {
                <SkeletonCard />
            }
        </div>
    }
    else if (LoadError)
    {
        <EmptyState Title="Unable to load enrollments" Description="There was a problem communicating with the server. Please try again later.">
            <Icon>
                <svg class="mx-auto h-12 w-12 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </Icon>
            <ActionTemplate>
                <button @onclick="LoadMyCourses" class="inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-full text-slate-700 bg-white hover:bg-slate-50 transition-colors">
                    Try Again
                </button>
            </ActionTemplate>
        </EmptyState>
    }
    else if (!MyCoursesList.Any())
    {
        <EmptyState Title="No enrolled courses yet" Description="Discover new topics and start learning today by exploring our course catalog.">
            <Icon>
                <svg class="mx-auto h-12 w-12 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
            </Icon>
            <ActionTemplate>
                <a href="/courses" class="inline-flex items-center px-6 py-2.5 border border-transparent text-sm font-semibold rounded-full shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">
                    Explore Courses
                </a>
            </ActionTemplate>
        </EmptyState>
    }
    else
    {
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            @foreach (var course in MyCoursesList)
            {
                <div class="bg-white overflow-hidden shadow-sm hover:shadow-xl rounded-2xl flex flex-col cursor-pointer transition-all duration-300 transform hover:-translate-y-2 border border-slate-100 group" @onclick="() => NavigateToCourse(course.CourseId)">
                    
                    <!-- Decorative Header Image or Course Thumbnail -->
                    <div class="h-40 bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 relative overflow-hidden">
                        @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                        {
                            <img src="@GetImageUrl(course.ThumbnailUrl)" alt="@course.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                        }
                        <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors duration-300"></div>
                        
                        <!-- Status Badge -->
                        <div class="absolute bottom-3 left-3 bg-white/20 backdrop-blur-md px-3 py-1 rounded-full border border-white/30 text-xs font-semibold text-white tracking-wide uppercase shadow-sm">
                            @(course.IsComplete ? "Completed" : "In Progress")
                        </div>
                    </div>
                    
                    <!-- Content Body -->
                    <div class="px-6 py-5 flex-grow flex flex-col">
                        <h3 class="text-lg leading-6 font-bold text-slate-900 group-hover:text-indigo-600 transition-colors line-clamp-2 mb-2">@course.Title</h3>
                        <p class="text-sm text-slate-500 line-clamp-2 leading-relaxed mb-4 flex-grow">
                            @(string.IsNullOrWhiteSpace(course.Description) ? "No description available." : course.Description)
                        </p>

                        <!-- Progress Bar -->
                        <div class="mt-auto pt-2">
                            <div class="flex justify-between text-xs mb-1.5 font-medium">
                                <span class="text-slate-700">Progress</span>
                                <span class="text-slate-500">@course.CompletedCount / @course.TotalActiveLessons (@course.ProgressPercentage%)</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                                <div class="bg-indigo-600 h-full rounded-full transition-all duration-500" style="width: @(Math.Min(100, Math.Max(0, course.ProgressPercentage)))%"></div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Footer Action Bar -->
                    <div class="bg-slate-50/50 px-6 py-4 border-t border-slate-100 flex items-center justify-between">
                        <span class="text-xs font-medium text-slate-400">Enrolled @course.EnrollDate.ToString("dd-MM-yyyy")</span>
                        <div class="h-8 w-8 rounded-full bg-indigo-50 flex items-center justify-center group-hover:bg-indigo-600 group-hover:text-white text-indigo-600 transition-colors">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<MyCourseResponse> MyCoursesList = Array.Empty<MyCourseResponse>();
    private bool IsLoading = true;
    private bool LoadError = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadMyCourses();
    }

    private async Task LoadMyCourses()
    {
        IsLoading = true;
        LoadError = false;
        
        try
        {
            MyCoursesList = await EnrollmentClient.GetMyEnrollmentsAsync();
        }
        catch
        {
            LoadError = true;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void NavigateToCourse(int courseId)
    {
        NavManager.NavigateTo($"/courses/{courseId}");
    }

    private string GetImageUrl(string? relativePath)
    {
        if (string.IsNullOrWhiteSpace(relativePath))
            return string.Empty;

        if (relativePath.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            relativePath.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return relativePath;
        }

        var baseUri = Http.BaseAddress?.ToString().TrimEnd('/') ?? string.Empty;
        var cleanPath = relativePath.StartsWith("/") ? relativePath : "/" + relativePath;
        return baseUri + cleanPath;
    }
}
