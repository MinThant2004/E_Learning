@page "/courses"
@implements IDisposable

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Permission:Course.Read")]
@using ELearningManagementSystem.App.Components.UI
@using ELearningManagementSystem.App.Services
@inject CourseApiClient CourseClient
@inject NavigationManager NavManager
@inject HttpClient Http

<PageTitle>Course Catalog</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <PageHeader Title="Course Catalog" Description="Discover and enroll in our available courses to advance your learning journey.">
        <ActionTemplate>
            <div class="relative w-full sm:w-80">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <input type="text" @bind="SearchTerm" @bind:event="oninput" @onkeyup="HandleSearch" placeholder="Search courses..." class="block w-full pl-10 pr-3 py-2.5 border border-slate-700/50 rounded-xl leading-5 bg-slate-800/50 text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors duration-200" />
            </div>
        </ActionTemplate>
    </PageHeader>

    @if (IsLoading)
    {
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            @for (int i = 0; i < PageSize; i++)
            {
                <SkeletonCard />
            }
        </div>
    }
    else if (Courses == null || !Courses.Any())
    {
        <EmptyState Title="No courses found" Description="Check back later for new content, or try adjusting your search filters.">
            <Icon>
                <svg class="mx-auto h-12 w-12 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
            </Icon>
            <ActionTemplate>
                @if (!string.IsNullOrEmpty(SearchTerm))
                {
                    <button @onclick="ClearSearch" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-full shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                        Clear Search
                    </button>
                }
            </ActionTemplate>
        </EmptyState>
    }
    else
    {
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            @foreach (var course in Courses)
            {
                <div class="bg-white overflow-hidden shadow-sm hover:shadow-xl rounded-2xl flex flex-col cursor-pointer transition-all duration-300 transform hover:-translate-y-2 border border-slate-100 group" @onclick="() => NavigateToCourse(course.CourseId)">
                    
                    <!-- Decorative Header Image or Course Thumbnail -->
                    <div class="h-40 bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 relative overflow-hidden">
                        @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                        {
                            <img src="@($"{Http.BaseAddress?.ToString().TrimEnd('/')}{course.ThumbnailUrl}")" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                        }
                        <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors duration-300"></div>
                        <div class="absolute bottom-4 left-4 bg-white/20 backdrop-blur-md px-3 py-1 rounded-full border border-white/30 text-xs font-semibold text-white tracking-wide uppercase">
                            Course
                        </div>
                    </div>
                    
                    <div class="px-6 py-6 sm:p-8 flex-grow">
                        <h3 class="text-xl leading-7 font-bold text-slate-900 group-hover:text-indigo-600 transition-colors line-clamp-2">@course.Title</h3>
                        <p class="mt-3 text-sm text-slate-500 line-clamp-3 leading-relaxed">@(string.IsNullOrEmpty(course.Description) ? "No description available." : course.Description)</p>
                    </div>
                    
                    <div class="bg-slate-50/50 px-6 py-4 mt-auto border-t border-slate-100 flex items-center justify-between">
                        <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">Learn More</span>
                        <div class="h-8 w-8 rounded-full bg-indigo-50 flex items-center justify-center group-hover:bg-indigo-600 group-hover:text-white text-indigo-600 transition-colors">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <Pagination CurrentPage="Page" TotalPages="TotalPages" TotalCount="TotalCount" PageSize="PageSize"
                    ShowPageSize="false" ItemLabel="courses" PageChanged="GoToPageAsync" />
    }
</div>

@code {
    private List<CourseSummaryResponse> Courses = new();
    private bool IsLoading = true;
    private string? SearchTerm;
    private int Page = 1;
    private int PageSize = 8;
    private int TotalPages = 0;
    private int TotalCount = 0;
    private System.Timers.Timer? _debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        _debounceTimer = new System.Timers.Timer(500);
        _debounceTimer.AutoReset = false;
        _debounceTimer.Elapsed += async (s, e) =>
        {
            Page = 1;
            await InvokeAsync(LoadCourses);
            await InvokeAsync(StateHasChanged);
        };

        await LoadCourses();
    }

    private async Task LoadCourses()
    {
        IsLoading = true;
        try
        {
            var result = await CourseClient.GetCoursesAsync(Page, PageSize, SearchTerm);
            if (result != null)
            {
                Courses = result.Items.ToList();
                TotalPages = result.TotalPages;
                TotalCount = result.TotalCount;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading courses: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void HandleSearch(KeyboardEventArgs e)
    {
        _debounceTimer?.Stop();
        _debounceTimer?.Start();
    }

    private async Task ClearSearch()
    {
        SearchTerm = null;
        Page = 1;
        await LoadCourses();
    }

    private Task GoToPageAsync(int page)
    {
        if (page < 1 || page > TotalPages || page == Page) return Task.CompletedTask;
        Page = page;
        return LoadCourses();
    }

    private void NavigateToCourse(int id)
    {
        NavManager.NavigateTo($"/courses/{id}");
    }
    
    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}
