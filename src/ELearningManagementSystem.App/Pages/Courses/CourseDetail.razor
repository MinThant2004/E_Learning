@page "/courses/{Id:int}"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Permission:Course.Read")]
@using ELearningManagementSystem.App.Services
@using ELearningManagementSystem.App.Components.UI
@inject CourseApiClient CourseClient
@inject LessonApiClient LessonClient
@inject EnrollmentApiClient EnrollmentClient
@inject NavigationManager NavManager
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Course Details - @(Course?.Title ?? "Loading...")</PageTitle>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <button @onclick="GoBack" class="mb-6 inline-flex items-center text-sm font-medium text-slate-500 hover:text-indigo-600 transition-colors group">
        <svg class="mr-2 h-5 w-5 text-slate-400 group-hover:text-indigo-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
        </svg>
        Back to Catalog
    </button>

    @if (ShowEnrollRequiredAlert)
    {
        <div class="mb-6 flex items-start gap-3 p-4 bg-amber-50 border border-amber-200 rounded-2xl text-amber-800 text-sm">
            <svg class="h-5 w-5 text-amber-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div class="flex-1">
                <p class="font-semibold">Enrollment required</p>
                <p class="mt-0.5 text-amber-700">You must enroll in this course before accessing its lessons.</p>
            </div>
            <button @onclick="() => ShowEnrollRequiredAlert = false" class="text-amber-500 hover:text-amber-700 flex-shrink-0" aria-label="Dismiss">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
    }

    @if (IsLoading)
    {
        <SkeletonCard />
        <div class="mt-8 space-y-4 animate-pulse">
            <div class="h-4 bg-slate-200 rounded w-full"></div>
            <div class="h-4 bg-slate-200 rounded w-5/6"></div>
            <div class="h-4 bg-slate-200 rounded w-4/6"></div>
        </div>
    }
    else if (HasError || Course == null)
    {
        <EmptyState Title="Course Not Found" Description="The requested course is unavailable or has been deleted.">
            <Icon>
                <svg class="mx-auto h-12 w-12 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </Icon>
            <ActionTemplate>
                <button @onclick="GoBack" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-full shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                    Return to Catalog
                </button>
            </ActionTemplate>
        </EmptyState>
    }
    else
    {
        <div class="bg-white shadow-xl shadow-slate-200/50 overflow-hidden sm:rounded-3xl border border-slate-100">
            <!-- Hero Image Header -->
            <div class="h-64 sm:h-80 bg-gradient-to-br from-indigo-900 via-purple-900 to-slate-900 relative overflow-hidden">
                @if (!string.IsNullOrEmpty(Course.ThumbnailUrl))
                {
                    <img src="@($"{Http.BaseAddress?.ToString().TrimEnd('/')}{Course.ThumbnailUrl}")" class="absolute inset-0 w-full h-full object-cover" />
                }
                <div class="absolute inset-0 bg-black/40"></div>
                <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-10 bg-gradient-to-t from-black/80 to-transparent text-white">
                    <div class="flex items-center space-x-3 mb-3">
                        <span class="px-3 py-1 text-xs font-semibold bg-indigo-500/80 backdrop-blur-md text-white rounded-full uppercase tracking-wider">
                            Course
                        </span>
                        <span class="text-indigo-200 text-sm flex items-center">
                            <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            @Course.CreatedAt.ToString("dd-MM-yyyy")
                        </span>
                    </div>
                    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-2">@Course.Title</h1>
                </div>
            </div>

            <div class="p-6 sm:p-10">
                <div class="prose prose-slate max-w-none mb-10">
                    <h3 class="text-xl font-bold text-slate-900 mb-4 flex items-center">
                        <svg class="w-6 h-6 mr-2 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        About this course
                    </h3>
                    <p class="text-slate-600 leading-relaxed whitespace-pre-wrap">@(string.IsNullOrEmpty(Course.Description) ? "No description available." : Course.Description)</p>
                </div>

                <!-- Lessons List -->
                <div class="mb-10">
                    <h3 class="text-xl font-bold text-slate-900 mb-4 flex items-center">
                        <svg class="w-6 h-6 mr-2 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                        Course Lessons
                    </h3>
                    <div class="space-y-3">
                        @if (Lessons == null || !Lessons.Any())
                        {
                            <p class="text-slate-500 text-sm italic">No lessons are available for this course yet.</p>
                        }
                        else
                        {
                            @for (int i = 0; i < Lessons.Count; i++)
                            {
                                var lesson = Lessons[i];
                                @if (IsEnrolled)
                                {
                                    <a href="@($"/courses/{Id}/lessons/{lesson.LessonId}")" class="flex items-center justify-between p-4 bg-slate-50 hover:bg-indigo-50/50 rounded-2xl border border-slate-100 hover:border-indigo-100 transition-all group">
                                        <div class="flex items-center space-x-4">
                                            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-bold text-sm">
                                                @(i + 1)
                                            </div>
                                            <span class="text-sm font-semibold text-slate-800 group-hover:text-indigo-900 transition-colors">@lesson.Title</span>
                                        </div>
                                        <svg class="w-5 h-5 text-slate-400 group-hover:text-indigo-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                        </svg>
                                    </a>
                                }
                                else
                                {
                                    <div class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl border border-slate-100 opacity-60 cursor-not-allowed select-none">
                                        <div class="flex items-center space-x-4">
                                            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-slate-200 text-slate-500 font-bold text-sm">
                                                @(i + 1)
                                            </div>
                                            <span class="text-sm font-semibold text-slate-500">@lesson.Title</span>
                                        </div>
                                        <span class="text-base" aria-label="Enroll to unlock">&#x1F512;</span>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>

                <div class="bg-slate-50 rounded-2xl p-6 sm:flex sm:items-center sm:justify-between border border-slate-100">
                    <div class="mb-4 sm:mb-0">
                        @if (IsEnrolled)
                        {
                            <h4 class="text-lg font-semibold text-slate-900">Ready to continue learning?</h4>
                            <p class="text-slate-500 text-sm mt-1">Access all course materials and pick up where you left off.</p>
                        }
                        else
                        {
                            <h4 class="text-lg font-semibold text-slate-900">Ready to start learning?</h4>
                            <p class="text-slate-500 text-sm mt-1">Enroll now to access all course materials.</p>
                        }
                    </div>
                    
                    <AuthorizeView>
                        <Authorized>
                            @if (IsEnrolled)
                            {
                                <div class="flex flex-col sm:flex-row gap-4">
                                    <AuthorizeView Policy="Permission:Lesson.Read" Context="lessonContext">
                                        <Authorized>
                                            @if (Lessons != null && Lessons.Any())
                                            {
                                                <a href="@($"/courses/{Id}/lessons/{Lessons.First().LessonId}")" class="w-full sm:w-auto inline-flex justify-center items-center px-5 py-2 border border-transparent rounded-full shadow-sm text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 transition-all">
                                                    Continue Learning
                                                </a>
                                            }
                                            else
                                            {
                                                <button disabled class="w-full sm:w-auto inline-flex justify-center items-center px-5 py-2 border border-transparent rounded-full shadow-sm text-sm font-semibold text-white bg-indigo-600 opacity-75 cursor-not-allowed transition-all">
                                                    No Lessons Available
                                                </button>
                                            }
                                        </Authorized>
                                    </AuthorizeView>
                                    
                                    <AuthorizeView Policy="Permission:Quiz.Read" Context="quizContext">
                                        <Authorized>
                                            <a href="@($"/courses/{Id}/quiz")" class="w-full sm:w-auto inline-flex justify-center items-center px-5 py-2 border border-indigo-600 rounded-full shadow-sm text-sm font-semibold text-indigo-600 bg-white hover:bg-indigo-50 transition-all">
                                                Take Final Quiz
                                            </a>
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            }
                            else
                            {
                                <button @onclick="EnrollAsync" disabled="@IsEnrolling" class="w-full sm:w-auto inline-flex justify-center items-center px-6 py-3 border border-transparent rounded-full shadow-sm text-base font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition-all">
                                    @if (IsEnrolling)
                                    {
                                        <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                        </svg>
                                        <span>Enrolling...</span>
                                    }
                                    else
                                    {
                                        <span>Enroll Now</span>
                                    }
                                </button>
                                @if (!string.IsNullOrEmpty(EnrollError))
                                {
                                    <p class="text-sm text-red-500 mt-2">@EnrollError</p>
                                }
                            }
                        </Authorized>
                        <NotAuthorized>
                            <a href="/login" class="w-full sm:w-auto inline-flex justify-center items-center px-6 py-3 border border-transparent rounded-full shadow-sm text-base font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition-all">
                                Login to Enroll
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private CourseDetailResponse? Course;
    private List<LessonSummaryResponse> Lessons = new();
    private bool IsLoading = true;
    private bool HasError = false;
    private bool IsEnrolled = false;
    private bool IsEnrolling = false;
    private string? EnrollError;
    private bool ShowEnrollRequiredAlert = false;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        HasError = false;
        try
        {
            Course = await CourseClient.GetCourseAsync(Id);
            var lessonList = await LessonClient.GetLessonsAsync(Id, pageSize: 1000, isArchived: false);
            if (lessonList != null)
            {
                Lessons = lessonList.Items.OrderBy(l => l.DisplayOrder).ToList();
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                IsEnrolled = await EnrollmentClient.CheckEnrollmentStatusAsync(Id);
            }

            var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            if (query["enrollRequired"] == "true")
            {
                ShowEnrollRequiredAlert = true;
            }
        }
        catch (Exception)
        {
            HasError = true;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task EnrollAsync()
    {
        IsEnrolling = true;
        EnrollError = null;
        try
        {
            var result = await EnrollmentClient.EnrollAsync(Id);
            if (result.Success)
            {
                IsEnrolled = true;
                ShowEnrollRequiredAlert = false;
            }
            else
            {
                EnrollError = result.Error;
            }
        }
        catch (Exception)
        {
            EnrollError = "An error occurred while enrolling.";
        }
        finally
        {
            IsEnrolling = false;
        }
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/courses");
    }
}
